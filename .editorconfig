# EditorConfig is awesome: https://EditorConfig.org
# A few options here differ from the defaults — they're matched to what
# Prettier does, so the two stay in sync.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces mean "hard line break" in Markdown, so don't trim them.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
