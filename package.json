{
  "name": "grove",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Grove monorepo — a file-first publishing system for structured knowledge. Sources in files, outputs to web, llms.txt, JSON-LD, OG images, JSON datasets.",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @grove-dev/core --filter @grove-dev/astro --filter @grove-dev/cli -r build && pnpm --dir apps/example build",
    "check": "pnpm --filter @grove-dev/core --filter @grove-dev/astro --filter @grove-dev/cli -r check && pnpm --dir apps/example check",
    "packaging:check": "node scripts/check-packaging.mjs",
    "docs:check": "node scripts/check-version-refs.mjs && node scripts/check-docs-contract.mjs && node scripts/check-starlight-sidebar.mjs --check-orphans && node scripts/check-starlight-internal-links.mjs",
    "icons:sync": "node scripts/sync-icons.mjs",
    "icons:check": "node scripts/sync-icons.mjs --check",
    "registry:build": "pnpm --filter @grove-dev/registry build",
    "registry:check": "node scripts/check-registry.mjs",
    "registry:install-check": "node scripts/check-registry-install.mjs",
    "example:check": "node scripts/check-example-mirrors-registry.mjs",
    "example:sync": "node scripts/check-example-mirrors-registry.mjs --write",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:scaffold": "node scripts/test-scaffold.mjs",
    "dev": "pnpm --dir apps/example dev",
    "dev:docs": "pnpm --filter @grove-dev/docs dev",
    "postinstall": "pnpm --filter @grove-dev/cli... build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.8",
    "@iconify-json/logos": "^1.2.13",
    "@iconify-json/simple-icons": "^1.2.93",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.9",
    "publint": "^0.3.24",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
