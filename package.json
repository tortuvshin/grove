{
  "name": "grove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Grove monorepo — an open-source framework for growing useful community knowledge.",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter './packages/**' --filter './docs' -r build",
    "check": "pnpm --filter './packages/**' --filter './docs' -r check",
    "docs:check": "node scripts/check-starlight-sidebar.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:scaffold": "node scripts/test-scaffold.mjs",
    "dev": "pnpm --filter @grove-dev/cli dev",
    "dev:docs": "pnpm --filter @grove-dev/docs dev",
    "grove:run": "pnpm --filter @grove-dev/cli exec node --import tsx src/index.ts run",
    "grove:dev": "pnpm grove:run dev",
    "grove:build": "pnpm grove:run build",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "postinstall": "pnpm --filter @grove-dev/cli... build"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
