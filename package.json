{
  "name": "grove",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Grove monorepo — an open-source framework for growing useful community knowledge.",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @grove-dev/core --filter @grove-dev/astro --filter @grove-dev/cli -r build && pnpm --dir apps/example build",
    "check": "pnpm --filter @grove-dev/core --filter @grove-dev/astro --filter @grove-dev/cli -r check && pnpm --dir apps/example check",
    "docs:check": "node scripts/check-starlight-sidebar.mjs && node scripts/check-starlight-internal-links.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:scaffold": "node scripts/test-scaffold.mjs",
    "dev": "pnpm --dir apps/example dev",
    "dev:docs": "pnpm --filter @grove-dev/docs dev",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "postinstall": "pnpm --filter @grove-dev/cli... build"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
