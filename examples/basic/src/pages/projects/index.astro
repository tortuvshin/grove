---
import BaseLayout from "@open-curated/astro/layouts/BaseLayout.astro";
import DirectoryFilters from "@open-curated/astro/components/DirectoryFilters.astro";
import LensTabs from "@open-curated/astro/components/LensTabs.astro";
import ActiveFilterChips from "@open-curated/astro/components/ActiveFilterChips.astro";
import Pagination from "@open-curated/astro/components/Pagination.astro";
import ItemCard from "@open-curated/astro/components/ItemCard.astro";
import { filteredRecords } from "../../lib/directory";
import { SORT_OPTIONS } from "@open-curated/astro";

const directory = filteredRecords(Astro.url);
const filterCategoryNames = directory.categories.map((entry) => entry.name);
const currentLens = directory.filters.lens ?? directory.filters.label ?? (directory.filters.health === "mature" ? "mature" : "all");
---

<BaseLayout title="Browse Projects">
  <section>
    <div class="oc-results-header">
      <div>
        <p class="oc-eyebrow">Directory</p>
        <h1>Browse projects</h1>
        <p class="oc-lede">Search, compare, and filter projects by health, category, language, license, and maintenance signals.</p>
      </div>
      <p id="result-count">{directory.results.length} of {directory.records.length} projects</p>
    </div>
    <LensTabs current={currentLens} />
    <DirectoryFilters
      q={directory.filters.q}
      category={directory.filters.category}
      tag={directory.filters.tag}
      language={directory.filters.language}
      license={directory.filters.license}
      health={directory.filters.health}
      maintained={directory.filters.maintained}
      hideArchived={directory.filters.hideArchived}
      hasRecentRelease={directory.filters.hasRecentRelease}
      categories={filterCategoryNames}
      tags={directory.tags}
      languages={directory.languages}
      licenses={directory.licenses}
    />
    <div class="oc-browse-toolbar">
      <label>
        <span>Sort</span>
        <select id="sort-select" name="sort">
          {SORT_OPTIONS.map((option) => <option value={option.value} selected={option.value === (directory.filters.sort ?? "recently-updated")}>{option.label}</option>)}
        </select>
      </label>
      <div class="oc-density" role="group" aria-label="Density">
        <a href="/projects" data-density="comfortable" aria-current={directory.filters.density !== "compact" ? "true" : undefined}>Comfortable</a>
        <a href="/projects?density=compact" data-density="compact" aria-current={directory.filters.density === "compact" ? "true" : undefined}>Compact</a>
      </div>
    </div>
    <ActiveFilterChips filters={directory.filters} />
  </section>
  <section class={`oc-grid ${directory.filters.density === "compact" ? "is-compact" : ""}`} id="project-results" data-page-size="12">
    {directory.results.map((record, index) => {
      const item = record.item;
      const status = record.health?.health.status ?? "unknown";
      const language = item.taxonomy.language ?? record.health?.github?.language ?? "";
      const license = record.health?.github?.license ?? "";
      const hasRecentRelease = record.health?.github?.latestReleaseAt ? "1" : "0";
      const search = [
        item.name,
        item.description,
        item.taxonomy.category,
        language,
        license,
        ...item.taxonomy.tags,
        ...(record.health?.github?.topics ?? []),
      ].join(" ").toLowerCase();
      return (
        <div
          class="oc-project-result"
          data-search={search}
          data-category={item.taxonomy.category}
          data-tags={item.taxonomy.tags.join(",")}
          data-language={language}
          data-license={license}
          data-health={status}
          data-release={hasRecentRelease}
          data-index={index}
        >
          <ItemCard item={item} health={record.health} />
        </div>
      );
    })}
  </section>
  <p id="empty-results" hidden>No projects match these filters.</p>
  <Pagination page={directory.filters.page ?? 1} pages={directory.pages} />
</BaseLayout>

<script>
  const form = document.querySelector(".oc-filters");
  const cards = Array.from(document.querySelectorAll(".oc-project-result"));
  const count = document.querySelector("#result-count");
  const empty = document.querySelector("#empty-results");

  function setFormFromUrl() {
    if (!(form instanceof HTMLFormElement)) return;
    const params = new URLSearchParams(window.location.search);
    for (const element of Array.from(form.elements)) {
      if (!(element instanceof HTMLInputElement || element instanceof HTMLSelectElement)) continue;
      if (!element.name) continue;
      if (element instanceof HTMLInputElement && element.type === "checkbox") {
        element.checked = params.get(element.name) === "1";
      } else {
        element.value = params.get(element.name) ?? (element.name === "health" ? "all" : "");
      }
    }
  }

  function readFilters() {
    if (!(form instanceof HTMLFormElement)) return {};
    const data = new FormData(form);
    return {
      q: String(data.get("q") ?? "").trim().toLowerCase(),
      category: String(data.get("category") ?? ""),
      tag: String(data.get("tag") ?? ""),
      language: String(data.get("language") ?? ""),
      license: String(data.get("license") ?? ""),
      health: String(data.get("health") ?? "all"),
      sort: document.querySelector("#sort-select")?.value ?? "recently-updated",
      density: document.querySelector(".oc-density a[aria-current=\"true\"]")?.dataset.density ?? "comfortable",
      maintained: data.get("maintained") === "1",
      hideArchived: data.get("hideArchived") === "1",
      hasRecentRelease: data.get("hasRecentRelease") === "1",
    };
  }

  function applyFilters(updateUrl = false) {
    const filters = readFilters();
    let visible = 0;
    const pageSize = Number(document.querySelector("#project-results")?.dataset.pageSize ?? 12);
    const params = new URLSearchParams(window.location.search);
    const page = Math.max(1, Number(params.get("page") ?? 1) || 1);
    for (const card of cards) {
      if (!(card instanceof HTMLElement)) continue;
      const tags = (card.dataset.tags ?? "").split(",").filter(Boolean);
      const status = card.dataset.health ?? "unknown";
      const matches =
        (!filters.q || (card.dataset.search ?? "").includes(filters.q)) &&
        (!filters.category || card.dataset.category === filters.category) &&
        (!filters.tag || tags.includes(filters.tag)) &&
        (!filters.language || card.dataset.language === filters.language) &&
        (!filters.license || card.dataset.license === filters.license) &&
        (!filters.health || filters.health === "all" || status === filters.health) &&
        (!filters.maintained || ["active", "mature"].includes(status)) &&
        (!filters.hideArchived || status !== "archived") &&
        (!filters.hasRecentRelease || card.dataset.release === "1");
      const visibleIndex = visible;
      const onPage = visibleIndex >= (page - 1) * pageSize && visibleIndex < page * pageSize;
      card.hidden = !matches || !onPage;
      if (matches) visible += 1;
    }
    if (count) count.textContent = `${visible} of ${cards.length} projects`;
    if (empty instanceof HTMLElement) empty.hidden = visible !== 0;

    if (updateUrl && form instanceof HTMLFormElement) {
      const params = new URLSearchParams();
      const data = new FormData(form);
      for (const [key, value] of data.entries()) {
        const text = String(value);
        if (!text || text === "all") continue;
        params.set(key, text);
      }
      if (filters.sort && filters.sort !== "recently-updated") params.set("sort", filters.sort);
      if (filters.density && filters.density !== "comfortable") params.set("density", filters.density);
      const query = params.toString();
      history.replaceState(null, "", query ? `${location.pathname}?${query}` : location.pathname);
    }
  }

  setFormFromUrl();
  applyFilters(false);
  if (form instanceof HTMLFormElement) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      applyFilters(true);
    });
    form.addEventListener("change", () => applyFilters(true));
  }
  document.querySelector("#sort-select")?.addEventListener("change", () => {
    const params = new URLSearchParams(window.location.search);
    const value = document.querySelector("#sort-select")?.value;
    if (value && value !== "recently-updated") params.set("sort", value);
    else params.delete("sort");
    params.delete("page");
    location.assign(`${location.pathname}${params.toString() ? `?${params}` : ""}`);
  });
  document.querySelectorAll(".oc-density a").forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      const params = new URLSearchParams(window.location.search);
      const density = event.currentTarget?.dataset?.density;
      if (density === "compact") params.set("density", "compact");
      else params.delete("density");
      params.delete("page");
      location.assign(`${location.pathname}${params.toString() ? `?${params}` : ""}`);
    });
  });
</script>
