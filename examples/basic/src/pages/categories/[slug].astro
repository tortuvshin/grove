---
import BaseLayout from "@open-curated/astro/layouts/BaseLayout.astro";
import ItemCard from "@open-curated/astro/components/ItemCard.astro";
import { categoryBySlug, readDirectory } from "../../lib/directory";
import { slugForCategory } from "@open-curated/astro";

export function getStaticPaths() {
  const directory = readDirectory();
  return directory.categories.map((category) => ({
    params: { slug: slugForCategory(category.name) },
  }));
}

const directory = categoryBySlug(Astro.params.slug ?? "");
if (!directory) return Astro.redirect("/projects");
---

<BaseLayout title={`${directory.category.name} Projects`}>
  <section>
    <p class="oc-eyebrow">Category</p>
    <h1>{directory.category.name}</h1>
    <p class="oc-lede">{directory.category.count} projects in this category.</p>
  </section>
  <section class="oc-grid">
    {directory.results.map((record) => <ItemCard item={record.item} health={record.health} />)}
  </section>
</BaseLayout>
