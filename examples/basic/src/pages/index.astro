---
import BaseLayout from "@open-curated/astro/layouts/BaseLayout.astro";
import ItemCard from "@open-curated/astro/components/ItemCard.astro";
import { buildDirectoryStats, healthForItem } from "@open-curated/astro";
import { itemsFileSchema, healthFileSchema, unwrapHealth, unwrapItems } from "@open-curated/core";
import { readFileSync } from "node:fs";
import { parse } from "yaml";

const items = unwrapItems(itemsFileSchema.parse(parse(readFileSync("data/items.yml", "utf8"))));
const health = unwrapHealth(healthFileSchema.parse(parse(readFileSync("data/health.yml", "utf8"))));
const stats = buildDirectoryStats(items, health);
---

<BaseLayout title="Basic Open Curated Example">
  <section>
    <p class="eyebrow">Open Curated</p>
    <h1>Basic Open Curated Example</h1>
    <p>A tiny static directory generated from file-based project data.</p>
    <dl class="stats">
      <div><dt>Total</dt><dd>{stats.total}</dd></div>
      <div><dt>Active</dt><dd>{stats.active}</dd></div>
      <div><dt>Mature</dt><dd>{stats.mature}</dd></div>
      <div><dt>Needs review</dt><dd>{stats.needsReview}</dd></div>
    </dl>
  </section>
  <section class="grid">
    {items.map((item) => <ItemCard item={item} health={healthForItem(item, health)} />)}
  </section>
</BaseLayout>

<style>
  h1 {
    margin: 0;
    font-size: 2rem;
  }

  .eyebrow {
    margin: 0 0 8px;
    color: #0f766e;
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .stats,
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px;
  }

  .stats {
    margin: 24px 0;
  }

  .stats div {
    border: 1px solid #dddddd;
    border-radius: 8px;
    background: #ffffff;
    padding: 12px;
  }

  dt {
    color: #666666;
    font-size: 0.75rem;
  }

  dd {
    margin: 4px 0 0;
    font-size: 1.5rem;
    font-weight: 700;
  }
</style>
