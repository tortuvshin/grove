---
import BaseLayout from "@open-curated/astro/layouts/BaseLayout.astro";
import ItemCard from "@open-curated/astro/components/ItemCard.astro";
import DirectoryHero from "@open-curated/astro/components/DirectoryHero.astro";
import CategoryGrid from "@open-curated/astro/components/CategoryGrid.astro";
import MethodologyPanel from "@open-curated/astro/components/MethodologyPanel.astro";
import { buildDirectoryStats, sortRecords } from "@open-curated/astro";
import { readDirectory } from "../lib/directory";

const directory = readDirectory();
const stats = buildDirectoryStats(directory.items, directory.health);
const featured = sortRecords(directory.records).slice(0, 3);
---

<BaseLayout title="Basic Open Curated Example">
  <DirectoryHero
    name="Basic Open Curated Example"
    tagline="A searchable, filterable, health-aware developer directory generated from files."
    stats={stats}
  />

  <section class="oc-section">
    <div class="oc-section-header">
      <div>
        <p class="oc-eyebrow">Featured</p>
        <h2>Useful maintained projects</h2>
      </div>
      <a href="/projects">Browse directory</a>
    </div>
    <div class="oc-grid">
      {featured.map((record) => (
        <ItemCard item={record.item} health={record.health} />
      ))}
    </div>
  </section>

  <CategoryGrid categories={directory.categories} />
  <MethodologyPanel />
</BaseLayout>
