# Integration smoke artifacts — `grove new` scaffolds land here
# if the test mis-routes. Keeping them out of git.
test-tmp/
test-tmp-*/


# Local Grove state — `grove run` writes timestamped scratch projects
# under <monorepo>/.grove/run/. None of this should be committed.
# (Audit finding #10.)
#
# Anchored to the repo root on purpose. A bare `.grove/` matches at
# every depth, which also swallowed `apps/example/.grove/registry.lock.json`
# — the install-time snapshot `grove update` diffs against. A consumer
# that copies this file (Open Apps did) ends up unable to run
# `grove update` at all: no lockfile, exit 1. The lockfile is a
# committed artifact, like a package lock.
/.grove/
.worktrees/

# `node scripts/check-packaging.mjs --out packed` — tarballs built to be
# looked at, never to be committed. CI uploads them as an artifact instead.
packed/
*.tgz

# Local scaffold smoke tests — never commit a `grove new` scratch site.
examples/*/
.audit/

# Biome linter/formatter cache
.cache/

# Generated by scripts/build-registry.mjs (authored items + the full default scaffold); shadcn build reads it.
packages/registry/registry.build.json
