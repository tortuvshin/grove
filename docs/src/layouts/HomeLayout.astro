---
import '../styles/home.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Grove',
  description = 'Grove turns structured files into static, searchable, contributor-friendly knowledge spaces.',
} = Astro.props
---

<!doctype html>
<html lang="en" class="bg-bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-bg text-fg antialiased">
    <slot />
  </body>
</html>
