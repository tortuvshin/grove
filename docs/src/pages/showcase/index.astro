---
/**
 * Showcase hub — fully custom Astro page that gathers every Starlight
 * component, splash layout, and typography example under one URL.
 *
 * The deep pages (e.g. /showcase/splash/centered/) still live in the
 * Starlight content tree. This page is the marketing-style landing for the
 * entire showcase surface.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

type ShowcaseItem = {
    title: string;
    desc: string;
    href: string;
    tag: string;
    icon: 'card' | 'splash' | 'type' | 'page' | 'list';
};

const groups: { heading: string; lead: string; items: ShowcaseItem[] }[] = [
    {
        heading: 'Component Gallery',
        lead: 'Every state of every primitive, side by side. Use these as a quick visual reference when designing a new doc page.',
        items: [
            {
                title: 'Starlight Components',
                desc: 'Cards, asides, tabs, badges, code blocks — full visual inventory.',
                href: '/showcase/starlight-components/',
                tag: 'Components',
                icon: 'card',
            },
            {
                title: 'Typography',
                desc: 'Headings, body copy, lists, callouts, links — the type system under everything.',
                href: '/showcase/typography/',
                tag: 'Type',
                icon: 'type',
            },
        ],
    },
    {
        heading: 'Splash Layouts',
        lead: 'Five hero layouts for landing pages, release hubs, and feature entries. Pick the one that matches the page\'s role.',
        items: [
            {
                title: 'Centered',
                desc: 'Classic docs landing. Text first, optional media below.',
                href: '/showcase/splash/centered/',
                tag: 'Splash',
                icon: 'splash',
            },
            {
                title: 'Centered Top',
                desc: 'Visual leads the page; copy supports it.',
                href: '/showcase/splash/centered-top/',
                tag: 'Splash',
                icon: 'splash',
            },
            {
                title: 'Split Left',
                desc: 'Product-docs rhythm: copy on the left, media on the right.',
                href: '/showcase/splash/split-left/',
                tag: 'Splash',
                icon: 'splash',
            },
            {
                title: 'Split Right',
                desc: 'Media anchors the first glance; copy closes the pitch.',
                href: '/showcase/splash/split-right/',
                tag: 'Splash',
                icon: 'splash',
            },
            {
                title: 'Banner',
                desc: 'Editorial layout — copy and metadata above a wide visual.',
                href: '/showcase/splash/banner/',
                tag: 'Splash',
                icon: 'splash',
            },
        ],
    },
    {
        heading: 'Quick References',
        lead: 'The everything-else index: a single page that links out to every deep example.',
        items: [
            {
                title: 'Splash Pages overview',
                desc: 'Compare the five layouts side by side with frontmatter snippets.',
                href: '/showcase/splash-pages/',
                tag: 'Index',
                icon: 'list',
            },
        ],
    },
];
---

<BaseLayout
    title="Showcase — Grove"
    description="Every Starlight component, splash layout, and typography example Grove ships with. Visual reference for docs authors."
    activeNav="showcase"
>
    <section class="show-hero">
        <div class="g-container">
            <p class="eyebrow">Showcase</p>
            <h1>Visual reference for Grove docs authors.</h1>
            <p class="show-lead">
                Every component, layout, and typography example Grove ships with — gathered in
                one place. Use these pages to pick a layout, compare states, or copy frontmatter
                straight into your own Space.
            </p>
        </div>
    </section>

    {
        groups.map((g) => (
            <section class="show-section">
                <div class="g-container">
                    <div class="show-section-head">
                        <h2>{g.heading}</h2>
                        <p>{g.lead}</p>
                    </div>
                    <div class="show-grid">
                        {g.items.map((item) => (
                            <a class="show-card" href={item.href}>
                                <div class="show-card-thumb" aria-hidden="true">
                                    {item.icon === 'card' && (
                                        <svg viewBox="0 0 64 40" width="100%" height="100%" preserveAspectRatio="xMidYMid meet">
                                            <rect x="2" y="2" width="60" height="36" rx="6" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.4" />
                                            <rect x="8" y="8" width="22" height="24" rx="3" fill="currentColor" opacity="0.5" />
                                            <rect x="34" y="8" width="22" height="6" rx="2" fill="currentColor" opacity="0.3" />
                                            <rect x="34" y="18" width="22" height="4" rx="2" fill="currentColor" opacity="0.2" />
                                            <rect x="34" y="26" width="14" height="4" rx="2" fill="currentColor" opacity="0.2" />
                                        </svg>
                                    )}
                                    {item.icon === 'type' && (
                                        <svg viewBox="0 0 64 40" width="100%" height="100%" preserveAspectRatio="xMidYMid meet">
                                            <rect x="2" y="2" width="60" height="36" rx="6" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.4" />
                                            <text x="32" y="22" text-anchor="middle" font-family="serif" font-size="18" font-weight="700" fill="currentColor">Aa</text>
                                            <line x1="10" y1="30" x2="54" y2="30" stroke="currentColor" stroke-width="1.2" opacity="0.3" />
                                        </svg>
                                    )}
                                    {item.icon === 'splash' && (
                                        <svg viewBox="0 0 64 40" width="100%" height="100%" preserveAspectRatio="xMidYMid meet">
                                            <rect x="2" y="2" width="60" height="36" rx="6" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.4" />
                                            <rect x="8" y="8" width="20" height="3" rx="1.5" fill="currentColor" opacity="0.7" />
                                            <rect x="8" y="14" width="14" height="2" rx="1" fill="currentColor" opacity="0.4" />
                                            <rect x="8" y="19" width="14" height="2" rx="1" fill="currentColor" opacity="0.4" />
                                            <rect x="36" y="8" width="20" height="24" rx="3" fill="currentColor" opacity="0.18" />
                                        </svg>
                                    )}
                                    {item.icon === 'list' && (
                                        <svg viewBox="0 0 64 40" width="100%" height="100%" preserveAspectRatio="xMidYMid meet">
                                            <rect x="2" y="2" width="60" height="36" rx="6" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.4" />
                                            <circle cx="10" cy="10" r="1.5" fill="currentColor" />
                                            <rect x="14" y="9" width="40" height="2" rx="1" fill="currentColor" opacity="0.6" />
                                            <circle cx="10" cy="16" r="1.5" fill="currentColor" />
                                            <rect x="14" y="15" width="34" height="2" rx="1" fill="currentColor" opacity="0.4" />
                                            <circle cx="10" cy="22" r="1.5" fill="currentColor" />
                                            <rect x="14" y="21" width="38" height="2" rx="1" fill="currentColor" opacity="0.4" />
                                        </svg>
                                    )}
                                </div>
                                <div class="show-card-body">
                                    <span class="show-card-tag">{item.tag}</span>
                                    <h3>{item.title}</h3>
                                    <p>{item.desc}</p>
                                    <span class="show-card-cta">
                                        Open example
                                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                                            <path d="M5 12h14m-6-6 6 6-6 6"></path>
                                        </svg>
                                    </span>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>
            </section>
        ))
    }
</BaseLayout>

<style>
    .show-hero {
        padding-block: 80px 40px;
        border-bottom: 1px solid var(--g-color-border);
        background: radial-gradient(ellipse at top, var(--g-color-accent-soft), transparent 60%);
    }

    .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.18em;
        font-size: 0.75rem;
        color: var(--g-color-accent);
        font-weight: 600;
    }

    .show-hero h1 {
        margin-top: 14px;
        font-size: clamp(2rem, 4.5vw, 3.2rem);
        letter-spacing: -0.025em;
    }

    .show-lead {
        margin-top: 16px;
        max-width: 64ch;
        color: var(--g-color-text-muted);
        font-size: 1.08rem;
        line-height: 1.65;
    }

    .show-section {
        padding-block: 64px;
    }

    .show-section + .show-section {
        border-top: 1px solid var(--g-color-border);
    }

    .show-section-head {
        margin-bottom: 32px;
    }

    .show-section-head h2 {
        font-size: 1.6rem;
        letter-spacing: -0.02em;
    }

    .show-section-head p {
        margin-top: 8px;
        color: var(--g-color-text-muted);
        max-width: 64ch;
    }

    .show-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
    }

    .show-card {
        display: flex;
        flex-direction: column;
        background: var(--g-color-bg-card);
        border: 1px solid var(--g-color-border);
        border-radius: var(--g-radius);
        overflow: hidden;
        color: var(--g-color-text);
        transition: border-color 0.15s ease, transform 0.15s ease;
    }

    .show-card:hover {
        border-color: var(--g-color-accent);
        transform: translateY(-3px);
    }

    .show-card-thumb {
        aspect-ratio: 16 / 10;
        background: linear-gradient(135deg, var(--g-color-accent-soft), transparent 70%), var(--g-color-bg-elev);
        color: var(--g-color-text-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        border-bottom: 1px solid var(--g-color-border);
    }

    .show-card-thumb svg {
        max-width: 70%;
    }

    .show-card-body {
        padding: 20px 22px 22px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        flex: 1;
    }

    .show-card-tag {
        display: inline-block;
        align-self: flex-start;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        padding: 3px 8px;
        border-radius: 999px;
        background: var(--g-color-accent-soft);
        color: var(--g-color-accent);
        font-weight: 600;
    }

    .show-card-body h3 {
        font-size: 1.08rem;
        margin-top: 4px;
    }

    .show-card-body p {
        color: var(--g-color-text-muted);
        font-size: 0.92rem;
        line-height: 1.55;
        flex: 1;
    }

    .show-card-cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--g-color-accent);
        font-weight: 600;
        font-size: 0.88rem;
        margin-top: 8px;
    }
</style>
