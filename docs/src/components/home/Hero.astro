---
---

<section class="mx-auto max-w-7xl px-6 pt-24 pb-28 text-center sm:pt-32">
  <h1
    class="mx-auto max-w-4xl text-balance text-5xl font-bold leading-[1.05] tracking-tight text-fg sm:text-6xl md:text-7xl"
  >
    The framework for community knowledge
  </h1>
  <p
    class="mx-auto mt-7 max-w-xl text-pretty text-lg leading-relaxed text-muted"
  >
    Grove turns structured files into static, searchable, contributor-friendly
    knowledge spaces.
  </p>

  <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
    <a
      href="#"
      class="rounded-lg bg-fg px-5 py-2.5 text-sm font-semibold text-bg transition-opacity hover:opacity-90"
    >
      Get Started
    </a>
    <a
      href="#"
      class="rounded-lg border border-border-strong bg-card px-5 py-2.5 text-sm font-semibold text-fg transition-colors hover:bg-card-hover"
    >
      View on GitHub
    </a>
  </div>

  <div class="mt-12 flex items-center justify-center">
    <div
      class="flex items-center gap-3 rounded-lg border border-border bg-surface px-4 py-2.5 font-mono text-sm"
    >
      <span class="text-subtle">$</span>
      <code class="text-muted">npx @grove-dev/cli@latest new my-space</code>
      <button
        type="button"
        class="flex size-7 items-center justify-center rounded-md border border-border-strong text-subtle transition-colors hover:bg-card hover:text-fg"
        aria-label="Copy command"
      >
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
      </button>
    </div>
  </div>
</section>
