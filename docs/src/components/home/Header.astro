---
const navLinks = [
  { label: 'How it works', href: '#how-it-works' },
  { label: 'Example', href: '#open-apps' },
  { label: 'Docs', href: '/introduction/' },
  { label: 'Roadmap', href: '/roadmap/' },
]
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-6">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2.5">
        <svg
          class="size-6 text-fg"
          viewBox="0 0 32 32"
          fill="none"
          aria-hidden="true"
        >
          <path d="M16 28V13" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <path d="M16 13C16 13 16.5 6 24 5C24 5 24 12 16 13Z" fill="currentColor" />
          <path d="M16 13C16 13 15.5 6 8 5C8 5 8 12 16 13Z" fill="currentColor" fill-opacity="0.7" />
          <path d="M16 18C16 18 16.2 21 19.5 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <path d="M16 21C16 21 15.8 24 12.5 25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <span class="text-base font-semibold tracking-tight text-fg">Grove</span>
      </a>
      <nav class="hidden items-center gap-6 md:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm text-muted transition-colors hover:text-fg"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="/getting-started/create-a-space/"
        class="hidden rounded-lg bg-fg px-4 py-2 text-sm font-semibold text-bg transition-opacity hover:opacity-90 sm:inline-flex"
      >
        Get started
      </a>
      <details class="relative md:hidden">
        <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-lg border border-border text-muted" aria-label="Open navigation menu">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </summary>
        <nav class="absolute right-0 top-12 w-60 rounded-xl border border-border-strong bg-card p-2 shadow-2xl" aria-label="Mobile navigation">
          {navLinks.map((link) => <a href={link.href} class="block rounded-lg px-4 py-3 text-sm text-muted hover:bg-card-hover hover:text-fg">{link.label}</a>)}
          <a href="/getting-started/create-a-space/" class="mt-1 block rounded-lg bg-fg px-4 py-3 text-center text-sm font-semibold text-bg">Get started</a>
        </nav>
      </details>
      <a
        href="https://github.com/tortuvshin/grove"
        class="flex size-9 items-center justify-center rounded-lg text-muted transition-colors hover:bg-card hover:text-fg"
        aria-label="GitHub"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>
