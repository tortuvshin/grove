---
const navLinks = [
  { label: 'Demo', href: 'https://open-apps.dev.mn', external: true },
  { label: 'Docs', href: '/introduction/' },
  { label: 'Open Apps', href: '/open-apps/' },
  { label: 'Roadmap', href: '/roadmap' },
]
---

<header class="sticky top-0 z-50 border-b border-border/60 bg-bg/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-6">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2.5">
        <svg
          class="size-6 text-fg"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="0.9"
          aria-hidden="true"
        >
          <path
            d="M14.2 14.2H17V6.9375C17 4.76288 15.2371 3 13.0625 3H5.8V5.8M14.2 14.2V7.79063L7.79062 14.2H14.2ZM14.2 14.2V17H6.9375C4.76288 17 3 15.2371 3 13.0625V5.8H5.8M5.8 5.8V12.2313L12.2313 5.8H5.8Z"
            stroke-linejoin="round"></path>
        </svg>
        <span class="text-base font-semibold tracking-tight text-fg">Grove</span>
      </a>
      <nav class="hidden items-center gap-6 md:flex">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm text-muted transition-colors hover:text-fg"
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="flex items-center gap-3">
      <a
        href="https://github.com/tortuvshin/grove"
        class="flex size-9 items-center justify-center rounded-lg text-muted transition-colors hover:bg-card hover:text-fg"
        aria-label="GitHub"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</header>
