---
// Honest framework support matrix.
// Audit finding (public-claim-matrix.md §A): the previous version displayed
// 8 framework logos at the same status. Reality: only Astro is supported
// today. SvelteKit and Next.js are skeleton adapters planned for V1.1 / V1.2.
// Tailwind, Node.js, and GitHub are not framework adapters — they're tooling
// the framework is built on — so they get their own category below.
const supported = [
  { src: '/logos/astro.svg', name: 'Astro', note: 'V1 supported renderer' },
];

const planned = [
  { src: '/logos/svelte.svg', name: 'SvelteKit', note: 'Skeleton · planned V1.1' },
  { src: '/logos/nextdotjs.svg', name: 'Next.js', note: 'Skeleton · planned V1.2' },
];

const tooling = [
  { src: '/logos/tailwindcss.svg', name: 'Tailwind CSS', note: 'Styling' },
  { src: '/logos/nodedotjs.svg', name: 'Node.js', note: 'Runtime (>=20)' },
  { src: '/logos/github.svg', name: 'GitHub', note: 'Data source + Actions' },
];
---

<section class="mx-auto max-w-7xl px-6 py-16" aria-labelledby="frameworks-title">
  <p class="text-center text-xs font-semibold uppercase tracking-widest text-subtle">
    Framework support
  </p>
  <h2
    id="frameworks-title"
    class="mt-3 text-balance text-center text-2xl font-bold tracking-tight text-fg sm:text-3xl"
  >
    One renderer today. Two more on the roadmap.
  </h2>
  <p class="mx-auto mt-3 max-w-2xl text-center text-sm text-muted">
    Grove's adapter layer keeps the engine framework-agnostic. The same data
    drives any renderer; the renderer you ship today decides what users see.
  </p>

  <div class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-xl border border-border bg-card p-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent-green">
        Supported today
      </p>
      <ul class="mt-5 flex flex-wrap gap-3">
        {
          supported.map((l) => (
            <li class="flex items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3">
              <img
                src={l.src}
                alt={`${l.name} logo`}
                width="24"
                height="24"
                loading="lazy"
                decoding="async"
                class="h-6 w-6 object-contain"
              />
              <div>
                <p class="text-sm font-semibold text-fg">{l.name}</p>
                <p class="text-xs text-muted">{l.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rounded-xl border border-border bg-card p-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-subtle">
        Planned adapters
      </p>
      <ul class="mt-5 flex flex-wrap gap-3">
        {
          planned.map((l) => (
            <li class="flex items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3 opacity-80">
              <img
                src={l.src}
                alt={`${l.name} logo`}
                width="24"
                height="24"
                loading="lazy"
                decoding="async"
                class="h-6 w-6 object-contain grayscale"
              />
              <div>
                <p class="text-sm font-semibold text-fg">{l.name}</p>
                <p class="text-xs text-muted">{l.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-xs text-muted">
        The CLI refuses <code class="font-mono text-[11px]">--framework &#123;svelte|nextjs&#125;</code>
        until the adapter ships components, layouts, and a working template.
      </p>
    </div>

    <div class="rounded-xl border border-border bg-card p-6">
      <p class="text-xs font-semibold uppercase tracking-widest text-subtle">
        Built on
      </p>
      <ul class="mt-5 flex flex-wrap gap-3">
        {
          tooling.map((l) => (
            <li class="flex items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3">
              <img
                src={l.src}
                alt={`${l.name} logo`}
                width="24"
                height="24"
                loading="lazy"
                decoding="async"
                class="h-6 w-6 object-contain opacity-80"
              />
              <div>
                <p class="text-sm font-semibold text-fg">{l.name}</p>
                <p class="text-xs text-muted">{l.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>