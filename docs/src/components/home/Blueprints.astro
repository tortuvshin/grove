---
const blueprints = [
  {
    name: 'Awesome List',
    desc: 'Curate links, tools, and resources into a browsable directory.',
    tag: 'Directory',
    color: 'text-accent-cyan',
    icon: 'star',
  },
  {
    name: 'Docs Space',
    desc: 'Versioned guides and references with full-text search built in.',
    tag: 'Documentation',
    color: 'text-accent-blue',
    icon: 'book',
  },
  {
    name: 'Community Wiki',
    desc: 'Collaborative pages reviewed and merged through pull requests.',
    tag: 'Knowledge base',
    color: 'text-accent-green',
    icon: 'users',
  },
  {
    name: 'Dataset Catalog',
    desc: 'Structured records with metadata, taxonomy, and health signals.',
    tag: 'Data',
    color: 'text-accent-orange',
    icon: 'grid',
  },
]
---

<section class="mx-auto max-w-7xl px-6 py-20">
  <p class="text-xs font-semibold uppercase tracking-widest text-subtle">
    Blueprints
  </p>
  <h2
    class="mt-5 max-w-2xl text-balance text-4xl font-bold leading-[1.1] tracking-tight text-fg sm:text-5xl"
  >
    Start from a blueprint, ship in minutes.
  </h2>
  <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted">
    Every Grove space begins with a blueprint — a fully wired starting point you
    can customize end to end.
  </p>

  <div class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      blueprints.map((b) => (
        <article class="group flex flex-col rounded-xl border border-border bg-card p-6 transition-colors hover:bg-card-hover">
          <div class={`flex size-10 items-center justify-center rounded-lg border border-border-strong bg-surface ${b.color}`}>
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {b.icon === 'star' && (
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              )}
              {b.icon === 'book' && (
                <>
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                </>
              )}
              {b.icon === 'users' && (
                <>
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </>
              )}
              {b.icon === 'grid' && (
                <>
                  <rect x="3" y="3" width="7" height="7" rx="1" />
                  <rect x="14" y="3" width="7" height="7" rx="1" />
                  <rect x="3" y="14" width="7" height="7" rx="1" />
                  <rect x="14" y="14" width="7" height="7" rx="1" />
                </>
              )}
            </svg>
          </div>
          <span class="mt-5 text-xs font-medium uppercase tracking-wide text-subtle">
            {b.tag}
          </span>
          <h3 class="mt-1.5 text-base font-semibold text-fg">{b.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{b.desc}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-fg opacity-70 transition-opacity group-hover:opacity-100">
            Use blueprint
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14" />
              <path d="m12 5 7 7-7 7" />
            </svg>
          </span>
        </article>
      ))
    }
  </div>
</section>
