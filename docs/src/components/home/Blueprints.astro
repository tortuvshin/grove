---
const blueprints = [
  {
    name: 'Project directories',
    desc: 'Developer tools, open-source apps, packages, services, or internal systems.',
    tag: 'Available today',
    color: 'text-accent-cyan',
    icon: 'star',
  },
  {
    name: 'Resource hubs',
    desc: 'Guides, comparisons, explainers, learning collections, and curated links.',
    tag: 'Schema available',
    color: 'text-accent-blue',
    icon: 'book',
  },
  {
    name: 'Ecosystem maps',
    desc: 'Organizations, products, communities, schools, and local ecosystem actors.',
    tag: 'Schema available',
    color: 'text-accent-green',
    icon: 'users',
  },
  {
    name: 'Maintained awesome lists',
    desc: 'Import a Markdown collection, then add structure, review, and static discovery.',
    tag: 'Import path',
    color: 'text-accent-orange',
    icon: 'grid',
  },
]
---

<section class="mx-auto max-w-7xl px-6 py-20" aria-labelledby="blueprints-title">
  <p class="text-xs font-semibold uppercase tracking-widest text-subtle">
    What Grove can power
  </p>
  <h2
    id="blueprints-title"
    class="mt-5 max-w-2xl text-balance text-4xl font-bold leading-[1.1] tracking-tight text-fg sm:text-5xl"
  >
    For collections that need to stay useful.
  </h2>
  <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted">
    Grove is not only a directory template. Its record model supports three typed blueprints; the polished default frontend is available for project directories today.
  </p>

  <div class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      blueprints.map((b) => (
        <article class="group flex flex-col rounded-xl border border-border bg-card p-6 transition-colors hover:bg-card-hover">
          <div class={`flex size-10 items-center justify-center rounded-lg border border-border-strong bg-surface ${b.color}`}>
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {b.icon === 'star' && (
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
              )}
              {b.icon === 'book' && (
                <>
                  <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                  <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                </>
              )}
              {b.icon === 'users' && (
                <>
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                  <circle cx="9" cy="7" r="4" />
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                </>
              )}
              {b.icon === 'grid' && (
                <>
                  <rect x="3" y="3" width="7" height="7" rx="1" />
                  <rect x="14" y="3" width="7" height="7" rx="1" />
                  <rect x="3" y="14" width="7" height="7" rx="1" />
                  <rect x="14" y="14" width="7" height="7" rx="1" />
                </>
              )}
            </svg>
          </div>
          <span class="mt-5 text-xs font-medium uppercase tracking-wide text-subtle">
            {b.tag}
          </span>
          <h3 class="mt-1.5 text-base font-semibold text-fg">{b.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{b.desc}</p>
        </article>
      ))
    }
  </div>
</section>
