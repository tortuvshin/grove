---
/**
 * Footer for the custom Astro pages.
 *
 * Matches the Starlight docs footer chrome: copyright + "Made with
 * Starlight" credit, sized to the same columns and hairlines.
 */
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="footer-inner">
        <div class="meta sl-flex">
            <a href="https://starlight.astro.build" class="kudos sl-flex" rel="noopener">
                <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path
                        d="M24 11.5a5.38 5.38 0 0 1-3.6 1.81 5.46 5.46 0 0 1-5.4-5.4A5.38 5.38 0 0 1 16.81 4.3 11.83 11.83 0 0 0 12 .5C5.65.5.5 5.65.5 12S5.65 23.5 12 23.5 23.5 18.35 23.5 12a11.83 11.83 0 0 0-.5-.5Z"
                    ></path>
                </svg>
                Made with Starlight
            </a>
        </div>
        <p class="copyright">© {year} Grove. Released under the MIT License.</p>
    </div>
</footer>

<style>
    .site-footer {
        padding-block: 1.5rem 2rem;
        border-top: 1px solid var(--sl-color-hairline-light);
        color: var(--sl-color-gray-3);
        font-size: var(--sl-text-sm);
    }

    .footer-inner {
        max-width: var(--sl-container, 100%);
        margin-inline: auto;
        padding-inline: var(--sl-nav-pad-x);
        display: flex;
        gap: 1.5rem;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .meta {
        gap: 0.5rem;
        align-items: center;
    }

    .kudos {
        align-items: center;
        gap: 0.5rem;
        color: var(--sl-color-gray-3);
        text-decoration: none;
        font-weight: 600;
    }

    .kudos:hover {
        color: var(--sl-color-text-accent);
    }

    .kudos svg {
        color: var(--sl-color-orange-high);
    }

    .copyright {
        margin: 0;
    }
</style>
