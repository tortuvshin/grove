---
const command = "npx @grove-dev/cli@latest new my-space";

const features = [
  ["file", "File-based records", "Keep knowledge in reviewable YAML and Markdown files."],
  ["branch", "GitHub-native workflows", "Use pull requests, issues, history, and ownership."],
  ["publish", "Static publishing", "Ship fast, cacheable sites without a backend runtime."],
  ["search", "Search and discovery", "Make directories browsable, filterable, and useful."],
  ["review", "Human review", "Let maintainers approve every community contribution."],
  ["llm", "LLM-friendly outputs", "Publish structured outputs built for agents and search."],
  ["metadata", "Metadata enrichment", "Add health, repository, and taxonomy signals over time."],
  ["frontend", "Customizable frontend", "Start from a blueprint, then make the space yours."],
];

const steps = [
  ["01", "Create a space", "Scaffold a Grove project with the CLI."],
  ["02", "Add records", "Write structured files for projects, resources, or places."],
  ["03", "Build and publish", "Validate, render, and deploy a static knowledge site."],
];

const blueprints = [
  ["Project Directory", "Available", "Curate projects with health, taxonomy, and contributor signals."],
  ["Resource Hub", "Coming soon / Schema-ready", "Organize guides, tools, references, and learning paths."],
  ["Ecosystem Map", "Coming soon / Schema-ready", "Map people, organizations, projects, and relationships."],
];

const integrations = [
  ["Astro", "A", "Available"],
  ["Next.js", "N", "Coming soon"],
  ["Svelte", "S", "Coming soon"],
];

const stackLogos = [
  ["typescript", "TS", "TypeScript", "Typed core"],
  ["astro", "A", "Astro", "Static frontend"],
  ["actions", "GA", "GitHub Actions", "Automation"],
  ["zod", "Z", "Zod", "Validation"],
  ["yaml", "Y", "YAML / Markdown", "Content files"],
  ["hosting", "S", "Static hosting", "Deploy anywhere"],
  ["pnpm", "P", "pnpm", "Workspace tooling"],
  ["starlight", "SL", "Starlight", "Docs ecosystem"],
];
---

<main class="home-landing">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <h1 id="home-title">The framework for community knowledge</h1>
      <p class="lede">
        Grove turns structured files into static, searchable, contributor-friendly knowledge spaces.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="button primary" href="/getting-started/create-a-space/">Get Started</a>
        <a class="button secondary" href="https://github.com/tortuvshin/grove">View on GitHub</a>
      </div>
      <div class="hero-command" aria-label="Create a new Grove space">
        <span aria-hidden="true">$</span>
        <code>{command}</code>
      </div>
    </div>
  </section>

  <section class="section-block" aria-labelledby="what-is-grove">
    <div class="section-heading">
      <p class="eyebrow">What Is Grove</p>
      <h2 id="what-is-grove">Everything a knowledge community needs to ship.</h2>
    </div>
    <div class="feature-grid">
      {features.map(([icon, title, description]) => (
        <article class="feature-card">
          <span class={`feature-icon ${icon}`} aria-hidden="true">
            <svg viewBox="0 0 20 20" role="img">
              {icon === "file" && <path d="M6 3.5h5l3 3v10H6zM11 3.5v3h3M8 10h4M8 13h3" />}
              {icon === "branch" && <path d="M6 5.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM14 10.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM8 7.5h2.5A3.5 3.5 0 0 1 14 11" />}
              {icon === "publish" && <path d="M4 14.5h12M10 14.5v-10M6.5 8 10 4.5 13.5 8" />}
              {icon === "search" && <path d="M9 4.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9ZM12.5 12.5 16 16" />}
              {icon === "review" && <path d="M4.5 10.5 8 14l7.5-8M4 5h6M4 15h3" />}
              {icon === "llm" && <path d="M5 6.5h10M5 10h7M5 13.5h4M13 12.5l1 2 1-2 2-1-2-1-1-2-1 2-2 1z" />}
              {icon === "metadata" && <path d="M5 5.5h10v3H5zM5 11.5h5v3H5zM12 11.5h3v3h-3z" />}
              {icon === "frontend" && <path d="M4 5h12v10H4zM4 8h12M7 12h3M12 12h2" />}
            </svg>
          </span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-block start-section" aria-labelledby="seconds">
    <div class="section-heading">
      <p class="eyebrow">Get Started In Seconds</p>
      <h2 id="seconds">Create, run, and publish a Grove space.</h2>
    </div>

    <div class="start-layout">
      <div class="steps">
        {steps.map(([number, title, description]) => (
          <article class="step">
            <span>{number}</span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="code-card">
        <div class="code-tabs" aria-label="Package manager">
          <span>pnpm</span>
          <span>npm</span>
          <span>bun</span>
        </div>
        <pre><code>npx @grove-dev/cli@latest new my-space
cd my-space
pnpm install
pnpm dev</code></pre>
      </div>
    </div>

    <article class="starter-preview" aria-label="Project Directory Starter preview">
      <div>
        <p class="preview-label">Starter preview</p>
        <h3>Project Directory Starter</h3>
        <p>Records, categories, project pages, search metadata, and deploy-ready static output.</p>
      </div>
      <div class="preview-stack" aria-hidden="true">
        <span>projects/</span>
        <span>categories.yaml</span>
        <span>grove.config.ts</span>
      </div>
    </article>
  </section>

  <section class="section-block" aria-labelledby="ecosystem">
    <div class="section-heading">
      <p class="eyebrow">Ecosystem</p>
      <h2 id="ecosystem">Blueprints and framework integrations.</h2>
    </div>

    <div class="ecosystem-layout">
      <div>
        <h3 class="group-title">Blueprints</h3>
        <div class="compact-grid">
          {blueprints.map(([title, status, description]) => (
            <article class="compact-card">
              <div class="compact-top">
                <h4>{title}</h4>
                <span class:list={["status", status === "Available" ? "available" : "soon"]}>
                  {status}
                </span>
              </div>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>

      <div>
        <h3 class="group-title">Framework Integrations</h3>
        <div class="integration-list">
          {integrations.map(([name, mark, status]) => (
            <article class="integration-card">
              <span class="logo-mark">{mark}</span>
              <div>
                <h4>{name}</h4>
                <span class:list={["status", status === "Available" ? "available" : "soon"]}>
                  {status}
                </span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="powered-section" aria-labelledby="powered-by">
    <div class="section-heading">
      <p class="eyebrow">Powered By</p>
      <h2 id="powered-by">Built on a foundation of production-grade open tooling</h2>
    </div>
    <div class="stack-logo-grid" aria-label="Grove technology stack">
      {stackLogos.map(([kind, mark, name, caption]) => (
        <article class={`stack-logo-card ${kind}`}>
          <span class="stack-logo-mark" aria-hidden="true">{mark}</span>
          <div>
            <h3>{name}</h3>
            <p>{caption}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-title">
    <p class="eyebrow">Start building with Grove</p>
    <h2 id="final-title">Make your community knowledge reviewable, reusable, and ready to publish.</h2>
    <code>{command}</code>
    <div class="hero-actions">
      <a class="button primary" href="/getting-started/create-a-space/">Get Started</a>
      <a class="button secondary" href="https://github.com/tortuvshin/grove">GitHub</a>
    </div>
  </section>
</main>

<style>
  :global(.hero) {
    display: none;
  }

  :global(div[data-slot='doc-title']) {
    display: none !important;
  }

  :global(.sl-markdown-content) {
    max-width: none;
  }

  :global(.sl-markdown-content > .home-landing:first-child) {
    margin-top: 0;
  }

  .home-landing {
    --home-border: color-mix(in oklab, var(--sl-color-gray-5) 38%, transparent);
    --home-panel: color-mix(in oklab, var(--sl-color-gray-6) 74%, var(--sl-color-black));
    --home-panel-strong: color-mix(in oklab, var(--sl-color-gray-6) 88%, var(--sl-color-black));
    --home-text-soft: var(--sl-color-gray-3);
    --home-green: hsl(153, 68%, 42%);
    --home-amber: hsl(38, 88%, 52%);
    display: flex;
    flex-direction: column;
    gap: 7rem;
    padding: 4.5rem 1.25rem 5rem;
  }

  .home-hero,
  .section-block,
  .powered-section,
  .final-cta {
    width: min(100%, 72rem);
    margin-inline: auto;
  }

  .home-hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: min(31rem, calc(100vh - var(--sl-nav-height) - 2rem));
    text-align: center;
  }

  .hero-copy {
    display: grid;
    justify-items: center;
    gap: 1.35rem;
    width: min(100%, 54rem);
  }

  .eyebrow {
    color: var(--sl-color-text-accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  h4,
  p {
    margin: 0;
  }

  h1 {
    max-width: 16ch;
    color: var(--sl-color-white);
    font-size: clamp(2.6rem, 4.9vw, 4.35rem);
    font-weight: 740;
    line-height: 1;
    letter-spacing: 0;
  }

  .lede {
    max-width: 41rem;
    color: var(--sl-color-gray-2);
    font-size: 1.04rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.55rem;
    border: 1px solid var(--home-border);
    border-radius: 0.5rem;
    padding: 0.65rem 1rem;
    font-size: 0.94rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button.primary {
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    border-color: var(--sl-color-white);
  }

  .button.secondary {
    background: var(--home-panel);
    color: var(--sl-color-white);
  }

  .code-card,
  .starter-preview,
  .compact-card,
  .integration-card,
  .feature-card {
    border: 1px solid var(--home-border);
    border-radius: 0.5rem;
    background: var(--home-panel);
    box-shadow: 0 22px 80px color-mix(in oklab, var(--sl-color-black) 45%, transparent);
  }

  .hero-command {
    display: flex;
    max-width: 100%;
    align-items: center;
    gap: 0.55rem;
    color: var(--home-text-soft);
    font-family: var(--sl-font-system-mono);
    font-size: 0.82rem;
    line-height: 1.4;
  }

  .hero-command span {
    color: var(--sl-color-gray-4);
  }

  .hero-command code {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  pre {
    overflow: auto;
    margin: 0;
    padding: 1.1rem;
    color: var(--sl-color-gray-1);
    font-size: 0.9rem;
    line-height: 1.75;
  }

  code {
    font-family: var(--sl-font-system-mono);
  }

  .section-block,
  .powered-section {
    display: grid;
    gap: 1.5rem;
  }

  .section-heading {
    display: grid;
    gap: 0.55rem;
    max-width: 45rem;
  }

  h2 {
    color: var(--sl-color-white);
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    align-items: stretch;
    gap: 0.75rem;
  }

  .feature-card {
    display: grid;
    grid-template-rows: auto auto 1fr;
    height: 100%;
    gap: 0.8rem;
    min-height: 9.75rem;
    padding: 1.05rem;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .feature-card:hover {
    border-color: color-mix(in oklab, var(--sl-color-gray-4) 72%, var(--sl-color-white));
    background: color-mix(in oklab, var(--home-panel) 84%, var(--sl-color-gray-5));
    transform: translateY(-2px);
  }

  .feature-icon {
    display: inline-grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--sl-color-gray-5) 24%, transparent);
    color: var(--sl-color-gray-1);
  }

  .feature-icon.file,
  .feature-icon.publish,
  .feature-icon.search {
    color: hsl(194, 83%, 66%);
  }

  .feature-icon.branch,
  .feature-icon.review {
    color: hsl(153, 68%, 56%);
  }

  .feature-icon.llm,
  .feature-icon.metadata {
    color: hsl(39, 92%, 64%);
  }

  .feature-icon.frontend {
    color: hsl(267, 88%, 74%);
  }

  .feature-icon svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  h3,
  h4 {
    color: var(--sl-color-white);
    font-size: 1rem;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .feature-card p,
  .step p,
  .compact-card p,
  .starter-preview p {
    color: var(--home-text-soft);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .start-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1.2fr);
    gap: 1rem;
  }

  .steps {
    display: grid;
    gap: 0.75rem;
  }

  .step {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
    padding: 1rem 0;
    border-bottom: 1px solid var(--home-border);
  }

  .step span {
    color: var(--sl-color-text-accent);
    font-family: var(--sl-font-system-mono);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .code-card {
    overflow: hidden;
    background: var(--home-panel-strong);
  }

  .code-tabs {
    display: flex;
    gap: 0.45rem;
    border-bottom: 1px solid var(--home-border);
    padding: 0.7rem;
  }

  .code-tabs span {
    border-radius: 999px;
    padding: 0.32rem 0.65rem;
    color: var(--home-text-soft);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .code-tabs span:first-child {
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .starter-preview {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
  }

  .preview-label {
    color: var(--sl-color-text-accent);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .preview-stack {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .preview-stack span {
    border: 1px solid var(--home-border);
    border-radius: 999px;
    background: color-mix(in oklab, var(--sl-color-gray-6) 56%, transparent);
    color: var(--sl-color-gray-2);
    padding: 0.45rem 0.7rem;
    font-size: 0.82rem;
    font-weight: 650;
  }

  .ecosystem-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: 1.25rem;
  }

  .group-title {
    margin-bottom: 0.75rem;
  }

  .compact-grid,
  .integration-list {
    display: grid;
    gap: 0.75rem;
  }

  .compact-card,
  .integration-card {
    padding: 1rem;
  }

  .compact-top {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .status {
    flex: 0 0 auto;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.22rem 0.5rem;
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1;
  }

  .status.available {
    color: var(--home-green);
  }

  .status.soon {
    color: var(--home-amber);
  }

  .integration-card {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  .logo-mark {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.5rem;
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    font-size: 1.1rem;
    font-weight: 850;
  }

  .powered-section {
    border-top: 1px solid var(--home-border);
    border-bottom: 1px solid var(--home-border);
    padding-block: 4rem;
    gap: 2.5rem;
  }

  .powered-section .section-heading {
    max-width: none;
    justify-items: center;
    text-align: center;
  }

  .powered-section h2 {
    max-width: 24ch;
  }

  .stack-logo-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 0.8rem;
  }

  .stack-logo-card {
    display: flex;
    height: 100%;
    min-height: 7.5rem;
    align-items: center;
    gap: 0.9rem;
    border: 1px solid var(--home-border);
    border-radius: 0.5rem;
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--sl-color-gray-5) 12%, transparent), transparent),
      var(--home-panel);
    box-shadow: 0 18px 70px color-mix(in oklab, var(--sl-color-black) 42%, transparent);
    padding: 1rem;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 180ms ease;
  }

  .stack-logo-card.astro {
    --accent-color: hsl(279, 88%, 68%);
  }

  .stack-logo-card.typescript {
    --accent-color: hsl(204, 86%, 60%);
  }

  .stack-logo-card.actions,
  .stack-logo-card.zod {
    --accent-color: hsl(153, 68%, 56%);
  }

  .stack-logo-card.yaml,
  .stack-logo-card.hosting {
    --accent-color: hsl(39, 92%, 64%);
  }

  .stack-logo-card.pnpm,
  .stack-logo-card.starlight {
    --accent-color: hsl(194, 83%, 66%);
  }

  .stack-logo-card:hover {
    border-color: color-mix(in oklab, var(--accent-color, var(--sl-color-white)) 54%, var(--sl-color-gray-5));
    background: color-mix(in oklab, var(--home-panel) 86%, var(--sl-color-gray-5));
    transform: translateY(-2px);
  }

  .stack-logo-mark {
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--accent-color) 18%, transparent);
    color: color-mix(in oklab, var(--accent-color) 70%, var(--sl-color-white));
    font-size: 0.85rem;
    font-weight: 850;
    letter-spacing: 0;
  }

  .stack-logo-card h3 {
    font-size: 1rem;
  }

  .stack-logo-card p {
    margin-top: 0.2rem;
    color: var(--home-text-soft);
    font-size: 0.82rem;
    line-height: 1.35;
  }

  .final-cta {
    display: grid;
    justify-items: center;
    gap: 1rem;
    border: 1px solid var(--home-border);
    border-radius: 0.5rem;
    background: var(--home-panel-strong);
    padding: clamp(2rem, 6vw, 4rem);
    text-align: center;
  }

  .final-cta h2 {
    max-width: 16ch;
  }

  .final-cta code {
    max-width: 100%;
    overflow: auto;
    border: 1px solid var(--home-border);
    border-radius: 999px;
    background: var(--sl-color-bg-inline-code);
    color: var(--sl-color-gray-1);
    padding: 0.65rem 0.9rem;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  @media (max-width: 58rem) {
    .home-landing {
      gap: 5rem;
      padding-top: 3rem;
    }

    .start-layout,
    .ecosystem-layout {
      grid-template-columns: 1fr;
    }

    .home-hero {
      min-height: min(29rem, calc(100vh - var(--sl-nav-height) - 1rem));
    }

    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stack-logo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .home-landing {
      padding-inline: 1rem;
    }

    h1 {
      font-size: clamp(2.35rem, 12vw, 3.5rem);
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }

    .starter-preview,
    .compact-top {
      align-items: flex-start;
      flex-direction: column;
    }

    .preview-stack {
      justify-content: flex-start;
    }

    .final-cta {
      justify-items: stretch;
      text-align: left;
    }

    .powered-section {
      padding-block: 3rem;
    }

    .stack-logo-grid {
      grid-template-columns: 1fr;
    }

    .stack-logo-card {
      min-height: 6.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button,
    .feature-card,
    .stack-logo-card {
      transition: none;
    }
  }
</style>
