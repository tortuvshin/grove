---
const command = "npx @grove-dev/cli@latest new my-space";

const features = [
  ["File-based records", "Keep knowledge in reviewable YAML and Markdown files."],
  ["GitHub-native workflows", "Use pull requests, issues, history, and ownership."],
  ["Static publishing", "Ship fast, cacheable sites without a backend runtime."],
  ["Search and discovery", "Make directories browsable, filterable, and useful."],
  ["Human review", "Let maintainers approve every community contribution."],
  ["LLM-friendly outputs", "Publish structured outputs built for agents and search."],
  ["Metadata enrichment", "Add health, repository, and taxonomy signals over time."],
  ["Customizable frontend", "Start from a blueprint, then make the space yours."],
];

const steps = [
  ["01", "Create a space", "Scaffold a Grove project with the CLI."],
  ["02", "Add records", "Write structured files for projects, resources, or places."],
  ["03", "Build and publish", "Validate, render, and deploy a static knowledge site."],
];

const blueprints = [
  ["Project Directory", "Available", "Curate projects with health, taxonomy, and contributor signals."],
  ["Resource Hub", "Coming soon / Schema-ready", "Organize guides, tools, references, and learning paths."],
  ["Ecosystem Map", "Coming soon / Schema-ready", "Map people, organizations, projects, and relationships."],
];

const integrations = [
  ["Astro", "A", "Available"],
  ["Next.js", "N", "Coming soon"],
  ["Svelte", "S", "Coming soon"],
];

const tools = [
  "TypeScript",
  "Astro",
  "GitHub Actions",
  "Zod",
  "YAML / Markdown",
  "Static hosting",
  "pnpm",
  "Starlight docs ecosystem",
];
---

<main class="home-landing">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">Grove Framework</p>
      <h1 id="home-title">The framework for community knowledge</h1>
      <p class="lede">
        Grove turns structured files into static, searchable, contributor-friendly knowledge spaces.
      </p>
      <div class="hero-actions" aria-label="Primary actions">
        <a class="button primary" href="/getting-started/create-a-space/">Get Started</a>
        <a class="button secondary" href="https://github.com/tortuvshin/grove">View on GitHub</a>
      </div>
    </div>

    <div class="command-panel" aria-label="Create a new Grove space">
      <div class="window-bar">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <pre><code>{command}</code></pre>
    </div>
  </section>

  <section class="section-block" aria-labelledby="what-is-grove">
    <div class="section-heading">
      <p class="eyebrow">What Is Grove</p>
      <h2 id="what-is-grove">Everything a knowledge community needs to ship.</h2>
    </div>
    <div class="feature-grid">
      {features.map(([title, description]) => (
        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 20 20" role="img">
              <path d="M4 5.5h12M4 10h12M4 14.5h8" />
            </svg>
          </span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section-block start-section" aria-labelledby="seconds">
    <div class="section-heading">
      <p class="eyebrow">Get Started In Seconds</p>
      <h2 id="seconds">Create, run, and publish a Grove space.</h2>
    </div>

    <div class="start-layout">
      <div class="steps">
        {steps.map(([number, title, description]) => (
          <article class="step">
            <span>{number}</span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="code-card">
        <div class="code-tabs" aria-label="Package manager">
          <span>pnpm</span>
          <span>npm</span>
          <span>bun</span>
        </div>
        <pre><code>npx @grove-dev/cli@latest new my-space
cd my-space
pnpm install
pnpm dev</code></pre>
      </div>
    </div>

    <article class="starter-preview" aria-label="Project Directory Starter preview">
      <div>
        <p class="preview-label">Starter preview</p>
        <h3>Project Directory Starter</h3>
        <p>Records, categories, project pages, search metadata, and deploy-ready static output.</p>
      </div>
      <div class="preview-stack" aria-hidden="true">
        <span>projects/</span>
        <span>categories.yaml</span>
        <span>grove.config.ts</span>
      </div>
    </article>
  </section>

  <section class="section-block" aria-labelledby="ecosystem">
    <div class="section-heading">
      <p class="eyebrow">Ecosystem</p>
      <h2 id="ecosystem">Blueprints and framework integrations.</h2>
    </div>

    <div class="ecosystem-layout">
      <div>
        <h3 class="group-title">Blueprints</h3>
        <div class="compact-grid">
          {blueprints.map(([title, status, description]) => (
            <article class="compact-card">
              <div class="compact-top">
                <h4>{title}</h4>
                <span class:list={["status", status === "Available" ? "available" : "soon"]}>
                  {status}
                </span>
              </div>
              <p>{description}</p>
            </article>
          ))}
        </div>
      </div>

      <div>
        <h3 class="group-title">Framework Integrations</h3>
        <div class="integration-list">
          {integrations.map(([name, mark, status]) => (
            <article class="integration-card">
              <span class="logo-mark">{mark}</span>
              <div>
                <h4>{name}</h4>
                <span class:list={["status", status === "Available" ? "available" : "soon"]}>
                  {status}
                </span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="powered-section" aria-labelledby="powered-by">
    <div class="section-heading">
      <p class="eyebrow">Powered By</p>
      <h2 id="powered-by">Built on a foundation of production-grade open tooling</h2>
    </div>
    <div class="tool-grid">
      {tools.map((tool) => <span>{tool}</span>)}
    </div>
  </section>

  <section class="final-cta" aria-labelledby="final-title">
    <p class="eyebrow">Start building with Grove</p>
    <h2 id="final-title">Make your community knowledge reviewable, reusable, and ready to publish.</h2>
    <code>{command}</code>
    <div class="hero-actions">
      <a class="button primary" href="/getting-started/create-a-space/">Get Started</a>
      <a class="button secondary" href="https://github.com/tortuvshin/grove">GitHub</a>
    </div>
  </section>
</main>

<style>
  :global(.hero) {
    display: none;
  }

  :global(.sl-markdown-content) {
    max-width: none;
  }

  :global(.sl-markdown-content > .home-landing:first-child) {
    margin-top: 0;
  }

  .home-landing {
    --home-border: color-mix(in oklab, var(--sl-color-gray-5) 38%, transparent);
    --home-panel: color-mix(in oklab, var(--sl-color-gray-6) 74%, var(--sl-color-black));
    --home-panel-strong: color-mix(in oklab, var(--sl-color-gray-6) 88%, var(--sl-color-black));
    --home-text-soft: var(--sl-color-gray-3);
    --home-green: hsl(153, 68%, 42%);
    --home-amber: hsl(38, 88%, 52%);
    display: flex;
    flex-direction: column;
    gap: 6rem;
    padding: 3rem 1.25rem 5rem;
  }

  .home-hero,
  .section-block,
  .powered-section,
  .final-cta {
    width: min(100%, 72rem);
    margin-inline: auto;
  }

  .home-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
    align-items: center;
    gap: 3rem;
    min-height: min(42rem, calc(100vh - var(--sl-nav-height) - 3rem));
  }

  .hero-copy {
    display: grid;
    gap: 1.35rem;
  }

  .eyebrow {
    color: var(--sl-color-text-accent);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  h4,
  p {
    margin: 0;
  }

  h1 {
    max-width: 13ch;
    color: var(--sl-color-white);
    font-size: clamp(3rem, 9vw, 6.75rem);
    font-weight: 760;
    line-height: 0.96;
    letter-spacing: 0;
  }

  .lede {
    max-width: 42rem;
    color: var(--sl-color-gray-2);
    font-size: 1.18rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.55rem;
    border: 1px solid var(--home-border);
    border-radius: 0.5rem;
    padding: 0.65rem 1rem;
    font-size: 0.94rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button.primary {
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    border-color: var(--sl-color-white);
  }

  .button.secondary {
    background: var(--home-panel);
    color: var(--sl-color-white);
  }

  .command-panel,
  .code-card,
  .starter-preview,
  .compact-card,
  .integration-card,
  .feature-card {
    border: 1px solid var(--home-border);
    border-radius: 0.5rem;
    background: var(--home-panel);
    box-shadow: 0 22px 80px color-mix(in oklab, var(--sl-color-black) 45%, transparent);
  }

  .command-panel {
    overflow: hidden;
  }

  .window-bar {
    display: flex;
    gap: 0.45rem;
    border-bottom: 1px solid var(--home-border);
    padding: 0.8rem 1rem;
  }

  .window-bar span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: var(--sl-color-gray-4);
  }

  pre {
    overflow: auto;
    margin: 0;
    padding: 1.1rem;
    color: var(--sl-color-gray-1);
    font-size: 0.9rem;
    line-height: 1.75;
  }

  code {
    font-family: var(--sl-font-system-mono);
  }

  .section-block,
  .powered-section {
    display: grid;
    gap: 1.5rem;
  }

  .section-heading {
    display: grid;
    gap: 0.55rem;
    max-width: 45rem;
  }

  h2 {
    color: var(--sl-color-white);
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .feature-card {
    display: grid;
    gap: 0.7rem;
    min-height: 12rem;
    padding: 1rem;
  }

  .feature-icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    background: color-mix(in oklab, var(--sl-color-accent) 18%, transparent);
    color: var(--sl-color-text-accent);
  }

  .feature-icon svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  h3,
  h4 {
    color: var(--sl-color-white);
    font-size: 1rem;
    line-height: 1.25;
    letter-spacing: 0;
  }

  .feature-card p,
  .step p,
  .compact-card p,
  .starter-preview p {
    color: var(--home-text-soft);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .start-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(20rem, 1.2fr);
    gap: 1rem;
  }

  .steps {
    display: grid;
    gap: 0.75rem;
  }

  .step {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
    padding: 1rem 0;
    border-bottom: 1px solid var(--home-border);
  }

  .step span {
    color: var(--sl-color-text-accent);
    font-family: var(--sl-font-system-mono);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .code-card {
    overflow: hidden;
    background: var(--home-panel-strong);
  }

  .code-tabs {
    display: flex;
    gap: 0.45rem;
    border-bottom: 1px solid var(--home-border);
    padding: 0.7rem;
  }

  .code-tabs span {
    border-radius: 999px;
    padding: 0.32rem 0.65rem;
    color: var(--home-text-soft);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .code-tabs span:first-child {
    background: var(--sl-color-white);
    color: var(--sl-color-black);
  }

  .starter-preview {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
  }

  .preview-label {
    color: var(--sl-color-text-accent);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .preview-stack {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .preview-stack span,
  .tool-grid span {
    border: 1px solid var(--home-border);
    border-radius: 999px;
    background: color-mix(in oklab, var(--sl-color-gray-6) 56%, transparent);
    color: var(--sl-color-gray-2);
    padding: 0.45rem 0.7rem;
    font-size: 0.82rem;
    font-weight: 650;
  }

  .ecosystem-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: 1.25rem;
  }

  .group-title {
    margin-bottom: 0.75rem;
  }

  .compact-grid,
  .integration-list {
    display: grid;
    gap: 0.75rem;
  }

  .compact-card,
  .integration-card {
    padding: 1rem;
  }

  .compact-top {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .status {
    flex: 0 0 auto;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.22rem 0.5rem;
    font-size: 0.68rem;
    font-weight: 800;
    line-height: 1;
  }

  .status.available {
    color: var(--home-green);
  }

  .status.soon {
    color: var(--home-amber);
  }

  .integration-card {
    display: flex;
    gap: 0.8rem;
    align-items: center;
  }

  .logo-mark {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.5rem;
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    font-size: 1.1rem;
    font-weight: 850;
  }

  .powered-section {
    border-top: 1px solid var(--home-border);
    border-bottom: 1px solid var(--home-border);
    padding-block: 3rem;
  }

  .tool-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .final-cta {
    display: grid;
    justify-items: center;
    gap: 1rem;
    border: 1px solid var(--home-border);
    border-radius: 0.5rem;
    background: var(--home-panel-strong);
    padding: clamp(2rem, 6vw, 4rem);
    text-align: center;
  }

  .final-cta h2 {
    max-width: 16ch;
  }

  .final-cta code {
    max-width: 100%;
    overflow: auto;
    border: 1px solid var(--home-border);
    border-radius: 999px;
    background: var(--sl-color-bg-inline-code);
    color: var(--sl-color-gray-1);
    padding: 0.65rem 0.9rem;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  @media (max-width: 58rem) {
    .home-landing {
      gap: 4.25rem;
      padding-top: 2rem;
    }

    .home-hero,
    .start-layout,
    .ecosystem-layout {
      grid-template-columns: 1fr;
    }

    .home-hero {
      min-height: auto;
    }

    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .home-landing {
      padding-inline: 1rem;
    }

    h1 {
      font-size: clamp(2.65rem, 17vw, 4.3rem);
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }

    .starter-preview,
    .compact-top {
      align-items: flex-start;
      flex-direction: column;
    }

    .preview-stack {
      justify-content: flex-start;
    }

    .final-cta {
      justify-items: stretch;
      text-align: left;
    }
  }
</style>
