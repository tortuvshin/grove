---
import '../styles/home.css';
import { GA_INLINE, GA_SRC } from '../data/analytics.mjs';
import { FAQ_ITEMS } from '../data/faq.ts';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Grove — Publish structured knowledge that stays current',
  description = 'Grove is an open-source framework for publishing structured knowledge from files: keep records and Markdown in Git, and Grove builds a fast, searchable static site plus the sitemap, README, and llms.txt outputs around it — with collections, saved views, scheduled metadata refresh, and a review workflow.',
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://withgrove.dev';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
// Raster social card — platforms do not render SVG og:images. Generated
// from public/og-image.svg by scripts/generate-social-assets.mjs.
const ogImageUrl = new URL('/og-image.png', siteUrl).toString();
// schema.org `Organization.logo` expects a square (1:1) raster image of at
// least 112×112px; /logo.png (512×512) is generated by the same script.
const squareLogoUrl = new URL('/logo.png', siteUrl).toString();

/**
 * JSON-LD for the standalone home page. Emits four schemas:
 *
 *  - WebSite: identifies the site and its publisher.
 *  - SoftwareApplication: describes Grove itself (a CLI + framework),
 *    so search engines can render rich "app" results.
 *  - Organization: identifies the project and its canonical repo.
 *  - FAQPage: structured-data mirror of the visible FAQ section so
 *    search engines can surface Q&A results.
 *
 * The FAQ copy is sourced from `../data/faq.ts` and is shared with
 * `<Faq>` so the visible UI and the structured data cannot drift.
 */
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Grove',
  url: siteUrl,
  description,
  inLanguage: 'en',
  publisher: {
    '@type': 'Organization',
    name: 'Grove',
    url: 'https://github.com/tortuvshin/grove',
  },
};

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Grove',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  description:
    'Open-source framework for publishing structured knowledge from files into a site and its machine-readable outputs, and keeping them in sync. Includes a CLI, a headless core, an Astro renderer, and a Starlight theme.',
  url: siteUrl,
  downloadUrl: 'https://www.npmjs.com/package/@grove-dev/cli',
  // Tracks the published package version (packages/*/package.json), which
  // is what a reader can actually install. Claiming a "1.0.0-preview" here
  // while npm serves 0.9.x is a version the project does not have.
  // release-please rewrites this line on release; keep the annotation.
  softwareVersion: '0.9.0', // x-release-please-version
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Organization',
    name: 'Grove',
    url: 'https://github.com/tortuvshin/grove',
  },
  license: 'https://opensource.org/licenses/MIT',
  keywords:
    'knowledge base, community, directory, awesome-list, github-native, static site, astro, open source, llm-friendly, blueprint, records',
};

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Grove',
  url: 'https://github.com/tortuvshin/grove',
  logo: squareLogoUrl,
  description:
    'Open-source framework for community knowledge — collect, structure, maintain, and publish the projects, tools, resources, and knowledge a community relies on.',
  sameAs: ['https://github.com/tortuvshin/grove', 'https://www.npmjs.com/org/grove-dev'],
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_ITEMS.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<!doctype html>
<html lang="en" class="bg-bg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#091116" />
    <meta name="color-scheme" content="dark light" />
    <meta name="generator" content={Astro.generator} />

    <script is:inline async src={GA_SRC}></script>
    <script is:inline set:html={GA_INLINE} />

    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable docs index" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Grove" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Grove social card: the headline &quot;Publish knowledge that stays current&quot; over the install command" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Grove social card: the headline &quot;Publish knowledge that stays current&quot; over the install command" />

    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-bg text-fg antialiased">
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <slot />
    <script is:inline>
      (() => {
        // Scroll reveal, progressive enhancement only: sections are tagged
        // .reveal-init here (never in markup) so nothing hides without JS.
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) return;
        const targets = document.querySelectorAll('main > section, footer');
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('reveal-in');
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.08 },
        );
        for (const target of targets) {
          target.classList.add('reveal-init');
          observer.observe(target);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  .skip-to-content {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.5rem 0.875rem;
    background: var(--color-bg, #091116);
    color: var(--color-fg, #e3f3f5);
    border: 1px solid var(--color-border-strong, #365666);
    border-radius: var(--radius-md, 0.5rem);
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform 0.18s ease;
  }

  .skip-to-content:focus,
  .skip-to-content:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--color-brand, #27b7c8);
    outline-offset: 2px;
  }

  main {
    scroll-margin-top: 5rem;
  }
</style>
