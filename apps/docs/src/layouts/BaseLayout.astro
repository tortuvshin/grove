---
/**
 * Base layout for the custom Astro pages (landing + showcase hub).
 *
 * Mirrors Starlight's <Page> + <PageFrame> layout: sticky header at the
 * top, fixed-position sidebar on the left (≥50rem), main content column
 * in the center, optional table-of-contents rail on the right, and a
 * sticky footer at the bottom. This is the same chrome the docs site
 * renders, just driven by our custom slot content.
 *
 * All colors / fonts / spacing come from Starlight's --sl-* tokens
 * (mirrored in global.css) so the layout is visually identical to the
 * /tutorials/*, /guides/*, and /reference/* pages.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
    description?: string;
    ogImage?: string;
    activeNav?: 'home' | 'showcase' | 'docs' | 'github';
    /** Optional table of contents items. Omit / pass `[]` to hide the rail. */
    toc?: { depth: number; slug: string; text: string }[];
    /** Current pathname, used to mark the active sidebar item. */
    currentPath?: string;
    /** Optional breadcrumbs rendered above the page title. */
    breadcrumbs?: { label: string; href?: string }[];
}

const {
    title,
    description = 'Grove is an open-source framework for growing useful community knowledge — collect, structure, maintain, and improve the projects, tools, resources, and knowledge a community relies on.',
    ogImage = '/og-image.svg',
    activeNav = 'home',
    toc = [],
    currentPath = '/',
    breadcrumbs = [],
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://withgrove.dev';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(ogImage, siteUrl).toString();

/**
 * JSON-LD WebSite schema — emitted on every page so search engines
 * understand the site's identity, primary entry point, and search
 * behaviour (via the internal Pagefind index).
 */
const websiteJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Grove',
    url: siteUrl,
    description:
        'Grove is an open-source framework for growing useful community knowledge — collect, structure, maintain, and improve the projects, tools, resources, and knowledge a community relies on.',
    publisher: {
        '@type': 'Organization',
        name: 'Grove',
        url: 'https://github.com/tortuvshin/grove',
    },
    inLanguage: 'en',
    potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}/search?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
    },
};
---

<!doctype html>
<html lang="en" dir="ltr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" href="/og-image.svg" />
        <link rel="manifest" href="/manifest.json" />
        <meta name="theme-color" content="#08090a" />
        <meta name="color-scheme" content="dark light" />
        <meta name="generator" content={Astro.generator} />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content="Grove" />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Grove — The framework for community knowledge" />
        <meta property="og:locale" content="en_US" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content="Grove — The framework for community knowledge" />

        <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
        />

        <script is:inline>
            // Identical to Starlight's ThemeProvider.astro so the custom
            // pages share the same theme key (`starlight-theme`) and pick
            // up the system / user preference on first paint.
            window.StarlightThemeProvider = (() => {
                const storedTheme =
                    typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
                const theme =
                    storedTheme ||
                    (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
                document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
                return {
                    updatePickers(theme = storedTheme || 'auto') {
                        document.querySelectorAll('starlight-theme-select').forEach((picker) => {
                            const select = picker.querySelector('select');
                            if (select) select.value = theme;
                        });
                    },
                };
            })();
        </script>
    </head>
    <body>
        <a href="#main" class="skip-to-content">Skip to content</a>
        <Header activeNav={activeNav} />

        <div class="page-frame">
            <Sidebar currentPath={currentPath} />

            <main id="main" class="main-pane">
                {
                    breadcrumbs.length > 0 && (
                        <nav class="breadcrumbs" aria-label="Breadcrumb">
                            <ol>
                                {breadcrumbs.map((b, i) => (
                                    <li>
                                        {b.href ? <a href={b.href}>{b.label}</a> : <span>{b.label}</span>}
                                        {i < breadcrumbs.length - 1 && (
                                            <span class="sep" aria-hidden="true">
                                                /
                                            </span>
                                        )}
                                    </li>
                                ))}
                            </ol>
                        </nav>
                    )
                }

                <article class="content">
                    <slot />
                </article>

                <Footer />
            </main>

            {
                toc.length > 0 && (
                    <aside class="toc-pane" aria-label="Table of contents">
                        <nav>
                            <h2 id="starlight__on-this-page">On this page</h2>
                            <ul>
                                {toc.map((entry) => (
                                    <li class={`depth-${entry.depth}`}>
                                        <a href={`#${entry.slug}`}>{entry.text}</a>
                                    </li>
                                ))}
                            </ul>
                        </nav>
                    </aside>
                )
            }
        </div>
    </body>
</html>

<style is:global>
    :root {
        --g-container: var(--sl-content-width);
        --g-container-wide: 72rem;
        --g-container-narrow: 35rem;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
    }

    body {
        font-family: var(--sl-font-system);
        background: var(--sl-color-bg);
        color: var(--sl-color-text);
        line-height: var(--sl-line-height);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    h1,
    h2,
    h3,
    h4 {
        margin: 0;
        font-weight: 700;
        letter-spacing: -0.015em;
        line-height: var(--sl-line-height-headings);
    }

    p {
        margin: 0;
    }

    code,
    pre {
        font-family: var(--sl-font-system-mono);
    }

    /* `img, svg { display: block }` and `max-width: 100%` are already
     * declared by Starlight's reset.css and markdown.css (inside
     * `@layer starlight.reset` / `starlight.components`). Declaring them
     * globally in this layout puts them outside any cascade layer, which
     * gives them higher priority than Starlight's `[data-theme="light"]
     * .light\:sl-hidden { display: none }` utility — and silently breaks
     * the dual-logo dark/light swap in the site header. Keep the layout
     * override free of `display` / `max-width` on `img, svg` so the
     * Starlight utility can win. */

    .g-container {
        max-width: var(--g-container);
        margin-inline: auto;
        padding-inline: 1.5rem;
    }

    .g-container-wide {
        max-width: var(--g-container-wide);
    }

    .g-container-narrow {
        max-width: var(--g-container-narrow);
        margin-inline: auto;
        padding-inline: 1.5rem;
    }
</style>

<style>
    .page-frame {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
        max-width: var(--g-container-wide);
        margin-inline: auto;
        padding-block: 1.5rem;
    }

    @media (min-width: 50rem) {
        .page-frame {
            grid-template-columns: var(--sl-sidebar-width) minmax(0, 1fr) var(--sl-sidebar-width);
        }
    }

    .main-pane {
        min-width: 0;
        padding: 1.5rem 1.5rem 3rem;
    }

    @media (min-width: 50rem) {
        .main-pane {
            padding: 1.5rem 2rem 3rem;
        }
    }

    .content {
        max-width: var(--sl-content-width);
    }

    .breadcrumbs {
        margin-bottom: 1.5rem;
        color: var(--sl-color-gray-3);
        font-size: var(--sl-text-sm);
    }

    .breadcrumbs ol {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .breadcrumbs li {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }

    .breadcrumbs a {
        color: var(--sl-color-gray-2);
    }

    .breadcrumbs a:hover {
        color: var(--sl-color-text-accent);
    }

    .breadcrumbs .sep {
        color: var(--sl-color-gray-4);
    }

    .skip-to-content {
        position: absolute;
        top: 0.5rem;
        left: 0.5rem;
        z-index: var(--sl-z-index-navbar, 1000);
        padding: 0.5rem 0.75rem;
        background: var(--sl-color-bg-accent, #1e2024);
        color: var(--sl-color-white, #ffffff);
        border: 1px solid var(--sl-color-hairline-light, #2a2d31);
        border-radius: var(--sl-border-radius, 0.5rem);
        font-size: var(--sl-text-sm, 0.875rem);
        font-weight: 600;
        text-decoration: none;
        transform: translateY(-200%);
        transition: transform 0.2s ease;
    }

    .skip-to-content:focus,
    .skip-to-content:focus-visible {
        transform: translateY(0);
        outline: 2px solid var(--sl-color-text-accent, #60a5fa);
        outline-offset: 2px;
    }

    .toc-pane {
        display: none;
    }

    @media (min-width: 72rem) {
        .toc-pane {
            display: block;
            padding: 1.5rem 1.5rem 3rem 0;
        }
    }

    .toc-pane h2 {
        font-size: var(--sl-text-sm);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--sl-color-gray-3);
        margin-bottom: 0.75rem;
    }

    .toc-pane ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .toc-pane li.depth-3 {
        padding-inline-start: 1rem;
    }

    .toc-pane li.depth-4 {
        padding-inline-start: 2rem;
    }

    .toc-pane a {
        display: block;
        padding: 0.25rem 0;
        color: var(--sl-color-gray-3);
        font-size: var(--sl-text-sm);
        line-height: 1.4;
    }

    .toc-pane a:hover {
        color: var(--sl-color-text-accent);
    }
</style>
