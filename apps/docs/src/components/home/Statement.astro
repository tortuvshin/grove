---
// Big centered section statement — the separator between feature groups.
// The title comes through the slot so callers can wrap a phrase in
// .text-gradient.
interface Props {
  eyebrow: string;
  titleId: string;
  lede?: string;
}

const { eyebrow, titleId, lede } = Astro.props;
---

<header class="mx-auto max-w-3xl px-6 pb-12 pt-20 text-center sm:pt-24">
  <p class="text-xs font-semibold uppercase tracking-widest text-subtle">{eyebrow}</p>
  <h2
    id={titleId}
    class="mt-5 text-balance text-4xl font-bold leading-[1.1] tracking-tight text-fg sm:text-5xl"
  >
    <slot />
  </h2>
  {
    lede && (
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">{lede}</p>
    )
  }
</header>
