---
import SectionHeader from './SectionHeader.astro';

const outputs = [
  { label: 'Website', note: 'Static pages', class: 'left-1/2 top-0 -translate-x-1/2', color: 'text-accent-cyan' },
  { label: 'Search', note: 'sitemap.xml', class: 'left-[3%] top-[42%]', color: 'text-accent-green' },
  { label: 'AI', note: 'llms.txt', class: 'right-[3%] top-[42%]', color: 'text-accent-orange' },
  { label: 'Tools', note: 'records.json', class: 'bottom-0 left-1/2 -translate-x-1/2', color: 'text-accent-blue' },
];
---

<section class="relative overflow-hidden border-y border-border/60" aria-labelledby="integrations-title">
  <div class="stars pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-7xl gap-12 px-6 py-24 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:gap-20">
    <div>
      <SectionHeader
        eyebrow="One source, multiple outputs"
        title="Maintain one record. Serve people and machines."
        titleId="integrations-title"
        lede="Grove generates a website for people, crawlable pages and a sitemap for search engines, structured JSON for other tools, and predictable context files for AI systems."
        maxWidth="narrow"
      />
      <p class="mt-5 max-w-xl text-sm leading-relaxed text-subtle">
        It does not promise rankings or AI visibility. It produces stable, inspectable formats from the same reviewed source.
      </p>
      <ul class="mt-7 flex flex-wrap gap-2 font-mono text-[11px] text-muted" aria-label="Generated formats">
        <li class="rounded-md border border-border bg-card px-3 py-2">static HTML</li>
        <li class="rounded-md border border-border bg-card px-3 py-2">sitemap.xml</li>
        <li class="rounded-md border border-border bg-card px-3 py-2">llms.txt</li>
        <li class="rounded-md border border-border bg-card px-3 py-2">llms-full.txt</li>
      </ul>
    </div>

    <div class="relative mx-auto aspect-square w-full max-w-lg" aria-label="One YAML record generating four portable outputs">
      <div class="orbit-ring orbit-ring--fast absolute left-1/2 top-1/2 size-[54%] rounded-full border border-dashed border-accent-green/25"></div>
      <div class="orbit-ring orbit-ring--medium absolute left-1/2 top-1/2 size-[82%] rounded-full border border-dashed border-accent-green/[0.14]"></div>
      <div class="orbit-ring orbit-ring--slow absolute left-1/2 top-1/2 size-full rounded-full border border-dashed border-accent-green/[0.08]"></div>

      <div class="orbit-center absolute left-1/2 top-1/2 z-10 w-48 rounded-xl border border-accent-green/30 bg-surface p-4 shadow-[0_0_50px_-12px_oklch(78%_0.19_152_/_0.5)]">
        <p class="font-mono text-[10px] text-accent-green">record.yml</p>
        <div class="mt-3 space-y-1.5 font-mono text-[10px] text-muted"><p><span class="text-accent-green">name:</span> Immich</p><p><span class="text-accent-green">kind:</span> project</p><p><span class="text-accent-green">category:</span> media</p></div>
      </div>

      {outputs.map((output) => (
        <div class={`absolute z-10 ${output.class}`}>
          <div class="min-w-28 rounded-xl border border-border-strong bg-surface/95 px-4 py-3 text-center backdrop-blur">
            <p class={`text-sm font-semibold ${output.color}`}>{output.label}</p>
            <p class="mt-1 font-mono text-[10px] text-subtle">{output.note}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Rings and the center node carry their centering translate inside the
     animation so the rotation/float doesn't undo the -50% offsets. */
  .orbit-ring,
  .orbit-center {
    transform: translate(-50%, -50%);
  }

  .orbit-ring {
    animation: orbit-spin 80s linear infinite;
  }

  .orbit-ring--fast { animation-duration: 50s; }
  .orbit-ring--medium { animation-duration: 90s; animation-direction: reverse; }
  .orbit-ring--slow { animation-duration: 140s; }

  @keyframes orbit-spin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .orbit-center {
    animation: orbit-float 7s ease-in-out infinite alternate;
  }

  @keyframes orbit-float {
    from { transform: translate(-50%, -51.5%); }
    to { transform: translate(-50%, -48.5%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-ring,
    .orbit-center {
      animation: none;
      transform: translate(-50%, -50%);
    }
  }

  .stars {
    background-image:
      radial-gradient(1px 1px at 20% 30%, rgba(255, 255, 255, 0.5) 50%, transparent),
      radial-gradient(1px 1px at 75% 20%, rgba(255, 255, 255, 0.4) 50%, transparent),
      radial-gradient(1px 1px at 40% 70%, rgba(255, 255, 255, 0.35) 50%, transparent),
      radial-gradient(1px 1px at 85% 65%, rgba(255, 255, 255, 0.45) 50%, transparent),
      radial-gradient(1px 1px at 10% 80%, rgba(255, 255, 255, 0.3) 50%, transparent);
    background-repeat: no-repeat;
  }
</style>
