---
import Statement from './Statement.astro';

// "How Grove works" — a scroll-driven story ported from the transformation
// concept: one pinned canvas morphs terminal → file tree → discovery model →
// live website while a six-step nav tracks progress. On mobile, without JS,
// or with reduced motion the section renders statically: step cards followed
// by the live demo window, so no content ever depends on the animation.

const steps = [
  {
    label: 'Initialize',
    heading: 'Start with one command.',
    copy: 'grove init scaffolds a complete space — records, collections, taxonomy, and config included.',
  },
  {
    label: 'Add content',
    heading: 'Your content is just files.',
    copy: 'YAML records for data, Markdown for rich pages, collections for curation. No database, no CMS.',
  },
  {
    label: 'Structure',
    heading: 'Files become a connected system.',
    copy: 'Grove links records, content, taxonomy, and collections into one consistent discovery model.',
  },
  {
    label: 'Publish',
    heading: 'A real website appears.',
    copy: 'A fast, searchable directory with lenses, filters, and rich detail pages. The window here is live — try it.',
  },
  {
    label: 'Generate',
    heading: 'The site is only one output.',
    copy: 'Grove also writes the README, sitemap, robots.txt, and AI-readable files like llms.txt.',
  },
  {
    label: 'Maintain',
    heading: 'Your collection changes. Grove keeps up.',
    copy: 'Sync refreshes metadata and flags stale records — 183 days without a release earns a review.',
  },
];

// Scene 2 file tree mirrors what `grove init` actually scaffolds
// (packages/cli/src/init.ts copies apps/example: data/records, collections,
// taxonomy, content/records, grove.config.ts). `at` is the scroll progress
// where each row reveals.
const tree = [
  { depth: 0, label: 'my-space/', kind: 'folder', at: 0.13 },
  { depth: 1, label: 'data/', kind: 'folder', at: 0.15 },
  { depth: 2, label: 'records/', kind: 'folder', at: 0.165 },
  { depth: 3, label: 'immich.yml', kind: 'yml', at: 0.18 },
  { depth: 3, label: 'joplin.yml', kind: 'yml', at: 0.195 },
  { depth: 3, label: 'excalidraw.yml', kind: 'yml', at: 0.21 },
  { depth: 2, label: 'collections/', kind: 'folder', at: 0.225 },
  { depth: 3, label: 'starter-picks.yml', kind: 'yml', at: 0.24 },
  { depth: 2, label: 'taxonomy/', kind: 'folder', at: 0.255 },
  { depth: 3, label: 'categories.yml', kind: 'yml', at: 0.27 },
  { depth: 1, label: 'content/records/', kind: 'folder', at: 0.285 },
  { depth: 2, label: 'immich.md', kind: 'md', at: 0.3 },
  { depth: 0, label: 'grove.config.ts', kind: 'ts', at: 0.315 },
];

const treeColor = {
  folder: 'text-brand-light',
  yml: 'text-accent-cyan',
  md: 'text-muted',
  ts: 'text-accent-yellow',
};

// Scene 3 flow: the real inputs and the shipped discovery capabilities.
const inputs = [
  { label: 'YAML records', x: 15, y: 24 },
  { label: 'Markdown', x: 15, y: 42 },
  { label: 'Collections', x: 15, y: 60 },
  { label: 'Taxonomy', x: 15, y: 78 },
];
const caps = [
  { label: 'Search', x: 85, y: 20 },
  { label: 'Filters', x: 85, y: 35 },
  { label: 'Lenses', x: 85, y: 50 },
  { label: 'Collections', x: 85, y: 65 },
  { label: 'Detail pages', x: 85, y: 80 },
];

// The live demo mirrors the real directory layer. Lens labels and the URL
// params each tab writes come from packages/core/src/directory-lenses.ts
// (`PRIMARY_LENSES` + `toParams()`): Trending → ?label=hot, Established →
// ?label=mature, the curator-assigned pair → ?lens=....
const lenses = [
  { id: 'all', label: 'All items', param: '' },
  { id: 'hot', label: 'Trending', param: 'label=hot' },
  { id: 'mature', label: 'Established', param: 'label=mature' },
  { id: 'production-like', label: 'Production-like', param: 'lens=production-like' },
  { id: 'good-to-learn', label: 'Good to learn', param: 'lens=good-to-learn' },
];

// Sample records — real open-source projects, shown with category/stack only
// (no live figures that could drift).
const records = [
  { name: 'Immich', category: 'Media', stack: 'TypeScript', lenses: 'hot production-like' },
  { name: 'Joplin', category: 'Productivity', stack: 'TypeScript', lenses: 'mature production-like' },
  { name: 'Excalidraw', category: 'Design', stack: 'TypeScript', lenses: 'hot mature production-like' },
  { name: 'Bruno', category: 'DevTools', stack: 'JavaScript', lenses: 'good-to-learn' },
  { name: 'LocalSend', category: 'Sharing', stack: 'Flutter', lenses: 'hot good-to-learn' },
  { name: 'Linkwarden', category: 'Knowledge', stack: 'Next.js', lenses: 'production-like' },
  { name: 'Outline', category: 'Knowledge', stack: 'React', lenses: 'mature production-like' },
];

// Scene 5 rail: files grove actually generates (packages/cli/src/init.ts
// GENERATED_PUBLIC_NAMES + the README command).
const outputs = [
  { file: 'README.md', tag: 'Docs' },
  { file: 'sitemap.xml', tag: 'SEO' },
  { file: 'robots.txt', tag: 'Crawlers' },
  { file: 'llms.txt', tag: 'AI index' },
  { file: 'llms-full.txt', tag: 'AI full text' },
  { file: 'og-image.svg', tag: 'Social' },
];

// Scene 6 health rows — statuses use the real 183-day staleness threshold.
const health = [
  { name: 'immich', meta: 'Release 3 days ago', status: 'synced', pill: 'Synced' },
  { name: 'old-dashboard', meta: 'No release in 183+ days', status: 'review', pill: 'Needs review' },
  { name: 'legacy-tool', meta: 'Repository archived', status: 'archived', pill: 'Archived' },
];

const pillClass = {
  synced: 'border-accent-green/40 bg-accent-green/10 text-accent-green',
  review: 'border-accent-orange/40 bg-accent-orange/10 text-accent-orange',
  archived: 'border-border-strong bg-surface text-muted',
};
---

<section id="demo" aria-labelledby="demo-title">
  <Statement
    eyebrow="How Grove works"
    titleId="demo-title"
    lede="Start from a folder of YAML and Markdown, and Grove grows it into a searchable site with curated collections, machine-readable outputs, and maintenance built in. The directory window is live — search it, switch lenses."
  >
    From files to a <span class="text-gradient">living directory.</span>
  </Statement>

  <div id="hgw" class="hgw">
    <div class="hgw-sticky">
      <div class="hgw-wrap">
        <!-- Canvas: four stacked scenes; 1–3 only exist in scrub mode. -->
        <div id="hgw-canvas" class="hgw-canvas relative">
          <!-- Scrub-mode caption: identifies the active step above the canvas. -->
          <div
            id="hgw-caption"
            class="absolute left-1/2 top-4 z-10 -translate-x-1/2 whitespace-nowrap rounded-full border border-border bg-card/80 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-widest text-subtle backdrop-blur"
            aria-hidden="true"
          >
            <span id="hgw-caption-index">Step 01</span>
            <span class="mx-2 text-border-strong">/</span>
            <span id="hgw-caption-label" class="text-brand-light">Initialize</span>
          </div>

          <!-- Continuous progress bar (scrub mode only). Gives a smooth sense
               of overall progress across all six steps without snapping. -->
          <div
            id="hgw-progress"
            class="absolute inset-x-0 top-0 z-10 h-0.5 overflow-hidden bg-border/40"
            aria-hidden="true"
          >
            <div
              id="hgw-progress-fill"
              class="h-full w-0 bg-brand"
              style="transform-origin: left center; will-change: width;"
            ></div>
          </div>

          <div class="hgw-gridbg" aria-hidden="true"></div>

          <!-- Scene 1 · Initialize: terminal types `grove init my-space` -->
          <div id="hgw-terminal" class="hgw-scene" aria-hidden="true">
            <div class="w-full max-w-md overflow-hidden rounded-xl border border-border bg-surface shadow-2xl shadow-black/40">
              <div class="flex items-center gap-2 border-b border-border px-4 py-3">
                <span class="size-3 rounded-full bg-[#ff5f57]"></span>
                <span class="size-3 rounded-full bg-[#febc2e]"></span>
                <span class="size-3 rounded-full bg-[#28c840]"></span>
                <span class="ml-2 font-mono text-xs text-subtle">~/projects</span>
              </div>
              <div class="space-y-2.5 p-5 font-mono text-sm leading-relaxed">
                <div class="flex items-center">
                  <span class="mr-2 text-brand-light">$</span>
                  <span id="hgw-typed" class="text-fg"></span>
                  <span id="hgw-cursor" class="ml-0.5 inline-block h-4 w-2 animate-pulse bg-brand align-middle"></span>
                </div>
                <div id="hgw-term-line1" class="text-muted">Creating your Grove space…</div>
                <div id="hgw-term-line2" class="text-accent-green">✓ Project ready</div>
              </div>
            </div>
          </div>

          <!-- Scene 2 · Add content: the real `grove init` file tree reveals -->
          <div id="hgw-files" class="hgw-scene" aria-hidden="true">
            <div class="w-full max-w-md overflow-hidden rounded-xl border border-border bg-card shadow-2xl shadow-black/40">
              <div class="flex items-center gap-2 border-b border-border bg-surface px-4 py-3">
                <svg class="size-4 text-brand-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                <span class="font-mono text-xs text-subtle">Explorer</span>
              </div>
              <div class="p-4 font-mono text-[13px]">
                {tree.map((node) => (
                  <div class="flex items-center gap-2 py-[3px]" data-at={node.at} style={`padding-left: ${node.depth * 16}px`}>
                    {node.kind === 'folder' ? (
                      <svg class:list={['size-4 shrink-0', treeColor[node.kind]]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                    ) : (
                      <svg class:list={['size-4 shrink-0', treeColor[node.kind]]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><path d="M14 2v6h6"></path></svg>
                    )}
                    <span class={node.kind === 'folder' ? 'text-fg' : 'text-muted'}>{node.label}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Scene 3 · Structure: inputs flow through Grove to capabilities -->
          <div id="hgw-system" class="hgw-scene" aria-hidden="true">
            <div id="hgw-system-stage" class="relative aspect-[4/3] w-full max-w-2xl">
              <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 75" fill="none" preserveAspectRatio="none" aria-hidden="true">
                {inputs.map((n) => (
                  <path
                    class="hgw-in-path"
                    d={`M ${n.x + 9} ${n.y * 0.75} C 34 ${n.y * 0.75}, 38 37.5, 46 37.5`}
                    stroke="#3f3f46"
                    stroke-width="1"
                    vector-effect="non-scaling-stroke"
                    pathLength="1"
                    stroke-dasharray="1"
                    stroke-dashoffset="1"
                    opacity="0.8"
                  ></path>
                ))}
                {caps.map((n) => (
                  <path
                    class="hgw-cap-path"
                    d={`M 54 37.5 C 62 37.5, 66 ${n.y * 0.75}, ${n.x - 11} ${n.y * 0.75}`}
                    stroke="#646cff"
                    stroke-width="1"
                    vector-effect="non-scaling-stroke"
                    pathLength="1"
                    stroke-dasharray="1"
                    stroke-dashoffset="1"
                    opacity="0.5"
                  ></path>
                ))}
              </svg>

              {inputs.map((n, i) => (
                <span
                  class="hgw-chip absolute whitespace-nowrap rounded-lg border border-border bg-card px-3 py-1.5 font-mono text-xs text-fg"
                  data-chip="in"
                  data-i={i}
                  style={`left: ${n.x}%; top: ${n.y}%;`}
                >
                  {n.label}
                </span>
              ))}

              <div id="hgw-core" class="absolute" style="left: 50%; top: 50%;">
                <div class="flex flex-col items-center gap-1 rounded-2xl border border-brand/40 bg-brand/10 px-7 py-5 shadow-[0_0_40px_-8px_rgb(100_108_255/0.9)] backdrop-blur-sm">
                  <span class="text-2xl font-semibold tracking-tight text-brand-light">Grove</span>
                  <span class="font-mono text-[10px] uppercase tracking-widest text-subtle">discovery model</span>
                </div>
              </div>

              {caps.map((n, i) => (
                <span
                  class="hgw-chip absolute whitespace-nowrap rounded-lg border border-brand/30 bg-brand/10 px-3 py-1.5 text-xs font-medium text-brand-light"
                  data-chip="cap"
                  data-i={i}
                  style={`left: ${n.x}%; top: ${n.y}%;`}
                >
                  {n.label}
                </span>
              ))}

              <!-- Output path leaving the discovery model toward the live site -->
              <svg
                class="pointer-events-none absolute inset-0 h-full w-full"
                viewBox="0 0 100 75"
                fill="none"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <path
                  id="hgw-out-path"
                  d="M 58 37.5 C 70 37.5, 80 50, 92 60"
                  stroke="#646cff"
                  stroke-width="1.2"
                  vector-effect="non-scaling-stroke"
                  pathLength="1"
                  stroke-dasharray="1"
                  stroke-dashoffset="1"
                  opacity="0.7"
                ></path>
                <polygon
                  id="hgw-out-arrow"
                  points="0,-3 6,0 0,3"
                  fill="#646cff"
                  opacity="0"
                  transform="translate(92 60)"
                ></polygon>
              </svg>
            </div>
          </div>

          <!-- Scene 3 → 4 bridge: a chip that fades in to lead into the live site -->
          <div
            id="hgw-bridge"
            class="hgw-scene pointer-events-none flex items-center justify-center"
            aria-hidden="true"
          >
            <span class="rounded-full border border-brand/30 bg-card/80 px-3.5 py-1.5 font-mono text-[11px] uppercase tracking-widest text-brand-light backdrop-blur">
              grove build →
            </span>
          </div>

          <!-- Scenes 4–6 · Publish / Generate / Maintain: the live demo window
               plus the generated-outputs rail and the collection-health panel. -->
          <div id="hgw-site">
            <div id="hgw-site-inner" class="relative">
              <div id="demo-directory" class="relative">
                <div class="grove-glow" aria-hidden="true"></div>
                <div id="hgw-window" class="overflow-hidden rounded-2xl border border-border-strong bg-bg/95 shadow-[0_40px_100px_-30px_rgb(100_108_255_/_0.35)] backdrop-blur">
                  <div class="flex items-center gap-2 border-b border-border px-4 py-3">
                    <span class="size-3 rounded-full bg-[#ff5f57]"></span>
                    <span class="size-3 rounded-full bg-[#febc2e]"></span>
                    <span class="size-3 rounded-full bg-[#28c840]"></span>
                    <span id="demo-directory-url" class="mx-auto rounded-full border border-border bg-surface px-6 py-1 font-mono text-[11px] text-subtle">my-space.dev/items</span>
                    <span class="size-3" aria-hidden="true"></span>
                  </div>

                  <div class="p-5 sm:p-6">
                    <label class="flex items-center gap-2.5 rounded-full border border-border bg-surface px-4 py-2.5 transition-colors focus-within:border-brand/60">
                      <svg class="size-4 shrink-0 text-subtle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.3-4.3"></path>
                      </svg>
                      <input
                        id="demo-directory-search"
                        type="search"
                        placeholder="Search records…"
                        autocomplete="off"
                        class="w-full border-0 bg-transparent p-0 font-sans text-sm text-fg outline-none placeholder:text-subtle"
                        aria-label="Search the demo directory"
                      />
                    </label>

                    <div class="mt-3.5 flex flex-wrap gap-1.5" role="group" aria-label="Browse by lens">
                      {lenses.map((lens, i) => (
                        <button
                          type="button"
                          class="lens-tab rounded-full border border-border px-3.5 py-1.5 text-xs font-medium text-muted transition-colors hover:border-border-strong hover:text-fg"
                          data-lens={lens.id}
                          data-param={lens.param}
                          aria-pressed={i === 0 ? 'true' : 'false'}
                        >
                          {lens.label}
                        </button>
                      ))}
                    </div>

                    <ul class="mt-4 flex flex-col gap-1.5" aria-label="Demo directory records">
                      {records.map((record) => (
                        <li
                          data-record
                          data-lenses={record.lenses}
                          data-search={`${record.name} ${record.category} ${record.stack}`.toLowerCase()}
                          class="demo-record flex items-center gap-3 rounded-xl border border-border bg-card px-4 py-2.5"
                        >
                          <span class="size-1.5 shrink-0 rounded-full bg-accent-green" aria-hidden="true"></span>
                          <span class="text-sm font-medium text-fg">{record.name}</span>
                          <span class="ml-auto font-mono text-[10px] text-subtle">{record.category} · {record.stack}</span>
                        </li>
                      ))}
                      <li id="demo-directory-empty" hidden class="rounded-xl border border-dashed border-border px-4 py-4 text-center text-xs text-subtle">
                        No records match — clear the search or switch lens.
                      </li>
                    </ul>

                    <p class="mt-3.5 flex items-center justify-between font-mono text-[10px] text-subtle">
                      <span id="demo-directory-count" aria-live="polite">7 of 7 records</span>
                      <span>search · filters · lenses</span>
                    </p>
                  </div>
                </div>
              </div>
              <p class="mt-3 text-center font-mono text-[10px] uppercase tracking-widest text-subtle">
                Step 04 · Publish
              </p>

              <div id="hgw-extras">
                <div class="hgw-extra-caption mb-1 flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-subtle">
                  <span class="text-brand-light">Step 05</span>
                  <span aria-hidden="true">·</span>
                  <span>Generate</span>
                </div>
                <div id="hgw-outputs" class="rounded-xl border border-border bg-card/95 p-4 shadow-xl shadow-black/30 backdrop-blur">
                  <span class="mb-2.5 block font-mono text-[10px] uppercase tracking-widest text-subtle">Generated outputs</span>
                  <div class="grid grid-cols-2 gap-1.5">
                    {outputs.map((out) => (
                      <div data-out class="flex flex-col rounded-md border border-border bg-surface px-2 py-1.5">
                        <span class="font-mono text-[10px] text-fg">{out.file}</span>
                        <span class="text-[9px] text-brand-light">{out.tag}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="hgw-extra-caption mt-4 mb-1 flex items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-subtle sm:mt-0">
                  <span class="text-brand-light">Step 06</span>
                  <span aria-hidden="true">·</span>
                  <span>Maintain</span>
                </div>
                <div id="hgw-health" class="rounded-xl border border-border bg-card/95 p-4 shadow-2xl shadow-black/50 backdrop-blur">
                  <div class="mb-3 flex items-center gap-2">
                    <svg id="hgw-health-spin" class="size-3.5 text-brand-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
                      <path d="M21 3v6h-6"></path>
                    </svg>
                    <span class="text-xs font-semibold text-fg">Collection health</span>
                    <span class="ml-auto font-mono text-[10px] text-subtle">grove sync · grove check</span>
                  </div>
                  <div class="space-y-2">
                    {health.map((row) => (
                      <div data-health class="flex items-center justify-between gap-3 rounded-md border border-border bg-surface px-3 py-2">
                        <div class="flex min-w-0 flex-col">
                          <span class="truncate font-mono text-xs text-fg">{row.name}</span>
                          <span class="truncate text-[10px] text-subtle">{row.meta}</span>
                        </div>
                        <span class:list={['shrink-0 rounded-full border px-2 py-0.5 font-mono text-[9px] font-medium', pillClass[row.status]]}>{row.pill}</span>
                      </div>
                    ))}
                  </div>
                  <p class="mt-3 border-t border-border pt-2.5 font-mono text-[10px] leading-relaxed text-subtle">
                    Records with no release in 183+ days earn a review.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Step nav: cards in static mode, a progress rail while scrubbing. -->
        <ol id="hgw-stepnav" aria-label="How Grove works, step by step">
          {steps.map((step, i) => (
            <li class="hgw-step" data-step={i}>
              <div class="hgw-step-head">
                <span class="hgw-step-index font-mono text-xs text-subtle">0{i + 1}</span>
                <span class="hgw-step-line" aria-hidden="true"></span>
                <span class="hgw-step-label text-sm font-medium text-fg">{step.label}</span>
                <span class="hgw-step-check ml-auto text-brand-light opacity-0 transition-opacity" aria-hidden="true">
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
              </div>
              <div class="hgw-step-body">
                <h3 class="text-balance text-lg font-semibold leading-snug text-fg">{step.heading}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-muted">{step.copy}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- Static layout (default): step cards first, live window below. ---- */
  .hgw-wrap {
    display: flex;
    flex-direction: column;
    max-width: 80rem;
    margin-inline: auto;
    padding: 0 1.5rem 6rem;
  }

  #hgw-stepnav {
    order: -1;
    display: grid;
    gap: 0.75rem;
    margin: 0 0 2.5rem;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    #hgw-stepnav { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    #hgw-stepnav { grid-template-columns: repeat(3, 1fr); }
  }

  .hgw-step {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-card);
    padding: 1rem 1.125rem;
  }

  .hgw-step-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hgw-step-line { display: none; }

  .hgw-step-body { margin-top: 0.6rem; }

  /* Scenes 1–3 are scroll-driven decoration; they only exist while scrubbing. */
  .hgw-scene, .hgw-gridbg { display: none; }

  #hgw-site-inner {
    position: relative;
    max-width: 42rem;
    margin-inline: auto;
    width: 100%;
  }

  #hgw-extras {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    #hgw-extras { grid-template-columns: repeat(2, 1fr); }
  }

  /* ---- Scrub mode: enabled by JS on desktop when motion is allowed. ---- */
  #hgw.is-scrub { height: 440vh; }

  #hgw.is-scrub .hgw-sticky {
    position: sticky;
    top: 0;
    display: flex;
    height: 100vh;
    align-items: center;
  }

  #hgw.is-scrub .hgw-wrap {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 3.5rem;
    align-items: center;
    width: 100%;
    padding-bottom: 0;
  }

  #hgw.is-scrub #hgw-canvas {
    height: 66vh;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: rgb(22 22 24 / 0.55);
  }

  #hgw.is-scrub .hgw-gridbg {
    display: block;
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image:
      linear-gradient(to right, rgb(63 63 70 / 0.35) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(63 63 70 / 0.35) 1px, transparent 1px);
    background-size: 44px 44px;
  }

  #hgw.is-scrub .hgw-scene {
    display: flex;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    padding: 0 1.5rem;
    pointer-events: none;
  }

  #hgw.is-scrub #hgw-site {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 1.5rem;
  }

  #hgw.is-scrub #hgw-site-inner { max-width: 36rem; }

  #hgw.is-scrub #hgw-window { transform-origin: left center; }

  #hgw.is-scrub #hgw-extras {
    display: contents;
  }

  #hgw.is-scrub #hgw-outputs {
    position: absolute;
    right: -1rem;
    top: 50%;
    width: 46%;
    max-width: 240px;
    transform: translateY(-50%);
    pointer-events: none;
    opacity: 0;
  }

  #hgw.is-scrub #hgw-health {
    position: absolute;
    bottom: -1.5rem;
    left: 0;
    width: 68%;
    max-width: 360px;
    pointer-events: none;
    opacity: 0;
  }

  #hgw.is-scrub .hgw-chip {
    transform: translate(-50%, -50%);
    opacity: 0;
  }

  #hgw.is-scrub #hgw-core {
    transform: translate(-50%, -50%);
    opacity: 0;
  }

  /* Scene 3 → 4 bridge chip: fades in mid-canvas to lead into the live site. */
  #hgw-bridge {
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  /* Scrub-mode caption: identifies the active step above the canvas. Hidden
     in static layout (where the step cards above already carry the labels). */
  #hgw-caption { display: none; }
  #hgw.is-scrub #hgw-caption { display: block; }

  /* Continuous progress bar: hidden in static mode where step cards already
     convey the journey. */
  #hgw-progress { display: none; }
  #hgw.is-scrub #hgw-progress { display: block; }
  #hgw-progress-fill { transition: width 0.12s linear; }

  /* Static-mode captions: bind outputs and health to steps 5 and 6. The rail
     names the steps in scrub mode, so these become noise and are hidden. */
  #hgw.is-scrub .hgw-extra-caption { display: none; }

  /* Step nav becomes a vertical progress rail. */
  #hgw.is-scrub #hgw-stepnav {
    order: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
  }

  #hgw.is-scrub .hgw-step {
    border: 0;
    background: transparent;
    padding: 0.4rem 0;
    opacity: 0.35;
    transition: opacity 0.3s ease;
  }

  #hgw.is-scrub .hgw-step.is-done { opacity: 0.55; }
  #hgw.is-scrub .hgw-step.is-active { opacity: 1; }

  /* Completed steps show a check mark; the active step hides it because
     its body is already expanded underneath. */
  #hgw.is-scrub .hgw-step.is-done .hgw-step-check { opacity: 0.7; }
  #hgw.is-scrub .hgw-step.is-active .hgw-step-check { opacity: 0; }

  #hgw.is-scrub .hgw-step-line {
    display: block;
    height: 1px;
    width: 1rem;
    background: var(--color-border-strong);
    transition: width 0.3s ease, background-color 0.3s ease;
  }

  #hgw.is-scrub .hgw-step.is-active .hgw-step-line {
    width: 2rem;
    background: var(--color-brand);
  }

  #hgw.is-scrub .hgw-step.is-active .hgw-step-index { color: var(--color-brand-light); }

  #hgw.is-scrub .hgw-step-body { display: none; }

  #hgw.is-scrub .hgw-step.is-active .hgw-step-body {
    display: block;
    margin-top: 0.75rem;
    max-width: 22rem;
    animation: hgw-step-in 0.5s cubic-bezier(0.2, 0.6, 0.2, 1);
  }

  @keyframes hgw-step-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  /* Live demo behaviour (shared by both modes). */
  .demo-record { transition: opacity 0.25s ease; }
  .demo-record.is-hidden { display: none; }

  .lens-tab[aria-pressed='true'] {
    color: #fff;
    background: var(--color-brand);
    border-color: var(--color-brand);
  }
</style>

<script is:inline>
  (() => {
    // Live directory demo: lens tabs + search filter the sample records and
    // rewrite the fake address bar the way hrefForLens() would.
    const root = document.getElementById('demo-directory');
    if (!root) return;
    const cards = [...root.querySelectorAll('[data-record]')];
    const tabs = [...root.querySelectorAll('.lens-tab')];
    const input = document.getElementById('demo-directory-search');
    const count = document.getElementById('demo-directory-count');
    const empty = document.getElementById('demo-directory-empty');
    const url = document.getElementById('demo-directory-url');
    if (!cards.length || !tabs.length || !input || !count || !empty || !url) return;

    let activeLens = 'all';
    let activeParam = '';

    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const lensOk =
          activeLens === 'all' || (card.dataset.lenses ?? '').split(' ').includes(activeLens);
        const searchOk = !q || (card.dataset.search ?? '').includes(q);
        const visible = lensOk && searchOk;
        card.classList.toggle('is-hidden', !visible);
        if (visible) shown += 1;
      }
      empty.hidden = shown > 0;
      count.textContent = `${shown} of ${cards.length} records`;
      const params = [];
      if (q) params.push(`q=${encodeURIComponent(q)}`);
      if (activeParam) params.push(activeParam);
      url.textContent = `my-space.dev/items${params.length ? `?${params.join('&')}` : ''}`;
    };

    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        activeLens = tab.dataset.lens ?? 'all';
        activeParam = tab.dataset.param ?? '';
        for (const other of tabs) other.setAttribute('aria-pressed', String(other === tab));
        apply();
      });
    }
    input.addEventListener('input', apply);
  })();
</script>

<script is:inline>
  (() => {
    // Scroll-driven "How Grove works" scrub. Pure enhancement: it only turns
    // on for wide viewports when prefers-reduced-motion is off, and tears
    // itself down (removing every inline style) when either changes.
    const track = document.getElementById('hgw');
    if (!track) return;

    const $ = (id) => document.getElementById(id);
    const clamp = (v, min = 0, max = 1) => Math.min(Math.max(v, min), max);
    const lerp = (a, b, t) => a + (b - a) * t;
    const ramp = (p, s, e) => clamp((p - s) / (e - s));
    // Opacity envelope: fade in a→b, hold b→c, fade out c→d.
    const band = (p, a, b, c = 1, d = 1) => ramp(p, a, b) * (d > c ? 1 - ramp(p, c, d) : 1);

    const term = $('hgw-terminal');
    const typed = $('hgw-typed');
    const cursor = $('hgw-cursor');
    const line1 = $('hgw-term-line1');
    const line2 = $('hgw-term-line2');
    const files = $('hgw-files');
    const system = $('hgw-system');
    const core = $('hgw-core');
    const site = $('hgw-site');
    const win = $('hgw-window');
    const outputs = $('hgw-outputs');
    const healthPanel = $('hgw-health');
    const spin = $('hgw-health-spin');
    if (!term || !files || !system || !site || !win || !outputs || !healthPanel) return;

    const treeNodes = [...files.querySelectorAll('[data-at]')];
    const inPaths = [...system.querySelectorAll('.hgw-in-path')];
    const capPaths = [...system.querySelectorAll('.hgw-cap-path')];
    const inChips = [...system.querySelectorAll('[data-chip="in"]')];
    const capChips = [...system.querySelectorAll('[data-chip="cap"]')];
    const records = [...site.querySelectorAll('[data-record]')];
    const outItems = [...outputs.querySelectorAll('[data-out]')];
    const healthRows = [...healthPanel.querySelectorAll('[data-health]')];
    const steps = [...track.querySelectorAll('.hgw-step')];

    const bridge = $('hgw-bridge');
    const outPath = $('hgw-out-path');
    const outArrow = $('hgw-out-arrow');
    const capIndexEl = $('hgw-caption-index');
    const capLabelEl = $('hgw-caption-label');
    const progressFill = $('hgw-progress-fill');

    const COMMAND = 'grove init my-space';

    // Tree nodes keep an inline padding-left for indentation, so teardown
    // must only clear what render() touched instead of the style attribute.
    const styled = [
      term, cursor, line1, line2, files, system, core, site, win, outputs,
      healthPanel, spin, bridge, outPath, outArrow, progressFill,
      ...inPaths, ...capPaths, ...inChips,
      ...capChips, ...records, ...outItems, ...healthRows,
    ].filter(Boolean);

    let raf = 0;
    let enabled = false;

    const render = () => {
      raf = 0;
      const rect = track.getBoundingClientRect();
      const total = track.offsetHeight - window.innerHeight;
      if (total <= 0) return;
      const p = clamp(Math.min(Math.max(-rect.top, 0), total) / total);

      // Continuous progress bar fills smoothly across all six steps so the
      // viewer gets a constant sense of where they are in the journey.
      if (progressFill) progressFill.style.width = `${(p * 100).toFixed(2)}%`;

      // 01 · Initialize — terminal types, prints, then hands off upward.
      const termO = band(p, 0, 0.02, 0.13, 0.19);
      const exitTerm = ramp(p, 0.13, 0.19);
      term.style.opacity = termO;
      term.style.visibility = termO > 0.001 ? 'visible' : 'hidden';
      term.style.transform = `translateY(${lerp(0, -24, exitTerm)}px) scale(${lerp(1, 0.92, exitTerm)})`;
      const chars = Math.round(ramp(p, 0.02, 0.08) * COMMAND.length);
      typed.textContent = COMMAND.slice(0, chars);
      cursor.style.opacity = chars < COMMAND.length || p < 0.13 ? '1' : '0';
      line1.style.opacity = ramp(p, 0.085, 0.1);
      line2.style.opacity = ramp(p, 0.1, 0.12);

      // 02 · Add content — file tree rows reveal one by one.
      const filesO = band(p, 0.11, 0.16, 0.32, 0.37);
      files.style.opacity = filesO;
      files.style.visibility = filesO > 0.001 ? 'visible' : 'hidden';
      files.style.transform = `scale(${lerp(1, 0.9, ramp(p, 0.32, 0.37))})`;
      for (const node of treeNodes) {
        const at = Number(node.dataset.at);
        const r = ramp(p, at, at + 0.02);
        node.style.opacity = r;
        node.style.transform = `translateX(${lerp(-10, 0, r)}px)`;
      }

      // 03 · Structure — inputs flow into the Grove node, capabilities out.
      const sysO = band(p, 0.3, 0.36, 0.5, 0.55);
      system.style.opacity = sysO;
      system.style.visibility = sysO > 0.001 ? 'visible' : 'hidden';
      const stage = system.firstElementChild;
      if (stage) {
        stage.style.transform = `scale(${lerp(0.96, 1, ramp(p, 0.3, 0.4)) * lerp(1, 1.04, ramp(p, 0.5, 0.55))})`;
      }
      const inFlow = ramp(p, 0.34, 0.42);
      const capsFlow = ramp(p, 0.42, 0.5);
      for (const path of inPaths) path.style.strokeDashoffset = 1 - inFlow;
      for (const path of capPaths) path.style.strokeDashoffset = 1 - capsFlow;
      const nodeIn = ramp(p, 0.36, 0.43);
      if (core) {
        core.style.opacity = nodeIn;
        core.style.transform = `translate(-50%,-50%) scale(${lerp(0.7, 1, nodeIn)})`;
      }
      inChips.forEach((chip, i) => {
        const r = ramp(p, 0.33 + i * 0.01, 0.4 + i * 0.01);
        chip.style.opacity = r;
        chip.style.transform = `translate(-50%,-50%) translateX(${lerp(-12, 0, r)}px)`;
      });
      capChips.forEach((chip, i) => {
        const r = ramp(p, 0.43 + i * 0.012, 0.5 + i * 0.012);
        chip.style.opacity = r;
        chip.style.transform = `translate(-50%,-50%) translateX(${lerp(12, 0, r)}px)`;
      });

      // 03 → 04 bridge: output path draws out, chip fades in mid-canvas.
      const bridgeO = band(p, 0.46, 0.5, 0.55, 0.58);
      if (bridge) {
        bridge.style.opacity = bridgeO;
        bridge.style.visibility = bridgeO > 0.001 ? 'visible' : 'hidden';
      }
      const drawOut = ramp(p, 0.46, 0.54);
      if (outPath) outPath.style.strokeDashoffset = 1 - drawOut;
      if (outArrow) {
        outArrow.style.opacity = drawOut * (1 - ramp(p, 0.56, 0.6));
      }

      // 04–06 · Publish / Generate / Maintain — the live site takes over.
      const siteO = ramp(p, 0.47, 0.55);
      const appear = ramp(p, 0.47, 0.57);
      const gen = ramp(p, 0.62, 0.72);
      const maint = ramp(p, 0.82, 0.9);
      const side = Math.max(gen, maint);
      site.style.opacity = siteO;
      site.style.visibility = siteO > 0.001 ? 'visible' : 'hidden';
      site.style.pointerEvents = p > 0.5 ? 'auto' : 'none';
      win.style.transform = `translateY(${lerp(28, 0, appear)}px) scale(${lerp(0.93, 1, appear) * lerp(1, 0.8, side)})`;
      records.forEach((record, i) => {
        const r = ramp(p, 0.5 + i * 0.012, 0.6 + i * 0.012);
        record.style.opacity = r;
        record.style.transform = `translateY(${lerp(14, 0, r)}px)`;
      });
      outputs.style.opacity = gen * lerp(1, 0.6, maint);
      outputs.style.transform = `translateY(-50%) translateX(${lerp(24, 0, gen)}px)`;
      outItems.forEach((item, i) => {
        const r = ramp(p, 0.66 + i * 0.012, 0.72 + i * 0.012);
        item.style.opacity = r;
        item.style.transform = `scale(${lerp(0.9, 1, r)})`;
      });
      healthPanel.style.opacity = maint;
      healthPanel.style.transform = `translateY(${lerp(20, 0, maint)}px)`;
      if (spin) spin.style.transform = `rotate(${maint * 180}deg)`;
      healthRows.forEach((row, i) => {
        const r = ramp(p, 0.85 + i * 0.02, 0.91 + i * 0.02);
        row.style.opacity = r;
        row.style.transform = `translateX(${lerp(-12, 0, r)}px)`;
      });

      // Step rail — smooth, continuous opacity across the boundary instead of
      // snapping at Math.floor boundaries. The active step still drives the
      // highlight (line color, check mark) via classes, but opacity is driven
      // by the fractional position so the eye glides between steps.
      const totalSteps = steps.length;
      const continuous = p * totalSteps;
      const active = Math.min(totalSteps - 1, Math.floor(continuous));
      const blend = continuous - active;
      steps.forEach((step, i) => {
        step.classList.toggle('is-active', i === active);
        step.classList.toggle('is-done', i < active);

        let op;
        if (i < active) {
          op = 0.55;
        } else if (i === active) {
          // Active step: fade 0.55 → 1.0 across the first half of its window.
          op = 0.55 + 0.45 * Math.min(1, blend * 2);
        } else if (i === active + 1) {
          // Next step: pre-fade 0.35 → 0.55 in the second half, so the next
          // step begins to lift out of the dim background before the snap.
          op = 0.35 + 0.2 * Math.max(0, blend - 0.5) * 2;
        } else {
          op = 0.35;
        }
        step.style.opacity = String(op);
      });

      // Top-of-canvas caption mirrors the active step (scrub mode only).
      if (capIndexEl && capLabelEl) {
        const labelEl = steps[active]?.querySelector('.hgw-step-label');
        capIndexEl.textContent = `Step 0${active + 1}`;
        capLabelEl.textContent = labelEl?.textContent ?? '';
      }
    };

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(render);
    };

    const setEnabled = (on) => {
      if (on === enabled) return;
      enabled = on;
      track.classList.toggle('is-scrub', on);
      if (on) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        render();
      } else {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        for (const el of styled) el.removeAttribute('style');
        for (const node of treeNodes) {
          node.style.opacity = '';
          node.style.transform = '';
        }
        typed.textContent = COMMAND;
        for (const step of steps) step.classList.remove('is-active', 'is-done');
      }
    };

    const wide = window.matchMedia('(min-width: 1024px)');
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const evaluate = () => setEnabled(wide.matches && !motion.matches);
    wide.addEventListener('change', evaluate);
    motion.addEventListener('change', evaluate);
    evaluate();
  })();
</script>
