      const total = track.offsetHeight - window.innerHeight;
      if (total <= 0) return null;
      return clamp(Math.min(Math.max(-rect.top, 0), total) / total);
    };

    const render = (p) => {
      // Continuous progress bar fills smoothly across all five steps so the
      // viewer gets a constant sense of where they are in the journey.
      if (progressFill) progressFill.style.width = `${(p * 100).toFixed(2)}%`;

      // Every scene's exit window ends before the next scene's enter window
      // starts (with a short dead zone between), so at no scroll position
      // are two scenes visible at once.

      // 01 · Initialize — the frame is present at section entry, then types,
      // prints, holds, and fully exits by p=0.195.
      const exitTerm = smooth(ramp(p, 0.15, 0.195));
      const termO = 1 - exitTerm;
      term.style.opacity = termO;
      term.style.visibility = termO > 0.001 ? 'visible' : 'hidden';
      term.style.transform = `translate3d(${lerp(0, -42, exitTerm)}%, ${lerp(0, -6, exitTerm)}px, 0) scale(${lerp(1, 0.96, exitTerm)})`;
      term.style.filter = blur(lerp(0, 0.8, exitTerm));
      const chars = Math.round(ramp(p, 0.01, 0.07) * COMMAND.length);
      typed.textContent = COMMAND.slice(0, chars);
      cursor.style.opacity = chars < COMMAND.length || p < 0.15 ? '1' : '0';
      line1.style.opacity = ramp(p, 0.075, 0.095);
      line2.style.opacity = ramp(p, 0.095, 0.115);

      // 02 · Add content — file tree enters at 0.21 (after the terminal is
      // gone), reveals row by row, holds, and fully exits by 0.45.
      const filesIn = smooth(ramp(p, 0.21, 0.26));
      const filesOut = smooth(ramp(p, 0.4, 0.45));
      const filesO = filesIn * (1 - filesOut);
      files.style.opacity = filesO;
      files.style.visibility = filesO > 0.001 ? 'visible' : 'hidden';
      files.style.transform = `translate3d(${lerp(42, 0, filesIn) + lerp(0, -42, filesOut)}%, ${lerp(6, 0, filesIn) + lerp(0, -6, filesOut)}px, 0) scale(${lerp(0.96, 1, filesIn) * lerp(1, 0.96, filesOut)})`;
      files.style.filter = blur(lerp(0.8, 0, filesIn) + lerp(0, 0.8, filesOut));
      for (const node of treeNodes) {
        const at = Number(node.dataset.at);
        const r = ramp(p, at, at + 0.02);
        node.style.opacity = r;
        node.style.transform = `translateX(${lerp(-10, 0, r)}px)`;
      }

      // 03 · Publish — the live site enters at 0.47 at its final size,
      // holds while it is interactive, then fully exits by 0.665.
      const appear = smooth(ramp(p, 0.47, 0.53));
      const siteOut = smooth(ramp(p, 0.62, 0.665));
      const siteO = appear * (1 - siteOut);
      site.style.opacity = siteO;
      site.style.visibility = siteO > 0.001 ? 'visible' : 'hidden';
      site.style.pointerEvents = p > 0.53 && p < 0.6 ? 'auto' : 'none';
      site.style.transform = `translate3d(${lerp(42, 0, appear) + lerp(0, -42, siteOut)}%, ${lerp(6, 0, appear) + lerp(0, -6, siteOut)}px, 0)`;
      site.style.filter = blur(lerp(0.8, 0, appear) + lerp(0, 0.8, siteOut));
      // Scale is the resize-computed fit — scroll never changes it.
      composition.style.transform = `scale(${fitScale})`;
      records.forEach((record, i) => {
        const r = ramp(p, 0.5 + i * 0.004, 0.545 + i * 0.004);
        record.style.opacity = r;
        record.style.transform = `translateY(${lerp(14, 0, r)}px)`;
      });

      // 04 · Deploy — hosting targets enter at 0.675 (site fully gone),
      // stagger in, hold, and exit by 0.82.
      const depIn = smooth(ramp(p, 0.675, 0.72));
      const depOut = smooth(ramp(p, 0.78, 0.82));
      const depO = depIn * (1 - depOut);
      deploy.style.opacity = depO;
      deploy.style.visibility = depO > 0.001 ? 'visible' : 'hidden';
      deploy.style.transform = `translate(calc(-50% + ${lerp(60, 0, depIn) + lerp(0, -60, depOut)}px), -50%) scale(${lerp(0.96, 1, depIn) * lerp(1, 0.96, depOut)})`;
      deploy.style.filter = blur(lerp(0.8, 0, depIn) + lerp(0, 0.8, depOut));
      hostItems.forEach((item, i) => {
        const r = ramp(p, 0.705 + i * 0.012, 0.745 + i * 0.012);
        item.style.opacity = r;
        item.style.transform = `scale(${lerp(0.92, 1, r)})`;
      });

      // 05 · Automate — collection health enters at 0.835, rows resolve to
      // fresh / stale / archived, then it hands off to the finale by 0.965.
      const autoIn = smooth(ramp(p, 0.835, 0.875));
      const autoOut = smooth(ramp(p, 0.945, 0.965));
      const autoO = autoIn * (1 - autoOut);
      healthPanel.style.opacity = autoO;
      healthPanel.style.visibility = autoO > 0.001 ? 'visible' : 'hidden';
      healthPanel.style.transform = `translate(calc(-50% + ${lerp(60, 0, autoIn) + lerp(0, -60, autoOut)}px), -50%) scale(${lerp(0.96, 1, autoIn) * lerp(1, 0.96, autoOut)})`;
      healthPanel.style.filter = blur(lerp(0.8, 0, autoIn) + lerp(0, 0.8, autoOut));
      if (spin) spin.style.transform = `rotate(${ramp(p, 0.84, 0.95) * 360}deg)`;
      healthRows.forEach((row, i) => {
        const r = ramp(p, 0.865 + i * 0.015, 0.9 + i * 0.015);
        row.style.opacity = r;
        row.style.transform = `translateX(${lerp(-12, 0, r)}px)`;
      });

      // Finale — the Grove mark rises out of the last scene and holds.
      const fin = smooth(ramp(p, 0.97, 0.995));
      finale.style.opacity = fin;
      finale.style.visibility = fin > 0.001 ? 'visible' : 'hidden';
      finale.style.transform = `scale(${lerp(0.92, 1, fin)})`;
      // The mark grows itself once, the first time the scene starts to show.
      // The class is never removed, so scrubbing back and forth cannot restart
      // the growth halfway through.
      if (fin > 0.02) finale.classList.add('is-growing');

      // Step rail follows the scene-specific holds instead of dividing scroll
      // into equal slices. Copy now changes only when its visual has arrived.
      const stepStarts = [0, 0.21, 0.47, 0.675, 0.835];
      let active = 0;
      for (let i = 1; i < stepStarts.length; i += 1) {
        if (p >= stepStarts[i]) active = i;
      }
      const activeStart = stepStarts[active];
      const activeEnd = stepStarts[active + 1] ?? 1;
      const blend = ramp(p, activeStart, activeEnd);
      steps.forEach((step, i) => {
        step.classList.toggle('is-active', i === active);
        step.classList.toggle('is-done', i < active);

        let op;
        if (i < active) {
          op = 0.55;
        } else if (i === active) {
          // Active copy reaches full contrast early, then holds with its scene.
          op = 0.55 + 0.45 * Math.min(1, blend * 3);
        } else if (i === active + 1) {
          // Lift the next label only near the handoff, not during the hold.
          op = 0.35 + 0.2 * Math.max(0, blend - 0.75) * 4;
        } else {
          op = 0.35;
        }
        step.style.opacity = String(op);
      });

      // Top-of-canvas caption mirrors the active step (scrub mode only).
      if (capIndexEl && capLabelEl) {
        const labelEl = steps[active]?.querySelector('.hgw-step-label');
        capIndexEl.textContent = `Step 0${active + 1}`;
        capLabelEl.textContent = labelEl?.textContent ?? '';
      }
    };

    // A flick can cross the whole 440vh track in a handful of frames, which
    // would snap the scenes past faster than any of them could be read. The
    // rendered progress therefore chases the scroll position instead of
    // tracking it, under two limits:
    //
    //   TAU       — exponential time constant, which shapes the ease-out as
    //               it arrives and keeps ordinary scrolling feeling direct.
    //   MAX_RATE  — a ceiling on progress per second. This is what actually
    //               fixes a fast flick: an exponential ease takes about the
    //               same time whatever the distance, so on its own it still
    //               crams all five scenes into a fraction of a second. At
    //               0.5/s the full story cannot play in under ~2s, which is
    //               roughly 0.4s a scene. Normal scrolling never reaches the
    //               ceiling, so it is unaffected.
    //
    // Both steps are scaled by real elapsed time, so 60Hz and 120Hz displays
    // ease at one speed, and the rAF loop keeps running until it caught up.
    const TAU = 0.22;
    const MAX_RATE = 0.5;
    const EPSILON = 0.0002;

    const tick = (now) => {
      raf = 0;
      const target = readTarget();
      if (target === null) return;
      // The first frame after an idle period has no measurable delta; it
      // renders where it is and lets the next frame do the moving.
      const dt = lastTime ? Math.min((now - lastTime) / 1000, 0.1) : 0;
      lastTime = now;
      const diff = target - progress;
      if (Math.abs(diff) < EPSILON) {
        // Settled: render the exact target and let the loop stop until the
        // next scroll event restarts it.
        progress = target;
        lastTime = 0;
        render(progress);
        return;
      }
      const eased = diff * (1 - Math.exp(-dt / TAU));
      const cap = MAX_RATE * dt;
      progress += Math.max(-cap, Math.min(cap, eased));
      render(progress);
      raf = requestAnimationFrame(tick);
    };

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(tick);
    };

    const onResize = () => {
      fit();
      onScroll();
    };

    const setEnabled = (on) => {
      if (on === enabled) return;
      enabled = on;
      track.classList.toggle('is-scrub', on);
      if (on) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onResize, { passive: true });
        fit();
        // Enabling mid-section must not ease in from zero — start where the
        // scroll position already is.
        progress = readTarget() ?? 0;
        lastTime = 0;
        render(progress);
      } else {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onResize);
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        progress = 0;
        lastTime = 0;
        for (const el of styled) el.removeAttribute('style');
        for (const node of treeNodes) {
          node.style.opacity = '';
          node.style.transform = '';
        }
        typed.textContent = COMMAND;
        for (const step of steps) step.classList.remove('is-active', 'is-done');
      }
    };

    // Reduced motion is the only thing that turns the scrub off now: the
    // story runs at every viewport width, with the canvas and the step rail
    // stacking below `lg` instead of sitting side by side.
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const evaluate = () => setEnabled(!motion.matches);
    motion.addEventListener('change', evaluate);
    evaluate();
  })();
</script>
