---
import SectionHeader from './SectionHeader.astro';

// Terminal output lines are the real strings printed by the CLI
// (packages/cli/src/index.ts, cleanup command) — not invented output.
const phases = [
  {
    verb: 'Plant',
    desc: 'Scaffold a complete working space, then add records as YAML files. No prompts, no template registry — the CLI copies the full example space and renames it.',
    color: 'text-accent-green',
    dot: 'bg-accent-green',
    lines: [
      { kind: 'cmd', text: 'pnpm dlx @grove-dev/cli@latest init my-space' },
      { kind: 'out', text: 'my-space/ ready — records, taxonomy, workflows' },
      { kind: 'cmd', text: 'vim data/records/immich.yml' },
    ],
  },
  {
    verb: 'Grow',
    desc: 'Every submission is a pull request. CI validates the schema, sync refreshes repository evidence, and a human makes the editorial call.',
    color: 'text-accent-teal',
    dot: 'bg-accent-teal',
    lines: [
      { kind: 'cmd', text: 'pnpm exec grove check' },
      { kind: 'out', text: '[grove] 6 records prepared; sitemap and llms files updated.' },
      { kind: 'cmd', text: 'pnpm exec grove sync github' },
      { kind: 'out', text: '[sync github] 5 updated (1 HTML fallback), 0 failed' },
    ],
  },
  {
    verb: 'Prune',
    desc: 'Staleness becomes a review queue instead of a memory task. Grove reports the candidates; maintainers decide to keep, hide, or remove.',
    color: 'text-accent-orange',
    dot: 'bg-accent-orange',
    lines: [
      { kind: 'cmd', text: 'pnpm exec grove cleanup --strict' },
      { kind: 'out', text: '[cleanup] 2 candidate(s) → data/generated/cleanup-report.json' },
      { kind: 'out', text: '  - old-project (stale, 12★)' },
    ],
  },
];
---

<section id="how-it-works" class="mx-auto max-w-7xl px-6 py-24" aria-labelledby="how-it-works-title">
  <SectionHeader
    eyebrow="How Grove works"
    title="Plant. Grow. Prune."
    titleId="how-it-works-title"
    lede="Three verbs, one Git repository. Grove automates the repeatable checks and generation — editorial judgment stays human."
  />

  <div class="mt-14 grid grid-cols-1 gap-4 lg:grid-cols-3">
    {phases.map((phase, i) => (
      <article class="flex flex-col overflow-hidden rounded-xl border border-border bg-card transition-[transform,border-color] hover:-translate-y-0.5 hover:border-border-strong">
        <div class="flex items-center gap-3 border-b border-border px-5 py-4">
          <span class={`flex size-7 items-center justify-center rounded-full border border-border-strong bg-surface font-mono text-[11px] ${phase.color}`}>0{i + 1}</span>
          <h3 class={`font-display text-xl font-semibold ${phase.color}`}>{phase.verb}</h3>
        </div>
        <p class="px-5 pt-4 text-sm leading-relaxed text-muted">{phase.desc}</p>
        <div class="m-5 mt-4 flex-1 rounded-lg border border-border bg-bg p-4">
          <div class="flex items-center gap-1.5 pb-3" aria-hidden="true">
            <span class="size-2.5 rounded-full bg-border-strong"></span>
            <span class="size-2.5 rounded-full bg-border-strong"></span>
            <span class={`size-2.5 rounded-full ${phase.dot}`}></span>
          </div>
          <pre class="m-0 overflow-x-auto font-mono text-[11px] leading-6"><code>{phase.lines.map((line) => (
            line.kind === 'cmd'
              ? <span class="block text-muted"><span class="text-subtle">$ </span>{line.text}</span>
              : <span class="block text-accent-green/80">{line.text}</span>
          ))}</code></pre>
        </div>
      </article>
    ))}
  </div>
</section>
