---
const columns = [
  {
    heading: 'Product',
    items: [
      { label: 'Documentation', href: '/introduction/' },
      { label: 'Quick start', href: '/getting-started/scaffold/' },
      { label: 'Roadmap', href: '/project/roadmap/' },
      { label: 'Showcase', href: '/showcase/typography/' },
    ],
  },
  {
    heading: 'Project',
    items: [
      { label: 'GitHub', href: 'https://github.com/tortuvshin/grove', external: true },
      { label: 'npm packages', href: 'https://www.npmjs.com/search?q=%40grove-dev', external: true },
      { label: 'Open Apps', href: '/open-apps/' },
      { label: 'License (MIT)', href: 'https://github.com/tortuvshin/grove/blob/main/LICENSE', external: true },
    ],
  },
  {
    heading: 'Community',
    items: [
      { label: 'Contributing', href: '/maintainers/contributing/' },
      { label: 'Governance', href: '/maintainers/governance/' },
      { label: 'Discussions', href: 'https://github.com/tortuvshin/grove/discussions', external: true },
      { label: 'Report an issue', href: 'https://github.com/tortuvshin/grove/issues', external: true },
    ],
  },
];
const year = new Date().getFullYear();
---

<!-- No top margin: the closing CTA already ends in its own gradient, and a
     gap between the two left a bare strip of page background reading as an
     extra, bordered section above the footer. -->
<footer class="border-t border-border/60">
  <div class="mx-auto max-w-7xl px-6 py-12">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <div class="flex items-center gap-2.5">
          <svg
            class="size-5 text-fg"
            viewBox="0 0 32 32"
            fill="none"
            aria-hidden="true"
          >
            <path d="M16 28V13" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            <path d="M16 13C16 13 16.5 6 24 5C24 5 24 12 16 13Z" fill="currentColor" />
            <path d="M16 13C16 13 15.5 6 8 5C8 5 8 12 16 13Z" fill="currentColor" fill-opacity="0.7" />
            <path d="M16 18C16 18 16.2 21 19.5 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <path d="M16 21C16 21 15.8 24 12.5 25" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          <span class="text-sm font-semibold text-fg">Grove</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-subtle">
          The open-source framework for publishing structured knowledge from files.
        </p>
        <a
          href="https://github.com/tortuvshin/grove"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 rounded-lg border border-border bg-card px-3 py-1.5 text-xs font-medium text-fg no-underline transition-colors hover:border-brand/40 hover:bg-card-hover"
        >
          <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.34c-2.22.48-2.69-1.07-2.69-1.07-.36-.92-.89-1.16-.89-1.16-.73-.5.06-.49.06-.49.8.06 1.22.83 1.22.83.72 1.23 1.88.87 2.34.67.07-.52.28-.87.51-1.07-1.77-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.22 2.2.82a7.66 7.66 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8 8 0 0 0 16 0z" />
          </svg>
          Star on GitHub
        </a>
      </div>

      {columns.map((col) => (
        <div>
          <h3 class="m-0 text-xs font-semibold uppercase tracking-widest text-fg">
            {col.heading}
          </h3>
          <ul class="mt-4 m-0 flex list-none flex-col gap-2.5 p-0">
            {col.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  target={item.external ? '_blank' : undefined}
                  rel={item.external ? 'noopener noreferrer' : undefined}
                  class="text-sm text-muted no-underline transition-colors hover:text-fg"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-3 border-t border-border/60 pt-6 sm:flex-row sm:items-center">
      <p class="text-xs text-subtle">
        © {year} Grove · MIT licensed
      </p>
      <p class="text-xs text-subtle">
        Made by <a href="https://github.com/tortuvshin" target="_blank" rel="noopener noreferrer" class="text-inherit underline decoration-dotted decoration-subtle underline-offset-2 hover:text-muted">tortuvshin</a> and contributors
      </p>
    </div>
  </div>
</footer>