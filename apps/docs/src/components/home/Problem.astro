---
import SectionHeader from './SectionHeader.astro';

const pairs = [
  {
    problem: 'Structure drifts',
    pain: 'Contributors invent fields, naming, and categories, and the collection stops being one dataset.',
    answer: 'Records are typed YAML validated against a blueprint schema. Drift fails CI before it merges.',
    command: 'grove check',
    color: 'text-accent-teal',
    top: 'border-t-accent-teal/40',
    icon: 'file',
  },
  {
    problem: 'Metadata goes stale',
    pain: 'Archived projects and dead links stay listed because nobody re-checks hundreds of entries by hand.',
    answer: 'Repository signals refresh on a schedule, and status, tier, and visibility are recomputed from them.',
    command: 'grove sync github',
    color: 'text-accent-green',
    top: 'border-t-accent-green/40',
    icon: 'git',
  },
  {
    problem: 'Curation is unauditable',
    pain: 'Entries appear and vanish with no trail. Six months later nobody remembers why.',
    answer: 'Every change is a pull request, and overrides live in decisions.yml with a written reason.',
    command: 'git log data/records/',
    color: 'text-accent-orange',
    top: 'border-t-accent-orange/40',
    icon: 'shield',
  },
];
---

<section class="mx-auto max-w-7xl px-6 py-24" aria-labelledby="problem-title">
  <SectionHeader
    eyebrow="The problem"
    title="Community lists rot."
    titleId="problem-title"
    lede="A README or a spreadsheet works until the collection becomes shared infrastructure. Then three things break — and stay broken, because fixing them is manual."
  />

  <div class="mt-14 grid grid-cols-1 gap-4 lg:grid-cols-3">
    {pairs.map((pair) => (
      <article class={`group flex flex-col rounded-xl border border-border border-t-2 ${pair.top} bg-card p-6 transition-[transform,background-color,border-color] hover:-translate-y-0.5 hover:bg-card-hover`}>
        <div class={`flex size-10 items-center justify-center rounded-lg border border-border-strong bg-surface ${pair.color}`}>
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {pair.icon === 'file' && (
              <>
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <path d="M14 2v6h6" />
              </>
            )}
            {pair.icon === 'git' && (
              <>
                <circle cx="18" cy="6" r="3" />
                <circle cx="6" cy="18" r="3" />
                <path d="M18 9a9 9 0 0 1-9 9" />
              </>
            )}
            {pair.icon === 'shield' && (
              <>
                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z" />
              </>
            )}
          </svg>
        </div>
        <h3 class="mt-5 text-base font-semibold text-fg">{pair.problem}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{pair.pain}</p>
        <div class="mt-5 border-t border-border pt-4">
          <p class="text-sm leading-relaxed text-muted"><span class="font-semibold text-fg">Grove:</span> {pair.answer}</p>
          <p class={`mt-3 inline-flex items-center gap-2 rounded-md border border-border bg-surface px-3 py-1.5 font-mono text-[11px] ${pair.color}`}>
            <span class="text-subtle">$</span>{pair.command}
          </p>
        </div>
      </article>
    ))}
  </div>
</section>
