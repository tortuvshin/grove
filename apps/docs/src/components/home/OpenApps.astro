---
import SectionHeader from './SectionHeader.astro';

const records = [
  { name: 'Immich', category: 'Media', stack: 'TypeScript', status: 'active' },
  { name: 'Joplin', category: 'Productivity', stack: 'TypeScript', status: 'mature' },
  { name: 'Linkwarden', category: 'Knowledge', stack: 'Next.js', status: 'active' },
];
---

<section id="open-apps" class="mx-auto max-w-7xl px-6 py-24" aria-labelledby="open-apps-title">
  <div class="grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-center lg:gap-20">
    <div>
      <SectionHeader
        eyebrow="Production reference"
        title="Grove grew out of maintaining Open Apps."
        titleId="open-apps-title"
        lede="Open Apps is a live directory with file-backed records, repository refresh, search, filters, detail pages, a sitemap, and AI-readable outputs. Grove turns that operating model into a reusable framework."
        maxWidth="narrow"
      />
      <p class="mt-5 max-w-xl border-l-2 border-accent-orange/50 pl-4 text-sm leading-relaxed text-subtle">
        The live repository still carries local versions of this logic. Migration to the published Grove packages is the next reference-space milestone.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="https://open-apps.dev.mn" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-fg px-5 py-2.5 text-sm font-semibold text-bg transition-opacity hover:opacity-90">Explore the live space</a>
        <a href="https://github.com/tortuvshin/open-apps" target="_blank" rel="noopener noreferrer" class="rounded-lg border border-border-strong bg-card px-5 py-2.5 text-sm font-semibold text-fg transition-colors hover:bg-card-hover">Inspect the source</a>
      </div>
    </div>

    <div class="relative">
    <div class="grove-glow" aria-hidden="true"></div>
    <div class="overflow-hidden rounded-xl border border-border-strong bg-bg shadow-2xl shadow-black/20" aria-label="Open Apps product preview">
      <div class="flex items-center gap-2 border-b border-border px-4 py-3">
        <span class="size-3 rounded-full bg-[#ff5f57]"></span><span class="size-3 rounded-full bg-[#febc2e]"></span><span class="size-3 rounded-full bg-[#28c840]"></span>
        <span class="mx-auto rounded-md border border-border bg-surface px-8 py-1 font-mono text-[10px] text-subtle">open-apps.dev.mn/apps</span>
      </div>
      <div class="p-5 sm:p-6">
        <div class="flex flex-col gap-4 border-b border-border pb-5 sm:flex-row sm:items-end sm:justify-between">
          <div><span class="font-mono text-[10px] uppercase tracking-widest text-accent-green">Open Apps</span><h3 class="mt-2 text-xl font-semibold text-fg">Explore real open-source apps</h3></div>
          <div class="flex gap-2 font-mono text-[10px] text-muted"><span class="rounded-md border border-border px-3 py-2">Search</span><span class="rounded-md border border-border px-3 py-2">Filter</span></div>
        </div>
        <div class="mt-4 space-y-2">
          {records.map((record) => (
            <div class="grid grid-cols-[1fr_auto] gap-4 rounded-lg border border-border bg-card p-4 sm:grid-cols-[1fr_0.7fr_auto] sm:items-center">
              <div><strong class="text-sm font-semibold text-fg">{record.name}</strong><span class="mt-1 block text-xs text-subtle">{record.category}</span></div>
              <span class="hidden font-mono text-xs text-muted sm:block">{record.stack}</span>
              <span class="font-mono text-[10px] text-accent-green">{record.status}</span>
            </div>
          ))}
        </div>
        <div class="mt-4 grid grid-cols-3 gap-2 text-center font-mono text-[10px] text-subtle"><span class="rounded-md border border-border py-2">taxonomy</span><span class="rounded-md border border-border py-2">sitemap</span><span class="rounded-md border border-border py-2">llms.txt</span></div>
      </div>
    </div>
    </div>
  </div>
</section>
