---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import SectionHeader from './SectionHeader.astro';
// Real product screenshot, kept in step with the one the README ships
// (.github/assets/open-apps-home.png); replacing src/assets/open-apps-home.png
// swaps the preview without touching this component.
import openAppsShot from '../../assets/open-apps-home.png';

// The live space. `open-apps.dev.mn` — which this section used to link — no
// longer resolves at all; openappscout.com is the space the README documents
// and the screenshot above was taken from.
const LIVE_URL = 'https://openappscout.com';
const REPO_URL = 'https://github.com/tortuvshin/open-apps';
---

<section id="open-apps" class="mx-auto max-w-7xl px-6 py-24" aria-labelledby="open-apps-title">
  <div class="grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-center lg:gap-20">
    <div>
      <SectionHeader
        eyebrow="Production reference"
        title="Grove grew out of maintaining Open Apps."
        titleId="open-apps-title"
        lede="Every step you just scrolled through runs in production at Open Apps: file-backed records, repository refresh, search, filters, detail pages, a sitemap, and AI-readable outputs. Grove turns that operating model into a reusable framework."
        maxWidth="narrow"
      />
      <p class="mt-5 max-w-xl border-l-2 border-accent-orange/50 pl-4 text-sm leading-relaxed text-subtle">
        The live repository still carries local versions of this logic. Migration to the published Grove packages is the next reference-space milestone.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={LIVE_URL} external>Explore the live space</Button>
        <Button href={REPO_URL} variant="secondary" external>Inspect the source</Button>
      </div>
    </div>

    <div class="relative isolate">
    <div class="grove-glow" aria-hidden="true"></div>
    <div class="overflow-hidden rounded-2xl border border-border-strong bg-bg/95 shadow-[0_40px_100px_-30px_rgb(39_183_200_/_0.2)] backdrop-blur" aria-label="Open Apps product preview">
      <div class="flex items-center gap-2 border-b border-border px-4 py-3">
        <span class="size-3 rounded-full bg-[#ff5f57]"></span><span class="size-3 rounded-full bg-[#febc2e]"></span><span class="size-3 rounded-full bg-[#28c840]"></span>
        <span class="mx-auto rounded-full border border-border bg-surface px-6 py-1 font-mono text-[11px] text-subtle">openappscout.com</span>
        <span class="size-3" aria-hidden="true"></span>
      </div>
      <Image
        src={openAppsShot}
        alt="The Open Apps home page: a search box over a curated directory, ecosystem counts for indexed apps, categories, stacks and owners, and a row of actively developed applications"
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 640px, 100vw"
        format="webp"
        loading="lazy"
        class="block w-full"
      />
    </div>
    </div>
  </div>
</section>
