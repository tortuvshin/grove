---
import SectionHeader from './SectionHeader.astro';

const tagStyles: Record<string, string> = {
  'Available today': 'border-accent-green/40 bg-accent-green/10 text-accent-green',
  'Schema available': 'border-accent-blue/40 bg-accent-blue/10 text-accent-blue',
  'Import path': 'border-accent-orange/40 bg-accent-orange/10 text-accent-orange',
};

const blueprints = [
  {
    name: 'Project directories',
    desc: 'Developer tools, open-source apps, packages, services, or internal systems.',
    tag: 'Available today',
    color: 'text-accent-green',
    icon: 'star',
  },
  {
    name: 'Resource hubs',
    desc: 'Guides, comparisons, explainers, learning collections, and curated links.',
    tag: 'Schema available',
    color: 'text-accent-blue',
    icon: 'book',
  },
  {
    name: 'Ecosystem maps',
    desc: 'Organizations, products, communities, schools, and local ecosystem actors.',
    tag: 'Schema available',
    color: 'text-accent-teal',
    icon: 'users',
  },
  {
    name: 'Maintained awesome lists',
    desc: 'Import a Markdown collection, then add structure, review, and static discovery.',
    tag: 'Import path',
    color: 'text-accent-orange',
    icon: 'grid',
  },
];

// Honest renderer status — only Astro ships today (see the audit note that
// removed the 8-logo matrix). The CLI refuses --framework for the rest.
const renderers = [
  { src: '/logos/astro.svg', name: 'Astro', note: 'Supported today', supported: true },
  { src: '/logos/svelte.svg', name: 'SvelteKit', note: 'Planned V1.1', supported: false },
  { src: '/logos/nextdotjs.svg', name: 'Next.js', note: 'Planned V1.2', supported: false },
];
---

<section class="mx-auto max-w-7xl px-6 py-24" aria-labelledby="build-title">
  <SectionHeader
    eyebrow="Blueprints"
    title="Start with a directory. Grow into more."
    titleId="build-title"
    lede="Grove's record model supports three typed blueprints, plus an import path for existing awesome lists. The polished default frontend ships for project directories today."
    maxWidth="narrow"
  />

  <div class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {blueprints.map((b) => (
      <article class="group flex flex-col rounded-xl border border-border bg-card p-6 transition-[transform,background-color,border-color] hover:-translate-y-0.5 hover:border-border-strong hover:bg-card-hover">
        <div class={`flex size-10 items-center justify-center rounded-lg border border-border-strong bg-surface ${b.color}`}>
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            {b.icon === 'star' && (
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            )}
            {b.icon === 'book' && (
              <>
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
              </>
            )}
            {b.icon === 'users' && (
              <>
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </>
            )}
            {b.icon === 'grid' && (
              <>
                <rect x="3" y="3" width="7" height="7" rx="1" />
                <rect x="14" y="3" width="7" height="7" rx="1" />
                <rect x="3" y="14" width="7" height="7" rx="1" />
                <rect x="14" y="14" width="7" height="7" rx="1" />
              </>
            )}
          </svg>
        </div>
        <span class={`mt-5 inline-flex w-fit items-center rounded-full border px-2 py-0.5 text-xs font-medium uppercase tracking-wide ${tagStyles[b.tag] ?? 'border-border bg-surface text-subtle'}`}>
          {b.tag}
        </span>
        <h3 class="mt-1.5 text-base font-semibold text-fg">{b.name}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{b.desc}</p>
      </article>
    ))}
  </div>

  <div class="mt-6 flex flex-col gap-4 rounded-xl border border-border bg-card p-6 sm:flex-row sm:items-center sm:justify-between">
    <ul class="flex flex-wrap gap-3">
      {renderers.map((r) => (
        <li class={`flex items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3 ${r.supported ? '' : 'opacity-75'}`}>
          <img
            src={r.src}
            alt={`${r.name} logo`}
            width="24"
            height="24"
            loading="lazy"
            decoding="async"
            class={`h-6 w-6 object-contain ${r.supported ? '' : 'grayscale'}`}
          />
          <div>
            <p class="text-sm font-semibold text-fg">{r.name}</p>
            <p class={`text-xs ${r.supported ? 'text-accent-green' : 'text-muted'}`}>{r.note}</p>
          </div>
        </li>
      ))}
    </ul>
    <p class="max-w-xs text-xs leading-relaxed text-muted">
      The lifecycle is headless; the frontend is replaceable. The CLI refuses
      <code class="font-mono text-[11px]">--framework</code> until an adapter actually ships.
    </p>
  </div>
</section>
