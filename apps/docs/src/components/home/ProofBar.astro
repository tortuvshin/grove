---
// Every figure is verified against the repository: packages/ (npm packages),
// packages/cli/src/index.ts (commands), packages/astro/src/components
// (components), the vitest unit project (tests), packages/cli/src/audit.ts
// (Lighthouse budget). Update alongside the code, never round up.
const proofs = [
  { value: '4', label: 'npm packages' },
  { value: '8', label: 'CLI commands' },
  { value: '37', label: 'Astro components' },
  { value: '400+', label: 'unit tests' },
  { value: '100×4', label: 'Lighthouse CI gate' },
  { value: 'MIT', label: 'licensed' },
];
---

<section class="border-b border-border/60 bg-surface/40" aria-label="Project scale, verified against the repository">
  <div class="mx-auto max-w-7xl px-6 py-8">
    <p class="text-center text-xs font-medium uppercase tracking-widest text-subtle">
      Built in the open — every number checked against the source
    </p>
    <ul class="mt-5 flex flex-wrap items-center justify-center gap-x-10 gap-y-3">
      {proofs.map((proof) => (
        <li class="flex items-baseline gap-2 font-mono text-xs text-subtle">
          <span class="text-base font-semibold text-fg">{proof.value}</span>
          {proof.label}
        </li>
      ))}
    </ul>
  </div>
</section>
