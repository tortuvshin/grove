---
// Grove hero — the landing story's first frame, sized to fill the screen
// below the sticky header and split into two columns. The left column
// carries the pitch (badge, headline, one sentence, three calls to action);
// the right carries the transformation diagram, so what Grove produces is
// visible in the first frame instead of halfway down the page. Below `lg`
// the columns stack and the pitch re-centers.
import Button from './Button.astro';
import Pipeline from './Pipeline.astro';

// Tracks the published package version. release-please rewrites this line
// on every release via the `extra-files` entry in release-please-config.json
// — the trailing annotation is load-bearing, do not drop it. It sat at v0.6
// through three releases before anyone noticed.
const version = '0.9.0'; // x-release-please-version
---

<!-- `isolate` gives the section its own stacking context, so the z-index -1
     aurora layers paint above the body background instead of being buried
     underneath it. -->
<section
  id="hero-section"
  class="relative isolate flex items-center overflow-hidden"
  aria-labelledby="hero-title"
>
  <div class="hero-beams" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-6xl px-6 py-16">
    <!-- Even columns: the diagram needs the width to keep its four input
         chips on one line, and the pitch reads fine at half of max-w-6xl. -->
    <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
        <a
          href="/project/roadmap/"
          class="inline-flex items-center gap-2 rounded-full border border-border bg-card/70 px-3.5 py-1 text-xs font-medium text-muted backdrop-blur transition-colors hover:border-border-strong hover:text-fg"
        >
          Grove v{version}
          <span class="text-border-strong" aria-hidden="true">·</span>
          Open source
        </a>

        <h1
          id="hero-title"
          class="mt-8 max-w-3xl text-balance text-5xl font-bold leading-[1.08] tracking-tight text-fg sm:text-6xl md:text-[68px] lg:text-[56px] xl:text-[64px]"
        >
          Publish structured knowledge <span class="text-gradient text-gradient-live">that stays current.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-pretty text-lg leading-relaxed text-muted sm:text-xl">
          Directories, catalogs, handbooks, reference sites — keep the source in plain files, and Grove turns it into a searchable site plus every machine-readable output around it.
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
          <Button href="/getting-started/scaffold/">Get started</Button>
          <Button href="/introduction/" variant="secondary">Read the docs</Button>
          <Button href="https://github.com/tortuvshin/grove" variant="secondary" external>
            <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z"></path>
            </svg>
            View on GitHub
          </Button>
        </div>

        <p class="mt-8 text-sm text-subtle">No database · No CMS · MIT licensed</p>
      </div>

      <Pipeline />
    </div>
  </div>
</section>

<style>
  /* Fills the screen under the sticky h-16 header, so the first frame is the
     hero and nothing else. `svh` keeps mobile browser chrome from pushing the
     next section into view; `vh` is the fallback for engines without it.
     These are minimums — on narrow viewports the stacked columns simply grow
     past them rather than being clipped. */
  #hero-section {
    min-height: calc(100vh - 4rem);
    min-height: calc(100svh - 4rem);
  }
</style>

<script is:inline>
  (() => {
    // Aurora field follows the pointer, desktop only.
    if (
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      !window.matchMedia('(pointer: fine)').matches
    ) {
      return;
    }
    const hero = document.getElementById('hero-section');
    if (!hero) return;
    hero.addEventListener('pointermove', (event) => {
      const rect = hero.getBoundingClientRect();
      hero.style.setProperty('--mx', `${(((event.clientX - rect.left) / rect.width) * 100).toFixed(1)}%`);
      hero.style.setProperty('--my', `${(((event.clientY - rect.top) / rect.height) * 100).toFixed(1)}%`);
    });
  })();
</script>
