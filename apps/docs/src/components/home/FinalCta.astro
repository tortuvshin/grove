---
import Button from './Button.astro';

// One command, four runners. The scaffold itself is pnpm-based, so pnpm is
// the default tab; the other runners only change how the CLI is fetched.
const pms = [
  { id: 'npm', label: 'npm', command: 'npx @grove-dev/cli@latest init my-space' },
  { id: 'pnpm', label: 'pnpm', command: 'pnpm dlx @grove-dev/cli@latest init my-space' },
  { id: 'yarn', label: 'yarn', command: 'yarn dlx @grove-dev/cli@latest init my-space' },
  { id: 'bun', label: 'bun', command: 'bunx @grove-dev/cli@latest init my-space' },
];
const defaultPm = 'pnpm';
---

<section class="relative overflow-hidden border-t border-border/60" aria-labelledby="final-cta-title">
  <div class="cta-gradient absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-3xl px-6 py-24 text-center sm:py-28">
    <h2
      id="final-cta-title"
      class="mx-auto max-w-2xl text-balance text-4xl font-bold leading-[1.06] tracking-tight text-fg sm:text-5xl"
    >
      Start growing with Grove.
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-muted">
      Turn structured files and Markdown into a curated, searchable site that stays useful — with the maintenance on rails. No CMS or runtime database required.
    </p>
    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <Button href="/getting-started/create-a-space/" class="w-full sm:w-auto">
        Read the quick start
      </Button>
      <Button
        href="https://github.com/tortuvshin/grove"
        variant="secondary"
        external
        class="w-full sm:w-auto"
      >
        View on GitHub
      </Button>
    </div>

    <div id="install-tabs" class="mx-auto mt-10 max-w-md rounded-lg border border-border-strong bg-bg/70 text-left backdrop-blur">
      <div class="flex items-center gap-1 border-b border-border px-2 pt-1.5" role="tablist" aria-label="Choose a package manager">
        {pms.map((pm) => (
          <button
            type="button"
            role="tab"
            id={`pm-tab-${pm.id}`}
            aria-controls={`pm-panel-${pm.id}`}
            aria-selected={pm.id === defaultPm ? 'true' : 'false'}
            tabindex={pm.id === defaultPm ? 0 : -1}
            data-pm={pm.id}
            class="pm-tab rounded-t-md px-3 py-1.5 font-mono text-xs text-subtle transition-colors hover:text-fg"
          >
            {pm.label}
          </button>
        ))}
      </div>
      {pms.map((pm) => (
        <div
          role="tabpanel"
          id={`pm-panel-${pm.id}`}
          aria-labelledby={`pm-tab-${pm.id}`}
          hidden={pm.id !== defaultPm}
        >
          <div class="flex items-center gap-2 px-4 py-2.5 font-mono text-[13px]">
            <span class="text-subtle" aria-hidden="true">$</span>
            <code class="min-w-0 flex-1 truncate text-fg" data-command>{pm.command}</code>
            <button
              type="button"
              class="pm-copy shrink-0 rounded-sm p-1 text-subtle transition-colors hover:text-fg"
              aria-label={`Copy the ${pm.label} command`}
            >
              <svg class="pm-copy-icon size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
              <svg class="pm-check-icon hidden size-3.5 text-accent-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
            </button>
          </div>
        </div>
      ))}
      <span class="sr-only" aria-live="polite" data-copy-status></span>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    // Package-manager tabs + copy. Without JS the pnpm panel is already
    // visible (the others render with `hidden`), so this is enhancement only.
    const root = document.getElementById('install-tabs');
    if (!root) return;
    const tabs = [...root.querySelectorAll('[role="tab"]')];
    const panels = [...root.querySelectorAll('[role="tabpanel"]')];
    const status = root.querySelector('[data-copy-status]');
    if (!tabs.length || !panels.length) return;

    const select = (tab) => {
      for (const other of tabs) {
        const active = other === tab;
        other.setAttribute('aria-selected', String(active));
        other.tabIndex = active ? 0 : -1;
      }
      for (const panel of panels) {
        panel.hidden = panel.id !== tab.getAttribute('aria-controls');
      }
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const dir = e.key === 'ArrowRight' ? 1 : -1;
        const next = tabs[(i + dir + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });

    for (const btn of root.querySelectorAll('.pm-copy')) {
      btn.addEventListener('click', async () => {
        const command = btn.closest('[role="tabpanel"]')?.querySelector('[data-command]');
        if (!command || !navigator.clipboard) return;
        try {
          await navigator.clipboard.writeText(command.textContent ?? '');
        } catch {
          return;
        }
        btn.querySelector('.pm-copy-icon')?.classList.add('hidden');
        btn.querySelector('.pm-check-icon')?.classList.remove('hidden');
        if (status) status.textContent = 'Copied';
        setTimeout(() => {
          btn.querySelector('.pm-copy-icon')?.classList.remove('hidden');
          btn.querySelector('.pm-check-icon')?.classList.add('hidden');
          if (status) status.textContent = '';
        }, 1500);
      });
    }
  })();
</script>

<style>
  /* Restrained teal finale: enough depth to close the page without turning
     the section into a saturated full-bleed light field. */
  .cta-gradient {
    background:
      radial-gradient(90% 120% at 50% 115%, rgb(39 183 200 / 0.3), transparent 70%),
      radial-gradient(55% 75% at 18% 110%, rgb(125 211 216 / 0.12), transparent 72%),
      radial-gradient(55% 75% at 82% 110%, rgb(39 183 200 / 0.1), transparent 72%);
  }

  .pm-tab[aria-selected='true'] {
    color: var(--color-fg);
    box-shadow: inset 0 -2px 0 var(--color-brand);
  }
</style>
