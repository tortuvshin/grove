---
---

<section class="relative overflow-hidden border-t border-border/60" aria-labelledby="final-cta-title">
  <div class="cta-gradient absolute inset-0" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-3xl px-6 py-24 text-center sm:py-28">
    <h2
      id="final-cta-title"
      class="mx-auto max-w-2xl text-balance text-4xl font-bold leading-[1.06] tracking-tight text-fg sm:text-5xl"
    >
      Start growing with Grove.
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-muted">
      Turn structured files and Markdown into a curated, searchable site that stays useful — with the maintenance on rails. No CMS or runtime database required.
    </p>
    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/getting-started/create-a-space/"
        class="inline-flex w-full items-center justify-center rounded-lg bg-fg px-6 py-2.5 text-sm font-semibold text-bg transition-opacity hover:opacity-90 sm:w-auto"
      >
        Read the quick start
      </a>
      <a
        href="https://github.com/tortuvshin/grove"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center rounded-lg border border-border-strong bg-bg/40 px-6 py-2.5 text-sm font-semibold text-fg backdrop-blur transition-colors hover:bg-bg/60 sm:w-auto"
      >
        View on GitHub
      </a>
    </div>

    <div class="mt-10 inline-flex items-center gap-2 rounded-lg border border-border-strong bg-bg/70 px-4 py-2.5 font-mono text-[13px] backdrop-blur">
      <span class="text-subtle">$</span>
      <span class="text-fg">pnpm dlx @grove-dev/cli@latest init my-space</span>
    </div>
  </div>
</section>

<style>
  /* Full-bleed brand-gradient band, vite.dev style — saturated at the bottom,
     fading up into the page canvas so the section reads as a finale. */
  .cta-gradient {
    background:
      radial-gradient(90% 120% at 50% 115%, rgb(100 108 255 / 0.5), transparent 70%),
      radial-gradient(60% 80% at 20% 110%, rgb(65 209 255 / 0.28), transparent 70%),
      radial-gradient(60% 80% at 80% 110%, rgb(189 52 254 / 0.32), transparent 70%);
  }
</style>
