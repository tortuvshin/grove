---
---

<section class="mx-auto max-w-7xl px-6 py-24" aria-labelledby="final-cta-title">
  <div
    class="relative overflow-hidden rounded-2xl border border-border-strong bg-card px-6 py-16 text-center sm:px-12"
  >
    <div class="grove-glow" aria-hidden="true"></div>
    <h2
      id="final-cta-title"
      class="mx-auto max-w-2xl font-display text-balance text-4xl font-bold leading-[1.1] tracking-tight text-fg sm:text-5xl"
    >
      Start with the Astro implementation.
    </h2>
    <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-muted">
      Inspect the example, read the architecture, and build a space from plain files. No CMS or runtime database required.
    </p>
    <div
      class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row"
    >
      <a
        href="/getting-started/create-a-space/"
        class="inline-flex w-full items-center justify-center rounded-md bg-accent-green px-6 py-2.5 text-sm font-semibold text-bg transition-opacity hover:opacity-90 sm:w-auto"
      >
        Read the quick start
      </a>
      <a
        href="https://github.com/tortuvshin/grove"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full items-center justify-center rounded-md border border-border-strong bg-surface px-6 py-2.5 text-sm font-semibold text-fg transition-colors hover:bg-card-hover sm:w-auto"
      >
        View on GitHub
      </a>
    </div>

    <div
      class="mt-10 inline-flex items-center gap-2 rounded-md border border-border bg-bg px-4 py-2.5 font-mono text-[13px]"
    >
      <span class="text-subtle">$</span>
      <span class="text-fg">pnpm dlx @grove-dev/cli@latest init my-space</span>
    </div>
  </div>
</section>
