---
// "One source, every surface" — the transformation diagram that now lives in
// the hero's right column: the plain files you write flow down through Grove
// and come out as a complete website plus every artifact around it (SEO files,
// AI indexes, README, JSON data).
//
// The flow reads top to bottom at every width, so unlike the old standalone
// section there is no separate mobile layout to fall back to. Without JS (or
// with reduced motion) everything renders visible and static; JS only adds the
// connector paths, the staged reveal, and the traveling pulses. The connectors
// are drawn from measured DOM positions, so the rows are plain flex/grid
// layout and nothing can overlap or distort.

const inputs = ['YAML records', 'Markdown', 'Collections', 'Taxonomy'];

// Every output is real: the site capabilities ship with @grove-dev/astro, the
// public files come from GENERATED_PUBLIC_NAMES in packages/cli, the README
// from `grove readme generate`, the JSON from data/generated/.
const groups = [
  { title: 'Website', items: ['Search', 'Filters', 'Lenses', 'Collections', 'Detail pages'] },
  { title: 'SEO', items: ['sitemap.xml', 'robots.txt', 'og-image.svg'] },
  { title: 'AI-ready', items: ['llms.txt', 'llms-full.txt'] },
  { title: 'Repo', items: ['README.md', 'JSON data'] },
];
---

<div
  id="pipeline-stage"
  class="relative w-full overflow-hidden rounded-lg border border-border bg-surface/60 px-5 py-7 sm:px-7 sm:py-9"
>
  <div class="pipeline-gridbg absolute inset-0" aria-hidden="true"></div>
  <svg id="pipeline-paths" class="absolute inset-0 h-full w-full" fill="none" aria-hidden="true"></svg>

  <div class="relative flex flex-col items-center gap-8">
    <!-- The section's phrase stays with the diagram, but as a label rather
         than a heading: the hero owns the page's only <h1>. -->
    <p class="font-mono text-[10px] uppercase tracking-widest text-subtle">
      One source, every surface
    </p>

    <!-- The four chips are sized to stay on one line down to the `lg`
         breakpoint, where the column is at its narrowest. A wrapped row
         orphans the last chip and leaves its connector crossing the others. -->
    <ul class="flex flex-wrap justify-center gap-1.5" aria-label="The files you write">
      {
        inputs.map((label, i) => (
          <li
            class="pipeline-node pipeline-in whitespace-nowrap rounded-full border border-border bg-card px-3 py-1.5 font-mono text-[11px] text-fg"
            style={`--d: ${i * 90}ms`}
          >
            {label}
          </li>
        ))
      }
    </ul>

    <div
      class="pipeline-node pipeline-core flex flex-col items-center gap-1 rounded-xl border border-brand/40 bg-brand/10 px-7 py-4 shadow-[0_0_48px_-8px_rgb(39_183_200/0.65)] backdrop-blur-sm"
      style="--d: 380ms"
    >
      <span class="text-xl font-semibold tracking-tight text-brand-light">Grove</span>
      <span class="font-mono text-[10px] uppercase tracking-widest text-subtle"
        >one command build</span
      >
    </div>

    <ul class="grid w-full grid-cols-2 gap-2.5" aria-label="Everything Grove generates">
      {
        groups.map((group, i) => (
          <li
            class="pipeline-node pipeline-out rounded-lg border border-border bg-card/90 p-3"
            style={`--d: ${520 + i * 130}ms`}
          >
            <h3 class="font-mono text-[10px] uppercase tracking-widest text-brand-light">
              {group.title}
            </h3>
            <ul class="mt-2 flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li class="rounded-full border border-border/80 bg-surface px-2 py-0.5 font-mono text-[10px] text-muted">
                  {item}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style is:global>
  #pipeline-stage .pipeline-gridbg {
    opacity: 0.5;
    background-image:
      linear-gradient(to right, rgb(54 86 102 / 0.3) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(54 86 102 / 0.3) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(120% 120% at 50% 50%, black 55%, transparent 100%);
    mask-image: radial-gradient(120% 120% at 50% 50%, black 55%, transparent 100%);
  }

  /* Staged reveal. Nodes are hidden only after JS tags the stage as
     .pipeline-ready (never without JS, never with reduced motion), then
     .is-inview reveals them on their per-node --d delay. */
  #pipeline-stage.pipeline-ready .pipeline-node {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.6s cubic-bezier(0.2, 0.6, 0.2, 1),
      transform 0.6s cubic-bezier(0.2, 0.6, 0.2, 1);
    transition-delay: var(--d, 0ms);
  }

  #pipeline-stage.pipeline-ready .pipeline-core {
    transform: scale(0.92);
  }

  #pipeline-stage.pipeline-ready.is-inview .pipeline-node {
    opacity: 1;
    transform: none;
  }

  /* Connector paths are created by JS, so their styles must be global. */
  #pipeline-paths .pipeline-path {
    stroke: var(--color-border-strong);
    stroke-width: 1;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    opacity: 0.8;
    transition: stroke-dashoffset 0.9s cubic-bezier(0.2, 0.6, 0.2, 1);
    transition-delay: var(--d, 0ms);
  }

  #pipeline-paths .pipeline-path.pipeline-path-out {
    stroke: var(--color-brand);
    opacity: 0.5;
  }

  #pipeline-stage.is-inview .pipeline-path {
    stroke-dashoffset: 0;
  }

  /* A quiet pulse travels each connector once the reveal has finished. */
  #pipeline-paths .pipeline-pulse {
    stroke: var(--color-brand-light);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: 6 94;
    stroke-dashoffset: 100;
    opacity: 0;
  }

  #pipeline-stage.is-inview .pipeline-pulse {
    animation: pipeline-pulse 3.6s linear infinite;
    animation-delay: var(--d, 0ms);
  }

  @keyframes pipeline-pulse {
    0% {
      stroke-dashoffset: 100;
      opacity: 0;
    }
    12% {
      opacity: 0.85;
    }
    58% {
      stroke-dashoffset: 0;
      opacity: 0.85;
    }
    66%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
</style>

<script is:inline>
  (() => {
    // Connector paths + staged reveal. Enhancement only: without JS the rows
    // already read files → Grove → outputs top to bottom, just without the
    // lines. The geometry is vertical at every width, so unlike the old
    // three-column layout there is nothing to gate on viewport size.
    const stage = document.getElementById('pipeline-stage');
    const svg = document.getElementById('pipeline-paths');
    if (!stage || !svg) return;
    const core = stage.querySelector('.pipeline-core');
    const ins = [...stage.querySelectorAll('.pipeline-in')];
    const outs = [...stage.querySelectorAll('.pipeline-out')];
    if (!core || !ins.length || !outs.length) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const NS = 'http://www.w3.org/2000/svg';

    const draw = () => {
      svg.replaceChildren();
      const sr = stage.getBoundingClientRect();
      if (sr.width === 0) return;
      svg.setAttribute('viewBox', `0 0 ${sr.width} ${sr.height}`);
      svg.setAttribute('preserveAspectRatio', 'none');
      const cr = core.getBoundingClientRect();
      const coreT = { x: cr.left - sr.left + cr.width / 2, y: cr.top - sr.top };
      const coreB = { x: coreT.x, y: cr.bottom - sr.top };

      const connect = (from, to, cls, delay) => {
        const midY = (from.y + to.y) / 2;
        const d = `M ${from.x} ${from.y} C ${from.x} ${midY}, ${to.x} ${midY}, ${to.x} ${to.y}`;
        for (const [extra, pulseDelay] of [
          ['pipeline-path ' + cls, delay],
          ['pipeline-pulse', delay + 900],
        ]) {
          const path = document.createElementNS(NS, 'path');
          path.setAttribute('d', d);
          path.setAttribute('pathLength', '100');
          path.setAttribute('vector-effect', 'non-scaling-stroke');
          path.setAttribute('class', extra);
          path.style.setProperty('--d', `${pulseDelay}ms`);
          svg.appendChild(path);
        }
      };

      ins.forEach((el, i) => {
        const r = el.getBoundingClientRect();
        connect(
          { x: r.left - sr.left + r.width / 2, y: r.bottom - sr.top + 4 },
          { x: coreT.x, y: coreT.y - 4 },
          'pipeline-path-in',
          250 + i * 70,
        );
      });
      outs.forEach((el, i) => {
        const r = el.getBoundingClientRect();
        connect(
          { x: coreB.x, y: coreB.y + 4 },
          { x: r.left - sr.left + r.width / 2, y: r.top - sr.top - 4 },
          'pipeline-path-out',
          600 + i * 110,
        );
      });
    };

    const setup = () => {
      draw();
      if (reduced.matches || !('IntersectionObserver' in window)) {
        stage.classList.add('is-inview');
        return;
      }
      stage.classList.add('pipeline-ready');
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            stage.classList.add('is-inview');
            observer.disconnect();
          }
        },
        { threshold: 0.35 },
      );
      observer.observe(stage);
    };

    let raf = 0;
    window.addEventListener(
      'resize',
      () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          draw();
        });
      },
      { passive: true },
    );

    setup();
  })();
</script>
