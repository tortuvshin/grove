---
const stages = [
  { id: 'collect', title: 'Collect', desc: 'Issues, pull requests, or hand-authored records.', input: 'A community suggestion', action: 'Add a YAML record under data/records/.', control: 'Maintainers define what belongs.', output: 'data/records/<slug>.yml', command: 'pnpm exec grove init my-space' },
  { id: 'structure', title: 'Structure', desc: 'Typed records and shared taxonomies replace loose conventions.', input: 'An unstructured candidate', action: 'Map fields to the selected blueprint and taxonomy.', control: 'Maintainers own categories and wording.', output: 'A typed project, resource, or entity', command: 'kind: project\ncategory: self-hosted' },
  { id: 'validate', title: 'Validate', desc: 'Catch invalid records and taxonomy references before publishing.', input: 'Records + taxonomy files', action: 'Check schemas, slugs, decisions, health, and references.', control: 'Warnings can become strict CI failures.', output: 'Actionable validation results', command: 'pnpm exec grove check --strict' },
  { id: 'enrich', title: 'Enrich', desc: 'Optionally refresh repository evidence without replacing judgment.', input: 'A project with a repository URL', action: 'Fetch activity, releases, license, topics, and archive state.', control: 'Synced signals remain reviewable data.', output: 'Current repository metadata', command: 'pnpm exec grove sync github' },
  { id: 'review', title: 'Review', desc: 'Every content change remains a normal Git diff.', input: 'A proposed record change', action: 'Run checks in Actions and review the pull request.', control: 'A human makes the editorial decision.', output: 'Accepted, revised, or rejected change', command: 'git diff data/records/immich.yml' },
  { id: 'publish', title: 'Publish', desc: 'Generate portable data and a static website.', input: 'Reviewed records', action: 'Build JSON, sitemap, AI-readable files, and Astro pages.', control: 'Choose the host, routes, and presentation.', output: 'Static, cacheable output', command: 'pnpm exec grove check && astro build' },
  { id: 'maintain', title: 'Maintain', desc: 'Turn staleness into a repeatable review queue.', input: 'A growing, aging collection', action: 'Report stale, inactive, archived, and incomplete records.', control: 'Humans decide to keep, hide, or remove.', output: 'A focused maintenance report', command: 'pnpm exec grove cleanup --strict' },
];
---

<section id="how-it-works" class="mx-auto max-w-7xl px-6 py-20" aria-labelledby="get-started-title">
  <p class="text-xs font-semibold uppercase tracking-widest text-subtle">How Grove works</p>
  <h2 id="get-started-title" class="mt-5 max-w-3xl font-display text-balance text-4xl font-bold leading-[1.1] tracking-tight text-fg sm:text-5xl">
    One lifecycle, with maintainers in control.
  </h2>
  <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted">
    Grove automates repeatable checks and generation. It does not automate editorial judgment.
  </p>

  <div class="mt-14 grid grid-cols-1 gap-6 lg:grid-cols-[0.9fr_1.1fr]" data-lifecycle>
    <div class="flex flex-col gap-2" role="tablist" aria-label="Grove lifecycle stages">
      {stages.map((stage, i) => (
        <button
          type="button"
          role="tab"
          id={`stage-${stage.id}`}
          aria-controls={`stage-panel-${stage.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-stage={stage.id}
          class="lifecycle-step flex min-h-16 w-full items-start gap-4 rounded-xl border border-border bg-surface p-4 text-left transition-colors hover:bg-card"
        >
          <span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-border-strong bg-bg font-mono text-xs text-muted">0{i + 1}</span>
          <span class="min-w-0"><strong class="block text-sm font-semibold text-fg">{stage.title}</strong><span class="mt-1 block text-sm leading-relaxed text-muted">{stage.desc}</span></span>
        </button>
      ))}
    </div>

    <div class="overflow-hidden rounded-xl border border-border-strong bg-bg">
      <div class="flex items-center gap-2 border-b border-border px-4 py-3">
        <span class="size-3 rounded-full bg-[#ff5f57]"></span><span class="size-3 rounded-full bg-[#febc2e]"></span><span class="size-3 rounded-full bg-[#28c840]"></span>
        <span class="ml-3 font-mono text-xs text-subtle">grove — maintained knowledge lifecycle</span>
      </div>
      <div class="p-5 sm:p-7">
        {stages.map((stage) => (
          <div role="tabpanel" id={`stage-panel-${stage.id}`} aria-labelledby={`stage-${stage.id}`} data-panel={stage.id} class="lifecycle-panel">
            <p class="font-mono text-xs text-accent-green">✓ {stage.input}</p>
            <h3 class="mt-5 text-2xl font-semibold tracking-tight text-fg">{stage.title}</h3>
            <dl class="mt-6 grid gap-3 text-sm sm:grid-cols-2">
              <div class="rounded-lg border border-border bg-surface p-4"><dt class="font-mono text-[10px] uppercase tracking-wider text-subtle">Grove does</dt><dd class="mt-2 leading-relaxed text-muted">{stage.action}</dd></div>
              <div class="rounded-lg border border-border bg-surface p-4"><dt class="font-mono text-[10px] uppercase tracking-wider text-subtle">Maintainer controls</dt><dd class="mt-2 leading-relaxed text-muted">{stage.control}</dd></div>
            </dl>
            <div class="mt-4 rounded-lg border border-border bg-surface p-4"><span class="font-mono text-[10px] uppercase tracking-wider text-subtle">Output</span><p class="mt-2 text-sm text-fg">{stage.output}</p></div>
            <pre class="mt-5 overflow-x-auto rounded-lg border border-border bg-bg p-4 font-mono text-[12px] leading-6 text-muted"><code><span class="text-subtle">$</span> {stage.command}</code></pre>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-lifecycle]');
    if (!root) return;
    const tabs = [...root.querySelectorAll('[role="tab"]')];
    const panels = [...root.querySelectorAll('[role="tabpanel"]')];
    const activate = (tab, focus = true) => {
      tabs.forEach((item) => {
        const selected = item === tab;
        item.setAttribute('aria-selected', String(selected));
        item.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== tab.dataset.stage; });
      if (focus) tab.focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(tab, false));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        activate(tabs[next]);
      });
    });
    tabs.slice(1).forEach((_, index) => { panels[index + 1].hidden = true; });
  })();
</script>

<style>
  .lifecycle-step[aria-selected='true'] { border-color: var(--color-border-strong); background: var(--color-card); }
  .lifecycle-step[aria-selected='true'] > span:first-child { border-color: color-mix(in srgb, var(--color-accent-green) 55%, var(--color-border)); color: var(--color-accent-green); }
  .lifecycle-panel[hidden] { display: none; }
</style>
