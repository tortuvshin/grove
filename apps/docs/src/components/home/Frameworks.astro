---
import SectionHeader from './SectionHeader.astro';

// Honest framework support matrix.
// Audit finding (public-claim-matrix.md §A): the previous version displayed
// 8 framework logos at the same status. Reality: only Astro is supported
// today. SvelteKit and Next.js are skeleton adapters planned for V1.1 / V1.2.
const supported = [
  { src: '/logos/astro.svg', name: 'Astro', note: 'V1 supported renderer' },
];

const planned = [
  { src: '/logos/svelte.svg', name: 'SvelteKit', note: 'Skeleton · planned V1.1' },
  { src: '/logos/nextdotjs.svg', name: 'Next.js', note: 'Skeleton · planned V1.2' },
];

const packages = [
  { name: '@grove-dev/core', note: 'Schema + lifecycle' },
  { name: '@grove-dev/astro', note: 'Renderer + components' },
  { name: '@grove-dev/cli', note: 'Scaffold + commands' },
  { name: '@grove-dev/starlight', note: 'Docs theme' },
];
---

<section id="architecture" class="mx-auto max-w-7xl px-6 py-20" aria-labelledby="frameworks-title">
  <SectionHeader
    eyebrow="Architecture and status"
    title="Headless lifecycle. Replaceable frontend."
    titleId="frameworks-title"
    lede="Core owns the source model and generated data. UI owns framework-neutral primitives. An adapter renders the site. Your repository keeps the content, brand, and editorial rules."
  />

  <div class="mt-12 grid gap-6 md:grid-cols-3">
    <div class="rounded-xl border border-border bg-card p-6 transition-[transform,border-color] hover:-translate-y-0.5 hover:border-border-strong">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent-green">
        Supported today
      </p>
      <ul class="mt-5 flex flex-wrap gap-3">
        {
          supported.map((l) => (
            <li class="flex items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3">
              <img
                src={l.src}
                alt={`${l.name} logo`}
                width="24"
                height="24"
                loading="lazy"
                decoding="async"
                class="h-6 w-6 object-contain"
              />
              <div>
                <p class="text-sm font-semibold text-fg">{l.name}</p>
                <p class="text-xs text-muted">{l.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="rounded-xl border border-border bg-card p-6 transition-[transform,border-color] hover:-translate-y-0.5 hover:border-border-strong">
      <p class="text-xs font-semibold uppercase tracking-widest text-subtle">
        Planned adapters
      </p>
      <ul class="mt-5 flex flex-wrap gap-3">
        {
          planned.map((l) => (
            <li class="flex items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3 opacity-80">
              <img
                src={l.src}
                alt={`${l.name} logo`}
                width="24"
                height="24"
                loading="lazy"
                decoding="async"
                class="h-6 w-6 object-contain grayscale"
              />
              <div>
                <p class="text-sm font-semibold text-fg">{l.name}</p>
                <p class="text-xs text-muted">{l.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-xs text-muted">
        The CLI refuses <code class="font-mono text-[11px]">--framework &#123;svelte|nextjs&#125;</code>
        until the adapter ships components, layouts, and a working template.
      </p>
    </div>

    <div class="rounded-xl border border-border bg-card p-6 transition-[transform,border-color] hover:-translate-y-0.5 hover:border-border-strong">
      <p class="text-xs font-semibold uppercase tracking-widest text-subtle">
        Package boundaries
      </p>
      <ul class="mt-5 flex flex-wrap gap-3">
        {
          packages.map((l) => (
            <li class="flex items-center gap-3 rounded-lg border border-border bg-surface px-4 py-3">
              <span class="flex size-6 items-center justify-center rounded border border-border-strong font-mono text-[10px] text-accent-cyan" aria-hidden="true">{l.name.split('/')[1]?.[0]}</span>
              <div>
                <p class="font-mono text-xs font-semibold text-fg">{l.name}</p>
                <p class="text-xs text-muted">{l.note}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
