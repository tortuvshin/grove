---
import SectionHeader from './SectionHeader.astro';
import { FAQ_ITEMS } from '../../data/faq.ts';

const faqs = FAQ_ITEMS;
---

<section class="mx-auto max-w-4xl px-6 py-20" aria-labelledby="faq-title">
  <SectionHeader
    eyebrow="Common questions"
    title="Things people ask before adopting."
    titleId="faq-title"
  />

  <div class="mt-12 flex flex-col gap-3">
    {
      faqs.map((item, i) => (
        <details class="group rounded-xl border border-border bg-card open:bg-card-hover" open={i === 0}>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 text-base font-medium text-fg transition-colors hover:text-accent-cyan">
            <span>{item.q}</span>
            <svg
              class="size-5 shrink-0 text-muted transition-transform group-open:rotate-45"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M12 5v14M5 12h14"></path>
            </svg>
          </summary>
          <div class="px-6 pb-5 text-sm leading-relaxed text-muted">
            {item.a}
          </div>
        </details>
      ))
    }
  </div>
</section>