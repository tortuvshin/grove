---
import SectionHeader from './SectionHeader.astro';

const features = [
  {
    title: 'Structure drifts',
    desc: 'Fields, naming, and categories diverge as more people contribute.',
    color: 'text-accent-cyan',
    icon: 'file',
  },
  {
    title: 'Metadata goes stale',
    desc: 'Archived projects and old releases remain visible without a repeatable refresh.',
    color: 'text-accent-teal',
    icon: 'git',
  },
  {
    title: 'Review becomes cleanup',
    desc: 'Maintainers normalize every submission before they can judge its value.',
    color: 'text-accent-blue',
    icon: 'upload',
  },
  {
    title: 'Discovery becomes software',
    desc: 'Search, filters, routes, metadata, and sitemaps become another app to maintain.',
    color: 'text-accent-purple',
    icon: 'search',
  },
  {
    title: 'Machines receive fragments',
    desc: 'A README is readable, but it is not a predictable record set or generated context.',
    color: 'text-accent-green',
    icon: 'check',
  },
  {
    title: 'Maintenance lives in memory',
    desc: 'Quality depends on someone remembering what needs review and why.',
    color: 'text-accent-orange',
    icon: 'list',
  },
]
---

<section class="mx-auto max-w-7xl px-6 py-20" aria-labelledby="features-title">
  <SectionHeader
    eyebrow="The maintenance problem"
    title="Lists are easy to start and difficult to maintain."
    titleId="features-title"
    lede="A README or small static site works until the collection becomes shared infrastructure. Growth turns publishing into recurring maintenance work."
  />

  <div class="mt-14 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      features.map((f) => (
        <article class="group flex flex-col rounded-xl border border-border bg-card p-6 transition-[transform,background-color,border-color] hover:-translate-y-0.5 hover:border-border-strong hover:bg-card-hover">
          <div class={`flex size-10 items-center justify-center rounded-lg border border-border-strong bg-surface ${f.color}`}>
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {f.icon === 'file' && (
                <>
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                  <path d="M14 2v6h6" />
                </>
              )}
              {f.icon === 'git' && (
                <>
                  <circle cx="18" cy="6" r="3" />
                  <circle cx="6" cy="18" r="3" />
                  <path d="M18 9a9 9 0 0 1-9 9" />
                </>
              )}
              {f.icon === 'upload' && (
                <>
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <path d="M17 8l-5-5-5 5" />
                  <path d="M12 3v12" />
                </>
              )}
              {f.icon === 'search' && (
                <>
                  <circle cx="11" cy="11" r="8" />
                  <path d="m21 21-4.3-4.3" />
                </>
              )}
              {f.icon === 'check' && (
                <>
                  <path d="M20 6 9 17l-5-5" />
                </>
              )}
              {f.icon === 'list' && (
                <>
                  <line x1="8" y1="6" x2="21" y2="6" />
                  <line x1="8" y1="12" x2="21" y2="12" />
                  <line x1="8" y1="18" x2="21" y2="18" />
                  <line x1="3" y1="6" x2="3.01" y2="6" />
                  <line x1="3" y1="12" x2="3.01" y2="12" />
                  <line x1="3" y1="18" x2="3.01" y2="18" />
                </>
              )}
              {f.icon === 'database' && (
                <>
                  <ellipse cx="12" cy="5" rx="9" ry="3" />
                  <path d="M3 5v14a9 3 0 0 0 18 0V5" />
                  <path d="M3 12a9 3 0 0 0 18 0" />
                </>
              )}
              {f.icon === 'layout' && (
                <>
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <path d="M3 9h18" />
                  <path d="M9 21V9" />
                </>
              )}
            </svg>
          </div>
          <h3 class="mt-5 text-base font-semibold text-fg">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{f.desc}</p>
        </article>
      ))
    }
  </div>
</section>
