---
// The product in three outcomes rather than a flat feature wall: what Grove
// publishes, what it distributes, and what it keeps honest over time. Every
// bullet maps to shipped behavior — the generators in @grove-dev/core, the
// components in @grove-dev/astro, and the maintenance commands in the CLI.
const groups = [
  {
    icon: 'layout',
    eyebrow: 'Publish',
    title: 'A site people can actually use',
    body: 'Your records become a browsable, searchable site — not a wall of links.',
    points: [
      'Search and filters across every facet',
      'Rich Markdown pages per record',
      'Curated collections with a written why',
      'Category, stack, and license views',
    ],
  },
  {
    icon: 'share-2',
    eyebrow: 'Distribute',
    title: 'One source, every surface',
    body: 'The same files publish everywhere a reader or a machine looks for them.',
    points: [
      'Sitemap, robots, and canonical URLs',
      'Per-page social cards and JSON-LD',
      'A GitHub README that matches the site',
      'JSON datasets and llms.txt for AI tools',
    ],
  },
  {
    icon: 'refresh-cw',
    eyebrow: 'Maintain',
    title: 'Facts synchronized, judgment reviewable',
    body: 'Machines refresh what machines can know. You decide the rest, on the record.',
    points: [
      'Schema validation on every change',
      'GitHub metadata refreshed as reviewable diffs',
      'Stale and archived records queued for review',
      'Curator decisions recorded with their reasons',
    ],
  },
];

// Inline Lucide SVG path data (24×24, stroke-based). Copying the icons inline
// keeps the home components free of an icon-library dependency and matches
// the established pattern in Demo.astro and Hero.astro.
const ICONS = {
  layout:
    '<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>',
  'share-2':
    '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>',
  'refresh-cw':
    '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
};
---

<section id="features" class="relative" aria-labelledby="features-title">
  <div class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
    <header class="mx-auto max-w-2xl text-center">
      <h2 id="features-title" class="text-balance text-4xl font-bold tracking-tight text-fg sm:text-5xl">
        Publish once. <span class="text-gradient">Stay useful for years.</span>
      </h2>
      <p class="mt-5 text-pretty text-lg leading-relaxed text-muted">
        Facts stay synchronized. Judgment stays reviewable. Grove is the system that keeps both honest.
      </p>
    </header>

    <div class="mt-14 grid grid-cols-1 gap-4 md:grid-cols-3">
      {groups.map((group) => (
        <article class="feature-card group relative overflow-hidden rounded-xl border border-border bg-card p-7 transition-colors duration-300 hover:border-border-strong">
          <div class="feature-card-glow" aria-hidden="true"></div>
          <div class="relative flex size-12 items-center justify-center rounded-lg bg-surface text-brand-light" aria-hidden="true">
            <svg
              class="size-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={ICONS[group.icon]}
            />
          </div>
          <p class="relative mt-5 text-xs font-semibold uppercase tracking-widest text-subtle">{group.eyebrow}</p>
          <h3 class="relative mt-2 text-lg font-semibold text-fg">{group.title}</h3>
          <p class="relative mt-2 text-sm leading-relaxed text-muted">{group.body}</p>
          <ul class="relative mt-5 flex flex-col gap-2.5 border-t border-border/60 pt-5">
            {group.points.map((point) => (
              <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted">
                <svg class="mt-1 size-3.5 shrink-0 text-accent-green" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-card-glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s ease;
    background: radial-gradient(220px circle at 30% 0%, rgb(39 183 200 / 0.14), transparent 70%);
  }

  .feature-card:hover .feature-card-glow {
    opacity: 1;
  }
</style>
