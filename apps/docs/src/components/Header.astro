---
/**
 * Header for the custom Astro pages.
 *
 * Mirrors Starlight's `<Header>` markup 1:1 — same class names, same
 * structure, same slots (title, nav, search, social, theme select). The
 * styling is provided by Starlight's reset.css + util.css (loaded from
 * global.css) so this looks identical to the docs.
 */
import logoLight from '../assets/logo-light.svg';
import logoDark from '../assets/logo-dark.svg';

interface Props {
    activeNav?: 'home' | 'showcase' | 'docs' | 'github';
}

const { activeNav = 'home' } = Astro.props;

const links = [
    { id: 'docs', label: 'Docs', href: '/tutorials/01-bootstrap/' },
    { id: 'showcase', label: 'Showcase', href: '/showcase/starlight-components/' },
    { id: 'api', label: 'API', href: '/reference/plugin-api/' },
] as const;
---

<header class="site-header">
    <div class="header-inner">
        <a href="/" class="site-title sl-flex" aria-label="Grove home">
            <img
                class="light:sl-hidden logo"
                alt="Grove"
                src={logoDark.src}
                width="32"
                height="32"
            />
            <img
                class="dark:sl-hidden logo"
                alt="Grove"
                src={logoLight.src}
                width="32"
                height="32"
            />
            <span class="title-text">Grove</span>
        </a>

        <nav class="nav-bar sl-hidden md:sl-flex" aria-label="Primary">
            {
                links.map((link) => (
                    <a
                        href={link.href}
                        class:list={[{ 'is-active': activeNav === link.id }]}
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>

        <div class="header-right sl-flex">
            <div class="search-placeholder sl-hidden md:sl-flex" aria-hidden="true">
                <span>Search</span>
                <kbd>
                    <kbd>⌘</kbd>
                    <kbd>K</kbd>
                </kbd>
            </div>
            <a
                href="https://github.com/tortuvshin/grove"
                rel="me"
                class="sl-flex social-link"
                aria-label="GitHub"
            >
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path
                        d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"
                    ></path>
                </svg>
            </a>

            <starlight-theme-select class="sl-flex">
                <button
                    aria-label="Select theme"
                    aria-live="polite"
                    class="sl-flex theme-toggle"
                    title="Select theme"
                    type="button"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="sun"
                    >
                        <circle cx="12" cy="12" r="4"></circle>
                        <path d="M12 2v2"></path>
                        <path d="M12 20v2"></path>
                        <path d="m4.93 4.93 1.41 1.41"></path>
                        <path d="m17.66 17.66 1.41 1.41"></path>
                        <path d="M2 12h2"></path>
                        <path d="M20 12h2"></path>
                        <path d="m6.34 17.66-1.41 1.41"></path>
                        <path d="m19.07 4.93-1.41 1.41"></path>
                    </svg>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="moon"
                    >
                        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
                    </svg>
                    <span class="sr-only">Toggle theme</span>
                </button>
            </starlight-theme-select>
        </div>
    </div>
</header>

<script>
    // Starlight theme picker — identical script to ThemeSelect.astro.
    type Theme = 'auto' | 'dark' | 'light';
    const storageKey = 'starlight-theme';
    const parseTheme = (t: unknown): Theme =>
        t === 'auto' || t === 'dark' || t === 'light' ? t : 'auto';
    const loadTheme = (): Theme =>
        parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));
    const storeTheme = (theme: Theme): void => {
        if (typeof localStorage !== 'undefined') {
            localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
        }
    };
    const getPreferredColorScheme = (): Theme =>
        matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

    function onThemeChange(theme: Theme): void {
        document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
        storeTheme(theme);
    }

    class StarlightThemeSelect extends HTMLElement {
        constructor() {
            super();
            onThemeChange(loadTheme());
            this.querySelector('button')?.addEventListener('click', () => {
                const current = loadTheme();
                const next: Theme = current === 'dark' ? 'light' : current === 'light' ? 'auto' : 'dark';
                onThemeChange(next);
            });
        }
    }
    if (!customElements.get('starlight-theme-select')) {
        customElements.define('starlight-theme-select', StarlightThemeSelect);
    }
</script>

<style>
    .site-header {
        position: sticky;
        top: 0;
        z-index: var(--sl-z-index-navbar);
        width: 100%;
        height: var(--sl-nav-height);
        background-color: var(--sl-color-bg-nav);
        border-bottom: 1px solid var(--sl-color-hairline-light);
        backdrop-filter: var(--sl-nav-backdrop-filter);
        -webkit-backdrop-filter: var(--sl-nav-backdrop-filter);
    }

    .header-inner {
        display: flex;
        gap: var(--sl-nav-gap);
        justify-content: space-between;
        align-items: center;
        height: 100%;
        max-width: var(--sl-container, 100%);
        padding-inline: var(--sl-nav-pad-x);
        margin-inline: auto;
    }

    .site-title {
        align-items: center;
        gap: var(--sl-nav-gap);
        font-size: var(--sl-text-h4);
        font-weight: 600;
        color: var(--sl-color-text-accent);
        text-decoration: none;
        white-space: nowrap;
        min-width: 0;
    }

    .site-title .logo {
        height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
        width: auto;
        max-width: 100%;
        object-fit: contain;
        object-position: 0 50%;
    }

    .site-title .title-text {
        overflow: hidden;
    }

    :global([data-theme='dark']) .site-title .light\:sl-hidden {
        display: none;
    }
    :global([data-theme='light']) .site-title .dark\:sl-hidden {
        display: none;
    }

    .nav-bar {
        gap: 1rem;
        align-items: center;
        margin-inline: auto;
    }

    .nav-bar a {
        color: var(--sl-color-gray-2);
        text-decoration: none;
        font-size: var(--sl-text-sm);
        font-weight: 500;
        padding: 0.25rem 0.5rem;
        border-radius: var(--sl-border-radius);
    }

    .nav-bar a:hover,
    .nav-bar a.is-active {
        color: var(--sl-color-white);
    }

    .header-right {
        gap: 0.5rem;
        align-items: center;
    }

    .search-placeholder {
        align-items: center;
        gap: 0.25rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.375rem;
        background: var(--sl-color-black);
        color: var(--sl-color-gray-2);
        font-size: var(--sl-text-sm);
        min-width: 14rem;
        cursor: text;
    }

    .search-placeholder kbd {
        margin-inline-start: auto;
        display: inline-flex;
        gap: 0.25rem;
    }

    .search-placeholder kbd kbd {
        display: inline-block;
        padding: 0.125rem 0.375rem;
        font-family: var(--sl-font-system-mono);
        font-size: var(--sl-text-xs);
        color: var(--sl-color-gray-2);
        background: var(--sl-color-gray-6);
        border: 1px solid var(--sl-color-gray-5);
        border-radius: 0.25rem;
    }

    .social-link {
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        color: var(--sl-color-gray-2);
        border-radius: var(--sl-border-radius);
    }

    .social-link:hover {
        color: var(--sl-color-white);
    }

    starlight-theme-select .theme-toggle {
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        padding: 0;
        color: var(--sl-color-gray-2);
        background: transparent;
        border: 0;
        border-radius: var(--sl-border-radius);
        cursor: pointer;
    }

    starlight-theme-select .theme-toggle:hover {
        color: var(--sl-color-white);
    }

    starlight-theme-select .moon {
        display: none;
    }
    :global([data-theme='dark']) starlight-theme-select .sun {
        display: none;
    }
    :global([data-theme='dark']) starlight-theme-select .moon {
        display: block;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    @media (max-width: 50rem) {
        .search-placeholder {
            display: none;
        }
        .header-right {
            gap: 0.25rem;
        }
    }
</style>
