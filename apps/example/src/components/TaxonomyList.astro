---
/**
 * TaxonomyList.astro
 *
 * Shared body for the three taxonomy pages — `stacks/[name].astro`,
 * `categories/[name].astro`, `licenses/[name].astro`. The pages
 * differ only in the heading copy and the filterRecords field;
 * everything below the heading — the count, the card grid, the
 * empty state, the back link — is identical, so it lives here.
 *
 * Lives under `apps/example/src/components/` because the page
 * shell (BaseLayout) and the SEO entry point (Seo) already ship
 * from `@grove-dev/astro`; a consumer-side body template is the
 * natural place for it.
 */

interface TaxonomyRecord {
  slug: string;
  name?: string;
  title?: string;
  description?: string;
  repoUrl?: string;
}

interface Props {
  /** URL slug from `Astro.params`. Echoed in the back link. */
  name: string;
  /** Eyebrow label above the heading ("Stack", "Category", "License"). */
  eyebrow: string;
  /** Display name shown in the heading and intro copy. */
  displayName: string;
  /** Lede copy under the heading. */
  lede: string;
  /** Singular noun used in the count label ("1 project" / "3 projects"). */
  itemNoun?: string;
  /** Records filtered by `filterRecords` upstream. */
  records: TaxonomyRecord[];
  /** Index route (e.g. "/projects") for the back link. */
  backHref?: string;
  /** Back-link label. */
  backLabel?: string;
}

const {
  name,
  eyebrow,
  displayName,
  lede,
  itemNoun = "project",
  records,
  backHref = "/projects",
  backLabel = "← Back to all projects",
} = Astro.props;

const count = records.length;
---

<section class="mx-auto max-w-5xl px-6 py-16">
  <p class="text-xs font-semibold uppercase tracking-widest text-subtle">{eyebrow}</p>
  <h1 class="mt-3 text-3xl font-bold tracking-tight text-fg sm:text-4xl">
    {displayName} {itemNoun}s
  </h1>
  <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{lede}</p>

  <div class="mt-10">
    <p class="text-xs font-semibold uppercase tracking-widest text-subtle">
      {count} {count === 1 ? itemNoun : `${itemNoun}s`}
    </p>

    {count === 0 ? (
      <p class="mt-4 text-sm text-muted">No records yet for this {itemNoun}.</p>
    ) : (
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {records.map((record) => (
          <li class="rounded-lg border border-border bg-card p-5">
            <h2 class="m-0 text-base font-semibold text-fg">
              <a
                href={`/projects/${record.slug}`}
                class="text-inherit no-underline hover:underline"
              >
                {record.name ?? record.title ?? record.slug}
              </a>
            </h2>
            {record.description && (
              <p class="mt-2 text-sm leading-relaxed text-muted">
                {record.description}
              </p>
            )}
            {record.repoUrl && (
              <a
                href={record.repoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-3 inline-flex text-xs font-mono text-accent-cyan no-underline hover:underline"
              >
                {record.repoUrl.replace(/^https?:\/\//, "")}
              </a>
            )}
          </li>
        ))}
      </ul>
    )}
  </div>

  <p class="mt-12 text-xs text-subtle">
    <a href={backHref} class="text-inherit no-underline hover:underline">
      {backLabel}
    </a>
  </p>
</section>