---
/**
 * TaxonomyList.astro
 *
 * Shared body for the three taxonomy pages — `stacks/[name].astro`,
 * `categories/[name].astro`, `licenses/[name].astro`. The pages
 * differ only in the heading copy and the filterRecords field;
 * everything below the heading — the count, the card grid, the
 * empty state, the back link — is identical, so it lives here.
 *
 * Records render through the package's canonical `ProjectCard` inside
 * `CardGrid`, so taxonomy pages read as the same site as the browse
 * and collection pages.
 *
 * Lives under `apps/example/src/components/` because the page
 * shell (BaseLayout) and the SEO entry point (Seo) already ship
 * from `@grove-dev/astro`; a consumer-side body template is the
 * natural place for it.
 */
import CardGrid from "@grove-dev/astro/components/CardGrid.astro";
import ProjectCard from "@grove-dev/astro/components/ProjectCard.astro";

interface TaxonomyRecord {
  slug: string;
  name?: string;
  title?: string;
  description?: string;
  repoUrl?: string;
}

interface Props {
  /** URL slug from `Astro.params`. Echoed in the back link. */
  name: string;
  /** Eyebrow label above the heading ("Stack", "Category", "License"). */
  eyebrow: string;
  /** Display name shown in the heading and intro copy. */
  displayName: string;
  /** Lede copy under the heading. */
  lede: string;
  /** Singular noun used in the count label ("1 project" / "3 projects"). */
  itemNoun?: string;
  /** Records filtered by `filterRecords` upstream. */
  records: TaxonomyRecord[];
  /** Index route (e.g. "/projects") for the back link and card hrefs. */
  backHref?: string;
  /** Back-link label. */
  backLabel?: string;
}

const {
  name,
  eyebrow,
  displayName,
  lede,
  itemNoun = "project",
  records,
  backHref = "/projects",
  backLabel = "← Back to all projects",
} = Astro.props;

const count = records.length;
const hrefPrefix = backHref.replace(/\/$/, "");
type CardRecord = Parameters<typeof ProjectCard>[0]["record"];
---

<section class="mx-auto w-full max-w-wide px-5 py-12 sm:px-7 sm:py-16">
  <p class="m-0 text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">{eyebrow}</p>
  <h1 class="m-0 mt-2 text-[1.875rem] font-semibold tracking-tight text-ink-900 sm:text-[2.125rem] dark:text-ink-100">
    {displayName} {itemNoun}s
  </h1>
  <p class="m-0 mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-500 dark:text-ink-400">{lede}</p>

  <div class="mt-10">
    <p class="m-0 text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
      {count} {count === 1 ? itemNoun : `${itemNoun}s`}
    </p>

    {count === 0 ? (
      <p class="mt-4 text-sm text-ink-500 dark:text-ink-400">No records yet for this {itemNoun}.</p>
    ) : (
      <CardGrid class="mt-6">
        {records.map((record, i) => (
          <li class="m-0 p-0">
            <ProjectCard
              record={record as CardRecord}
              href={`${hrefPrefix}/${record.slug}`}
              showCurated
              showLicense
              eager={i < 3}
            />
          </li>
        ))}
      </CardGrid>
    )}
  </div>

  <p class="mt-12 text-2xs text-ink-500 dark:text-ink-400">
    <a href={backHref} class="text-inherit no-underline hover:underline">
      {backLabel}
    </a>
  </p>
</section>
