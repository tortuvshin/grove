---
import BaseLayout from "@grove-dev/astro/layouts/BaseLayout.astro";
import siteConfig from "@grove/generated/site-config.json";
export function getStaticPaths() {
  return [{ params: { name: "flutter" } }];
}
const { name } = Astro.params;
---
<BaseLayout title={`${name} apps`} description={`Open source apps built with ${name}.`} site={siteConfig}>
  <h1>{name} apps</h1>
  <p>Browse open source apps built with {name}.</p>
</BaseLayout>