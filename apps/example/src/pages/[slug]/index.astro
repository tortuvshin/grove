---
/**
 * List page — the discovery / browse page.
 *
 * Mirrors the openapps list structure:
 *   - SmartLensTabs (curated views only; sorting stays in the sort select)
 *   - RefinePanel  (Stack / Platform / Category / License / Sort)
 *   - RecordSection rows (full record cards; the `ItemSection` V0
 *     name was renamed to `RecordSection` in V1)
 *
 * Generic: the URL slug (e.g. `/projects/`, `/resources/`,
 * `/entities/`) is derived from the blueprint via `getStaticPaths`,
 * so the same page works for every blueprint without per-blueprint
 * forks.
 *
 * Navigation model: the URL is the single source of truth for filter
 * state — the form submits via `method="get"` so every change is a
 * full-page navigation to `?q=...&sort=...&stack=...`. But this route
 * is PRERENDERED: at build time `Astro.url.searchParams` is empty, so
 * the server renders the unfiltered state once. `DirectoryIndexClient`
 * re-reads `location.search` on load and re-derives the result list,
 * chips, pagination, and facet intersection counts with the same
 * `@grove-dev/core/directory` functions the server used.
 */
import siteConfig from "@grove/generated/site-config.json";
import { getDirectoryIndexModel, itemLabel, itemLabelPlural, taxonomy } from "@grove-dev/astro/server";
import type { IndexFilters } from "@grove-dev/astro";
import BaseLayout from "@grove-dev/astro/layouts/BaseLayout.astro";
import CardGrid from "@grove-dev/astro/components/CardGrid.astro";
import SmartLensTabs from "@grove-dev/astro/components/SmartLensTabs.astro";
import RefinePanel from "@grove-dev/astro/components/RefinePanel.astro";
import IndexRow from "@grove-dev/astro/components/IndexRow.astro";
import Pagination from "@grove-dev/astro/components/Pagination.astro";
import DirectoryIndexClient from "@grove-dev/astro/components/DirectoryIndexClient.astro";
import { removeFilter, searchParamsFromFilters, sortDisplay, SORT_OPTIONS } from "@grove-dev/astro";
import { formatCount, PRIMARY_LENSES } from "@grove-dev/core";
import { buttonClass, chipClass } from "@grove-dev/astro/ui/button";
import PageHeader from "@grove-dev/astro/ui/PageHeader.astro";
import SearchField from "@grove-dev/astro/ui/SearchField.astro";
import FilterDrawer from "@grove-dev/astro/ui/FilterDrawer.astro";

export function getStaticPaths() {
  const routeSlug = siteConfig.blueprintConfig?.routeSlug ?? "projects";
  return [{ params: { slug: routeSlug } }];
}

const slug = siteConfig.blueprintConfig?.routeSlug ?? "projects";
const {
  total,
  filters,
  facetGroups,
  searchPlaceholder,
  sort,
  sorted,
  pages,
  page,
  chips,
  clientItemsJson,
} = getDirectoryIndexModel(Astro.url.searchParams, siteConfig);

const title = `Browse ${slug} — ${siteConfig.name}`;
const description = `A searchable directory of ${itemLabelPlural()} for ${siteConfig.name}.`;

function hrefForPage(target: number): string {
  const next: IndexFilters = { ...filters, page: target };
  const query = searchParamsFromFilters(next).toString();
  return query ? `/${slug}?${query}` : `/${slug}`;
}

function hrefForRemove(key: keyof IndexFilters, value: string): string {
  const params = searchParamsFromFilters(removeFilter(filters, key, value));
  const query = params.toString();
  return query ? `/${slug}?${query}` : `/${slug}`;
}

const clearQuery = searchParamsFromFilters({ sort }).toString();
const clearFiltersHref = clearQuery ? `/${slug}?${clearQuery}` : `/${slug}`;
---

<BaseLayout
  title={title}
  description={description}
  site={siteConfig}
  submitHref="/submit"
  submitLabel={`Submit ${itemLabel()}`}
>
  <section class="border-b border-border bg-background">
    <div class="mx-auto w-full max-w-wide px-5 pt-10 sm:px-7 sm:pt-12">
      <PageHeader
        eyebrow={slug}
        title={`Browse ${slug}`}
        description={`Search, filter, and explore ${formatCount(total, { singular: itemLabel(), plural: itemLabelPlural() })} in this directory.`}
      />

      {/* Discovery bar: one compact row on desktop — search grows,
          sort and submit sit beside it. */}
      <form
        method="get"
        action={`/${slug}`}
        id="search-form"
        class="mt-6 flex flex-col gap-2 sm:flex-row"
        role="search"
      >
        <SearchField
          class="flex-1"
          label={`Search ${itemLabelPlural()}`}
          value={filters.q ?? ""}
          placeholder={searchPlaceholder}
        />
        <label class="relative">
          <span class="sr-only">{`Sort ${itemLabelPlural()}`}</span>
          <select
            id="sort-select"
            name="sort"
            class="h-10 w-full cursor-pointer appearance-none rounded-md border border-input bg-background py-1.5 pl-3 pr-8 text-sm font-medium text-foreground transition-colors hover:border-ring focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring/20 sm:w-auto"
          >
            {SORT_OPTIONS.map((o) => (
              <option value={o.value} selected={o.value === sort}>{o.label}</option>
            ))}
          </select>
          <svg
            viewBox="0 0 16 16"
            width="11"
            height="11"
            aria-hidden="true"
            class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-muted-foreground"
            fill="currentColor"
          >
            <path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" />
          </svg>
        </label>
        <button type="submit" class={buttonClass("primary", "bare", "h-10 px-4 text-sm max-sm:min-h-11")}>Search</button>
      </form>

      {/* One toolbar row on desktop: view tabs on the left, facet
          filters pushed to the right. On mobile the tabs become a
          single horizontally scrolling strip and the facets collapse
          into a full-width "Filters" button opening a bottom sheet. */}
      <div class="mt-4 flex flex-col gap-3 pb-6 md:flex-row md:items-center">
        <div class="max-md:-mx-5 max-md:overflow-x-auto max-md:px-5">
          <SmartLensTabs
            class="max-md:w-max"
            currentParams={Astro.url.searchParams}
            pathPrefix={`/${slug}`}
            lensIds={PRIMARY_LENSES}
            allLabel={`All ${itemLabelPlural()}`}
          />
        </div>

        <FilterDrawer label="Filters" activeCount={chips.length} class="md:ml-auto">
          <RefinePanel
            class="max-md:flex-col max-md:items-stretch"
            groups={facetGroups}
            initial={filters}
            pathPrefix={`/${slug}`}
            hide={["sort"]}
          />
        </FilterDrawer>
      </div>
    </div>
  </section>

  <section class="py-10 sm:py-12">
    <div class="mx-auto w-full max-w-wide px-5 sm:px-7">
      <header class="mb-6">
        <h2 id="results-heading" class="m-0 text-[1.5rem] sm:text-[1.625rem] font-semibold tracking-tight text-ink-900 dark:text-ink-100">
          {`All ${itemLabelPlural()}`}
        </h2>
        <p id="results-description" class="m-0 mt-1 max-w-[60ch] text-[0.9375rem] text-ink-500 dark:text-ink-400">
          {`Every ${itemLabel()} in the directory.`}
        </p>
      </header>
      <div class="mb-5 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <p class="m-0 text-2xs text-ink-500 dark:text-ink-400">
          <span id="results-count" class="font-mono text-ink-900 dark:text-ink-100">
            {sorted.length} {sorted.length === 1 ? itemLabel() : itemLabelPlural()}
          </span>
          <span id="results-sort">{` · sorted by ${sortDisplay(sort)}`}</span>
          <span id="results-page">{pages > 1 ? ` · page ${page} of ${pages}` : ""}</span>
        </p>
        <div
          id="active-filters"
          class:list={["flex flex-wrap items-center gap-1.5", chips.length === 0 && "hidden"]}
          aria-label="Active filters"
        >
          {chips.length > 0 && (
            <>
            {chips.map((chip) => (
              <a
                href={hrefForRemove(chip.key, chip.value)}
                class={chipClass()}
              >
                {chip.label} <span aria-hidden="true">x</span>
              </a>
            ))}
            <a href={clearFiltersHref} class="text-2xs font-medium text-ink-500 hover:text-ink-900">
              Clear all
            </a>
            </>
          )}
        </div>
      </div>

      <CardGrid id="results-list">
        {sorted.map((item, i) => (
            <li class="m-0 p-0" data-record-slug={item.slug}>
              <IndexRow
                record={item as Parameters<typeof IndexRow>[0]["record"]}
                detailHref={`/${slug}/${item.slug}`}
                eager={i < 3}
              />
            </li>
        ))}
      </CardGrid>
      <div id="empty-state" class:list={["py-12 text-center", sorted.length > 0 && "hidden"]}>
        <p class="m-0 text-sm font-medium text-ink-700 dark:text-ink-200">
          {`No ${itemLabelPlural()} match these filters.`}
        </p>
        <a href={clearFiltersHref} class={buttonClass("secondary", "sm", "mt-4")}>Clear filters</a>
      </div>
      {/* Plain div wrapper — Pagination renders its own
          <nav aria-label="Pagination">, so a nav here would nest two
          identical landmarks. */}
      <div id="results-pagination" class="mt-8 flex flex-wrap items-center justify-center gap-1.5">
        <Pagination current={page} total={pages} hrefFor={hrefForPage} />
      </div>
    </div>
  </section>

  <section class="border-t border-ink-200 dark:border-ink-800">
    <div class="mx-auto w-full max-w-wide px-5 sm:px-7">
      <div class="flex flex-col items-center gap-3 py-12 text-center">
        <h2 class="m-0 text-xl font-semibold tracking-tight text-ink-900 dark:text-ink-100">
          {`Know a real ${itemLabel()} that belongs here?`}
        </h2>
        <p class="m-0 max-w-2xl text-sm text-ink-500 dark:text-ink-400">
          {`Open a pull request with a YAML file. We review every submission against the bar — no marketing, no tutorials.`}
        </p>
        <a
          href="/submit"
          class={buttonClass("primary", "sm", "mt-2")}
        >
          {`Submit ${itemLabel()}`}
        </a>

      </div>
    </div>
  </section>

  <DirectoryIndexClient
    clientItemsJson={clientItemsJson}
    slug={slug}
    singular={itemLabel()}
    plural={itemLabelPlural()}
    taxonomy={taxonomy}
  />
</BaseLayout>
