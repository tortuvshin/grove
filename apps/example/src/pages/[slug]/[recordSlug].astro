---
/**
 * Detail page — thin consumer wiring up the package's
 * RecordHeader, EditorialSummary, TableOfContents, MarkdownBody,
 * and RecordSidebar components. All rendering logic, prose
 * styling, sidebar visibility, and activity-badge rules live in
 * `@grove-dev/astro`; this file only composes them.
 */
import siteConfig from '@grove/generated/site-config.json';
import { getRecordDetailModel, recordDetailPaths } from '@grove-dev/astro/server';
import BaseLayout from '@grove-dev/astro/layouts/BaseLayout.astro';
import RecordHeader from '@grove-dev/astro/components/RecordHeader.astro';
import EditorialSummary from '@grove-dev/astro/components/EditorialSummary.astro';
import TableOfContents from '@grove-dev/astro/components/TableOfContents.astro';
import MarkdownBody from '@grove-dev/astro/components/MarkdownBody.astro';
import RecordSidebar from '@grove-dev/astro/components/RecordSidebar.astro';

export function getStaticPaths() {
  return recordDetailPaths(siteConfig);
}

const dirSlug = siteConfig.blueprintConfig?.routeSlug ?? 'projects';
const detail = getRecordDetailModel(
  Astro.params.recordSlug ?? '',
  siteConfig,
  Astro.params.slug ?? dirSlug,
);
if (!detail) return Astro.redirect(`/${dirSlug}`);
const { record, name, title, description, itemSingular, jsonLd } = detail;
---

<BaseLayout
  title={title}
  description={description}
  site={siteConfig}
  type="article"
  jsonLd={jsonLd}
  submitHref="/submit"
  submitLabel={`Submit ${itemSingular}`}
>
  <article class="py-8 sm:py-10">
    <div class="mx-auto w-full max-w-[1240px] px-5 sm:px-7">
      <RecordHeader detail={detail} />

      <div
        class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-12 xl:grid-cols-[minmax(0,1fr)_340px]"
      >
        {/* Reading column: editorial context, then the article —
            no TOC panel pushing the body down. */}
        <div class="min-w-0">
          <EditorialSummary bestFor={detail.bestFor} caveats={detail.caveats} />
          <MarkdownBody
            recordSlug={record.slug}
            fallback={record.content ? "This record doesn't have notes yet." : undefined}
          />
        </div>
        {/* Right rail: TOC on top (navigation first), metadata stats
            below it, one sticky column. */}
        <div class="flex min-w-0 flex-col gap-4 lg:sticky lg:top-20 lg:max-h-[calc(100vh-5rem)] lg:self-start lg:overflow-y-auto">
          <TableOfContents items={detail.toc} />
          <RecordSidebar detail={detail} sticky={false} />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
