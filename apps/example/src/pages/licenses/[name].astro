---
import BaseLayout from "@grove-dev/astro/layouts/BaseLayout.astro";
import { filterRecords } from "@grove-dev/core";
import indexPayload from "@grove/generated/records.index.json";
import siteConfig from "@grove/generated/site-config.json";
import TaxonomyList from "../../components/TaxonomyList.astro";

export function getStaticPaths() {
  const licenses = siteConfig.taxonomy?.licenses ?? [];
  return licenses.map(({ id, name }) => ({
    params: { name: id },
    props: { displayName: name },
  }));
}

const { displayName } = Astro.props;
const name = Astro.params.name;
const indexRecords = (indexPayload as { records: unknown[] }).records as never;
const licenseRecords = filterRecords(indexRecords, {
  licenses: [name],
}) as Array<{
  slug: string;
  name?: string;
  title?: string;
  description?: string;
  repoUrl?: string;
}>;
---

<BaseLayout
  title={`${displayName} projects`}
  description={`Open-source projects licensed under ${displayName}.`}
  site={siteConfig}
>
  <TaxonomyList
    name={name}
    eyebrow="License"
    displayName={displayName}
    lede={`Browse open-source projects in this directory licensed under ${displayName}.`}
    records={licenseRecords}
  />
</BaseLayout>