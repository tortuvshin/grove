---
import BaseLayout from "@grove-dev/astro/layouts/BaseLayout.astro";
import { getTaxonomyPageModel, itemLabelPlural } from "@grove-dev/astro/server";
import siteConfig from "@grove/generated/site-config.json";
import TaxonomyList from "../../components/TaxonomyList.astro";

export function getStaticPaths() {
  const licenses = siteConfig.taxonomy?.licenses ?? [];
  return licenses.map(({ id, name }) => ({
    params: { name: id },
    props: { displayName: name },
  }));
}

const { displayName } = Astro.props;
const name = Astro.params.name;
const model = getTaxonomyPageModel("licenses", name, displayName, siteConfig);
---

<BaseLayout
  title={model.seo.title}
  description={model.seo.description}
  image={model.seo.image}
  imageAlt={model.seo.imageAlt}
  jsonLd={model.seo.jsonLd}
  site={siteConfig}
>
  <TaxonomyList
    name={name}
    eyebrow="License"
    displayName={displayName}
    lede={`Browse ${itemLabelPlural()} in this directory licensed under ${displayName}.`}
    records={model.records}
  />
</BaseLayout>
