{
  "name": "@grove-dev/core",
  "version": "0.6.1",
  "type": "module",
  "description": "Headless engine for Grove — schemas, validation, generation, synchronization, collections, SEO artifacts, health, decisions, and importers. No UI.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "grove",
    "static-site",
    "yaml",
    "markdown",
    "structured-data",
    "schema",
    "validation",
    "seo",
    "sitemap",
    "llms-txt",
    "json-ld",
    "zod"
  ],
  "homepage": "https://github.com/tortuvshin/grove#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tortuvshin/grove.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/tortuvshin/grove/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./directory": {
      "types": "./dist/directory-client.d.ts",
      "import": "./dist/directory-client.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "assets",
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && pnpm exec vitest run --project unit packages/core"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "jiti": "^2.6.1",
    "satori": "^0.29.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
