{
  "name": "@grove-dev/cli",
  "version": "0.3.1",
  "type": "module",
  "description": "Grove CLI — scaffolds Grove-powered spaces and orchestrates @grove-dev/core commands.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "grove",
    "cli",
    "scaffold",
    "directory",
    "community",
    "knowledge"
  ],
  "homepage": "https://github.com/tortuvshin/grove#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tortuvshin/grove.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/tortuvshin/grove/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "grove": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('package.json','dist/package.json')\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && pnpm exec vitest run --project unit packages/cli",
    "dev": "tsx src/index.ts --help"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@grove-dev/astro": "workspace:*",
    "@grove-dev/core": "workspace:*",
    "commander": "^15.0.0",
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "@grove-dev/nextjs": "workspace:*",
    "@grove-dev/svelte": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@grove-dev/nextjs": {
      "optional": true
    },
    "@grove-dev/svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsx": "^4.23.1"
  }
}
