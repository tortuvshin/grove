{
  "name": "@grove/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "CLI for Grove project repos.",
  "license": "MIT",
  "bin": {
    "grove": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"No cli package tests yet\"",
    "dev": "tsx src/index.ts --help"
  },
  "dependencies": {
    "@grove/astro": "workspace:*",
    "@grove/core": "workspace:*",
    "commander": "^14.0.2",
    "tsx": "^4.21.0"
  }
}
