{
  "name": "@grove-dev/cli",
  "version": "0.6.1",
  "type": "module",
  "description": "The grove command — create a Grove space and run every operation that keeps it useful: check, sync, cleanup, import, collections, README, audit.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "grove",
    "cli",
    "scaffold",
    "static-site",
    "yaml",
    "markdown",
    "automation",
    "maintenance",
    "lighthouse"
  ],
  "homepage": "https://github.com/tortuvshin/grove#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tortuvshin/grove.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/tortuvshin/grove/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "grove": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('package.json','dist/package.json')\" && node ../../scripts/package-site.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../.. && pnpm exec vitest run --project unit packages/cli",
    "dev": "tsx src/index.ts --help"
  },
  "dependencies": {
    "@grove-dev/core": "workspace:*",
    "chrome-launcher": "^1.2.1",
    "commander": "^15.0.0",
    "lighthouse": "^12.8.2",
    "typescript": "^5.9.3",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "tsx": "^4.23.0"
  }
}
