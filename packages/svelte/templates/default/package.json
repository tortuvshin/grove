{
  "name": "grove-svelte-default",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A Grove-powered space built with the SvelteKit framework adapter.",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate:data": "grove validate",
    "build:data": "grove generate",
    "build:sitemap": "grove sitemap",
    "build:llms": "grove llms",
    "build": "pnpm run build:data && pnpm run build:sitemap && pnpm run build:llms && vite build",
    "dev": "pnpm run build:data && vite dev",
    "preview": "vite preview",
    "svelte-kit": "svelte-kit",
    "sync:github": "grove sync github",
    "cleanup": "grove cleanup stale"
  },
  "dependencies": {
    "@grove-dev/core": "0.2.16",
    "@grove-dev/svelte": "0.2.16",
    "@grove-dev/ui": "1.0.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.0"
  }
}
