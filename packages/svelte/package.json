{
  "name": "@grove-dev/svelte",
  "version": "0.2.5",
  "type": "module",
  "description": "SvelteKit framework adapter for Grove. Components, layouts, design tokens, and a default template.",
  "license": "MIT",
  "keywords": [
    "grove",
    "svelte",
    "sveltekit",
    "ui",
    "template",
    "components"
  ],
  "homepage": "https://github.com/tortuvshin/grove#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tortuvshin/grove.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/tortuvshin/grove/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "src",
    "templates",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./components/*": "./src/components/*.svelte"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"No svelte package tests yet\""
  },
  "dependencies": {
    "@grove-dev/core": "workspace:*",
    "@grove-dev/ui": "workspace:*"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2.0.0",
    "svelte": ">=4.0.0"
  }
}
