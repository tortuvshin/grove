{
  "name": "@grove-dev/registry",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Grove's UI as a shadcn registry — feature blocks (home, browse, record, …) plus the full `default` scaffold, installable with `npx shadcn add @grove/<item>` or by `grove init`.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./dist/r/registry.json",
    "./r/*": "./dist/r/*",
    "./package.json": "./package.json"
  },
  "keywords": [
    "grove",
    "registry",
    "shadcn",
    "astro",
    "ui",
    "scaffold"
  ],
  "homepage": "https://withgrove.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tortuvshin/grove.git",
    "directory": "packages/registry"
  },
  "scripts": {
    "build": "node ../../scripts/build-registry.mjs",
    "check": "node ../../scripts/check-registry.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "shadcn": "4.19.0"
  }
}
