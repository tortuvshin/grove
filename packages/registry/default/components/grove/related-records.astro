---
/**
 * RelatedRecords.astro
 *
 * Where a record page leads next: sibling records that share a subject
 * ("Other alternatives to Notion") and the collections the record
 * appears in. Both come from `getRecordContextModel`. Before this, a
 * detail page linked to its stack and its category and nothing else.
 *
 * Renders nothing when there is neither.
 */
import type { RecordContextModel } from '@grove-dev/astro/server';

interface Props {
  context: RecordContextModel;
}

const { context } = Astro.props;
const hasAny = context.relatedRecords.length > 0 || context.collectionMembership.length > 0;
---

{hasAny && (
  <section class="mt-12 border-t border-border pt-8" aria-label="Related">
    {/* Collections are destinations, not reading: titles only, as chips. */}
    {context.collectionMembership.length > 0 && (
      <div class="flex flex-wrap items-center gap-2">
        <h2 class="m-0 text-2xs font-semibold uppercase tracking-wider text-muted-foreground">Featured in</h2>
        {context.collectionMembership.map((c) => (
          <a href={c.url} class="rounded-full border border-border bg-card px-3 py-1 text-[0.8125rem] font-medium text-foreground no-underline hover:border-ink-400">
            {c.title}
          </a>
        ))}
      </div>
    )}

    {context.relatedRecords.map((group) => (
      <div class:list={[context.collectionMembership.length > 0 ? "mt-7" : ""]}>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h2 class="m-0 text-2xs font-semibold uppercase tracking-wider text-muted-foreground">
            Other {group.label.toLowerCase().replace(/ to$/, 's to')} {group.subject.name}
          </h2>
          {group.hub && (
            <a href={group.hub.url} aria-label={`Compare them all: ${group.hub.title}`} class="text-sm font-medium text-foreground no-underline hover:underline">
              Compare them all →
            </a>
          )}
        </div>
        {/* Equal-height cards: a ragged wall of boxes reads as clutter. */}
        <ul class="m-0 mt-3 grid list-none grid-cols-1 gap-3 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {group.records.map((r) => (
            <li class="m-0">
              <a href={r.url} class="flex h-full flex-col rounded-[var(--radius-lg)] border border-border bg-card px-4 py-3 no-underline hover:border-ink-400">
                <span class="text-sm font-medium text-foreground">{r.title}</span>
                {r.description && (
                  <span class="mt-1 line-clamp-2 text-[0.8125rem] leading-snug text-muted-foreground">{r.description}</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
)}
