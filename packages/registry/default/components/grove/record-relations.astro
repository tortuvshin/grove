---
/**
 * RecordRelations.astro
 *
 * The record's relations to subjects — "Alternative to Notion" — as a
 * row of links under the header. Each links to the subject's hub
 * collection when one exists, so a reader who came for one alternative
 * can reach the page that compares all of them. Without a hub the
 * subject renders as plain text: a link to the vendor would send the
 * reader away from the directory at the top of the page.
 *
 * A relation the curator inferred (`evidence.type: editorial`) is
 * marked as such; one the project states itself is not second-guessed.
 *
 * Renders nothing when the record has no relations.
 */
import type { RecordContextModel } from '@grove-dev/astro/server';

interface Props {
  relations: RecordContextModel['relations'];
}

const { relations } = Astro.props;
---

{relations.length > 0 && (
  <ul class="m-0 mb-8 flex list-none flex-wrap gap-2 p-0" aria-label="Related products">
    {relations.map((relation) => (
      <li class="m-0 inline-flex items-center gap-1.5 rounded-full border border-border bg-card px-3 py-1 text-xs text-muted-foreground">
        <span>{relation.label}</span>
        {relation.hub ? (
          <a href={relation.hub.url} class="font-medium text-foreground underline-offset-2 hover:underline">
            {relation.subject.name}
          </a>
        ) : (
          <span class="font-medium text-foreground">{relation.subject.name}</span>
        )}
        {relation.evidence?.type === 'editorial' && (
          <span title="The curator's comparison, not the project's own claim">· editor's match</span>
        )}
      </li>
    ))}
  </ul>
)}
