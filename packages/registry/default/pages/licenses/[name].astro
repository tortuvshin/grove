---
import siteConfig from '@grove/generated/site-config.json';
import { getPageContentHtml, getTaxonomyPageModel, itemLabelPlural } from '@grove-dev/astro/server';
import TaxonomyList from '../../components/grove/taxonomy-list.astro';
import BaseLayout from '../../layouts/base-layout.astro';

export function getStaticPaths() {
  const licenses = siteConfig.taxonomy?.licenses ?? [];
  // A license no record currently uses gets no page at all — the
  // static host 404s the request instead of publishing a thin,
  // indexable "0 apps" page for it.
  return licenses
    .filter(({ count }) => (count ?? 0) > 0)
    .map(({ id, name }) => ({
      params: { name: id },
      props: { displayName: name },
    }));
}

const { displayName } = Astro.props;
const name = Astro.params.name;
const model = getTaxonomyPageModel('licenses', name, displayName, siteConfig);
// Optional plain-language guide under the list: content/pages/licenses/<id>.md.
const guideHtml = getPageContentHtml(`licenses/${name}`);
---

<BaseLayout
  title={model.seo.title}
  description={model.seo.description}
  image={model.seo.image}
  imageAlt={model.seo.imageAlt}
  jsonLd={model.seo.jsonLd}
  noindex={model.seo.noindex}
  robots={model.seo.robots}
  site={siteConfig}
>
  <TaxonomyList
    eyebrow="License"
    displayName={displayName}
    heading={model.heading}
    lede={model.lede ?? `Browse ${itemLabelPlural()} in this directory licensed under ${displayName}.`}
    scope={{ licenses: [name] }}
    count={model.records.length}
    pathPrefix={`/licenses/${name}`}
  >
    {guideHtml && (
      <section class="mx-auto w-full max-w-container px-5 pb-4 pt-4 sm:px-7" aria-label={`About the ${displayName}`}>
        <div class="grove-prose max-w-[72ch] border-t border-border pt-8" set:html={guideHtml} />
      </section>
    )}
  </TaxonomyList>
</BaseLayout>
