---
import records from '@grove/generated/records.json';
import siteConfig from '@grove/generated/site-config.json';
import {
  getCollectionIndexModel,
  getCollectionTiles,
  loadCollections,
  recordsToCollectionEntries,
} from '@grove-dev/astro/server';
import { runCollection } from '@grove-dev/core';
import CollectionDirectory from '../../components/grove/collection-directory.astro';
import BaseLayout from '../../layouts/base-layout.astro';

const collections = await loadCollections(process.cwd());
const entries = recordsToCollectionEntries(
  (records as { records: unknown[] }).records as never,
  siteConfig,
);
const model = getCollectionIndexModel(collections, entries, siteConfig);
const tiles = getCollectionTiles(collections, entries, siteConfig);
const covered = new Set(
  collections.flatMap((c) => runCollection(c, entries).entries.map((e) => e.slug)),
).size;
const seo = model.seo;
---
<BaseLayout
  title={seo?.title ?? "Collections"}
  description={seo?.description ?? "Curated and generated directories of related items."}
  image={seo?.image}
  jsonLd={seo?.jsonLd}
  site={siteConfig}
>
  <CollectionDirectory
    tiles={tiles}
    covered={covered}
    itemsLabel={siteConfig.blueprintConfig?.labelPlural ?? "items"}
  />
</BaseLayout>
