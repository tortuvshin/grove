---
import BaseLayout from "../../layouts/base-layout.astro";
import { getTaxonomyPageModel, itemLabelPlural } from "@grove-dev/astro/server";
import siteConfig from "@grove/generated/site-config.json";
import TaxonomyList from "../../components/grove/taxonomy-list.astro";

export function getStaticPaths() {
  const stacks = siteConfig.taxonomy?.stacks ?? [];
  return stacks.map(({ id, name }) => ({
    params: { name: id },
    props: { displayName: name },
  }));
}

const { displayName } = Astro.props;
const name = Astro.params.name;
const model = getTaxonomyPageModel("stacks", name, displayName, siteConfig);
---

<BaseLayout
  title={model.seo.title}
  description={model.seo.description}
  image={model.seo.image}
  imageAlt={model.seo.imageAlt}
  jsonLd={model.seo.jsonLd}
  site={siteConfig}
>
  <TaxonomyList
    name={name}
    eyebrow="Stack"
    displayName={displayName}
    lede={`Browse ${itemLabelPlural()} in this directory built with ${displayName}.`}
    records={model.records}
  />
</BaseLayout>
