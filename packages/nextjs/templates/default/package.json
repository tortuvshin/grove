{
  "name": "grove-nextjs-default",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A Grove-powered space built with the Next.js framework adapter.",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate:data": "grove validate",
    "build:data": "grove build-data",
    "build:llms-full": "grove build-llms-full",
    "build": "pnpm run build:data && pnpm run build:llms-full && next build",
    "dev": "pnpm run build:data && next dev",
    "start": "next start",
    "next": "next",
    "refresh:activity": "grove analyze",
    "enrich:github": "grove enrich"
  },
  "dependencies": {
    "@grove-dev/core": "*",
    "@grove-dev/nextjs": "*",
    "@grove-dev/ui": "*",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
