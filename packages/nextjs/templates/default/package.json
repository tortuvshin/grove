{
  "name": "grove-nextjs-default",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A Grove-powered space built with the Next.js framework adapter.",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate:data": "grove validate",
    "build:data": "grove generate",
    "build:sitemap": "grove sitemap",
    "build:llms": "grove llms",
    "build": "pnpm run build:data && pnpm run build:sitemap && pnpm run build:llms && next build",
    "dev": "pnpm run build:data && next dev",
    "start": "next start",
    "next": "next",
    "sync:github": "grove sync github",
    "cleanup": "grove cleanup stale"
  },
  "dependencies": {
    "@grove-dev/core": "workspace:*",
    "@grove-dev/nextjs": "workspace:*",
    "@grove-dev/ui": "workspace:*",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
