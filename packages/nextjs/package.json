{
  "name": "@grove-dev/nextjs",
  "version": "0.2.0",
  "type": "module",
  "description": "Next.js framework adapter for Grove. Components, layouts, design tokens, and a default template.",
  "license": "MIT",
  "keywords": [
    "grove",
    "nextjs",
    "react",
    "ui",
    "template",
    "components"
  ],
  "homepage": "https://github.com/tortuvshin/grove#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tortuvshin/grove.git",
    "directory": "packages/nextjs"
  },
  "bugs": {
    "url": "https://github.com/tortuvshin/grove/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "src",
    "templates",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"No nextjs package tests yet\""
  },
  "dependencies": {
    "@grove-dev/core": "workspace:*",
    "@grove-dev/ui": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
