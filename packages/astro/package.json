{
  "name": "@grove-dev/astro",
  "version": "0.7.0",
  "type": "module",
  "description": "Composable Astro UI, data adapters, and integration for Grove directories.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "grove",
    "astro",
    "ui",
    "directory",
    "components",
    "static-site"
  ],
  "homepage": "https://github.com/tortuvshin/grove#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tortuvshin/grove.git",
    "directory": "packages/astro"
  },
  "bugs": {
    "url": "https://github.com/tortuvshin/grove/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "assets",
    "dist",
    "src/components",
    "src/layouts",
    "src/lib",
    "src/server",
    "src/ui",
    "src/index.ts",
    "src/styles.css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./components/*.astro": "./src/components/*.astro",
    "./components/*": "./src/components/*.astro",
    "./server": "./src/server/index.ts",
    "./server/*": "./dist/server/*.js",
    "./ui/*.astro": "./src/ui/*.astro",
    "./ui/*": "./src/ui/*.ts",
    "./layouts/*.astro": "./src/layouts/*.astro",
    "./layouts/*": "./src/layouts/*.astro"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@grove-dev/core": "workspace:*",
    "astro": "^7.1.3",
    "marked": "^18.0.0",
    "sanitize-html": "^2.17.5",
    "shiki": "^1.29.2",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "astro": "^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.0"
  }
}
