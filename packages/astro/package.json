{
  "name": "@grove-dev/astro",
  "version": "0.1.0",
  "type": "module",
  "description": "Astro UI primitives for Grove directories. Templates live in templates/ and are copied by `grove new`.",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "templates"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./components/*": "./src/components/*.astro",
    "./layouts/*": "./src/layouts/*.astro"
  },
  "scripts": {
    "build": "astro build",
    "check": "astro check",
    "test": "echo \"No astro package tests yet\""
  },
  "dependencies": {
    "@grove-dev/core": "workspace:*",
    "@grove-dev/ui": "workspace:*",
    "astro": "^6.4.4"
  },
  "peerDependencies": {
    "astro": "^6.0.0"
  }
}
