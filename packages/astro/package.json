{
  "name": "@grove-dev/astro",
  "version": "0.2.6",
  "type": "module",
  "description": "Astro framework adapter for Grove. Components, layouts, design tokens, and a default template.",
  "license": "MIT",
  "keywords": [
    "grove",
    "astro",
    "ui",
    "template",
    "components",
    "static-site"
  ],
  "homepage": "https://github.com/tortuvshin/grove#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tortuvshin/grove.git",
    "directory": "packages/astro"
  },
  "bugs": {
    "url": "https://github.com/tortuvshin/grove/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "src",
    "templates",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./components/*.astro": "./src/components/*.astro",
    "./components/*": "./src/components/*.astro",
    "./layouts/*.astro": "./src/layouts/*.astro",
    "./layouts/*": "./src/layouts/*.astro"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"No astro package tests yet\""
  },
  "dependencies": {
    "@grove-dev/core": "workspace:*",
    "@grove-dev/ui": "workspace:*",
    "astro": "^6.4.6"
  },
  "peerDependencies": {
    "astro": "^6.0.0"
  }
}
