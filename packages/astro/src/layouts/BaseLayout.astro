---
// SPDX-License-Identifier: MIT

/**
 * BaseLayout — wraps every page. Owns the theme-detection inline script
 * and the global shell (Header, Footer). Per-page SEO (title, description,
 * OG, JSON-LD) is delegated to <Seo /> so each page can declare what it
 * needs without polluting the layout file.
 */
import "../../styles/global.css";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Seo from "./Seo.astro";

interface Props {
  title: string;
  description: string;
  type?: "website" | "article" | "profile";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  type,
  noindex,
  jsonLd,
} = Astro.props;

const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' rx='3' fill='%2318181b'/%3E%3C/svg%3E";

// Google Analytics 4 — hard-coded Measurement ID for the
// open-apps.dev.mn property. The gtag snippet is injected on every
// page; if you need to silence it for a local preview, comment the
// gtag <script> block below out.
const GA_ID = "G-MB9GWW1LVX";
const gaEnabled = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0c" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={favicon} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM usage guidance" />

    {gaEnabled && (
      <>
        {/* GA4 — gtag.js loader. We send the initial page_view with
            the current path + query string so the dashboard
            distinguishes /apps?stack=flutter from /apps?stack=react
            (otherwise they'd all collapse to /apps). */}
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
        />
        <script is:inline define:vars={{ GA_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag("js", new Date());
          gtag("config", GA_ID, {
            page_path: window.location.pathname + window.location.search,
            page_title: document.title,
          });
        </script>
      </>
    )}

    <Seo
      title={title}
      description={description}
      type={type}
      noindex={noindex}
      jsonLd={jsonLd}
    />

    <slot name="head" />
    <script is:inline>
      (function () {
        var STORAGE_KEY = "open-apps-theme";
        function getMode() {
          var stored = localStorage.getItem(STORAGE_KEY);
          if (stored === "light" || stored === "dark" || stored === "system") return stored;
          return "system";
        }
        function apply(mode) {
          var resolved =
            mode === "system"
              ? (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
              : mode;
          var root = document.documentElement;
          if (resolved === "dark") root.classList.add("dark");
          else root.classList.remove("dark");
          root.dataset.theme = mode;
          root.dataset.resolvedTheme = resolved;
        }
        apply(getMode());
        window.addEventListener("theme:set", function (e) { apply(e.detail); });
        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        mq.addEventListener("change", function () {
          if (getMode() === "system") apply("system");
        });
      })();
    </script>
  </head>
  <body class="min-h-screen bg-white text-ink-900 dark:bg-ink-950 dark:text-ink-100">
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
    <slot name="body-end" />

    {gaEnabled && (
      <script is:inline define:vars={{ GA_ID }}>
        // Mirror in-page SPA navigation (history.pushState /
        // replaceState) into GA4 page_view events so filter
        // changes on /apps show up as separate page views in
        // the dashboard instead of one inflated session.
        (function () {
          var last = location.pathname + location.search;
          function report() {
            var next = location.pathname + location.search;
            if (next === last) return;
            last = next;
            window.gtag("event", "page_view", {
              page_path: next,
              page_title: document.title,
              page_location: location.href,
            });
          }
          window.addEventListener("popstate", report);
          var origPush = history.pushState;
          var origReplace = history.replaceState;
          history.pushState = function () {
            origPush.apply(this, arguments);
            report();
          };
          history.replaceState = function () {
            origReplace.apply(this, arguments);
            report();
          };
        })();
      </script>
    )}

    {gaEnabled && (
      <script is:inline>
        // Delegated click handler for `data-event` elements. We do
        // this in one place so individual components just emit
        // data attributes and stay declarative.
        (function () {
          document.addEventListener("click", function (e) {
            var el = e.target instanceof Element
              ? e.target.closest("[data-event]")
              : null;
            if (!el) return;
            var name = el.getAttribute("data-event");
            if (!name) return;
            var params = {
              source: el.getAttribute("data-event-source") || undefined,
              app_slug: el.getAttribute("data-event-app") || undefined,
              channel: el.getAttribute("data-event-channel") || undefined,
              link_url: el.getAttribute("href") || undefined,
            };
            window.gtag("event", name, params);
          });
        })();
      </script>
    )}
  </body>
</html>
