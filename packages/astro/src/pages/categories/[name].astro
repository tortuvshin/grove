---
/**
 * Reference taxonomy route — render `/categories/<name>/` as a
 * generated collection filtered by `query.categories`.
 *
 * Slugs are enumerated by `getStaticPaths`. Update the fixed list
 * (or replace with a directory scan) to match the taxonomy your
 * site actually publishes.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { runCollection, type Collection, type CollectionEntry } from "@grove-dev/core";
import siteConfig from "@grove/generated/site-config.json";

export function getStaticPaths() {
  return [
    { params: { name: "finance" } },
    { params: { name: "productivity" } },
    { params: { name: "communication" } },
    { params: { name: "developer-tools" } },
  ];
}

const { name } = Astro.params;

const collection: Collection = {
  slug: `category-${name}`,
  kind: "generated",
  title: `${name} apps`,
  description: `Open source apps in the ${name} category.`,
  query: { categories: [name], excludeStatuses: ["archived"] },
  ranking: { preset: "quality" },
  seo: { index: true, title: `${name} apps` },
};

const entries: CollectionEntry[] = [];
const result = runCollection(collection, entries);
const displayName = name
  .split(/[-_]+/)
  .filter(Boolean)
  .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
  .join(" ");
---

<BaseLayout
  title={collection.seo.title ?? collection.title}
  description={collection.description}
  site={siteConfig}
>
  <section class="mx-auto max-w-5xl px-6 py-16" aria-labelledby="category-title">
    <p class="text-xs font-semibold uppercase tracking-widest text-subtle">Category</p>
    <h1
      id="category-title"
      class="mt-3 text-3xl font-bold tracking-tight text-fg sm:text-4xl"
    >
      {displayName} apps
    </h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
      {collection.description}
    </p>

    <div class="mt-10">
      <p class="text-xs font-semibold uppercase tracking-widest text-subtle">
        {result.entries.length}
        {result.entries.length === 1 ? " app" : " apps"}
      </p>

      {result.isEmpty ? (
        <p class="mt-4 text-sm text-muted">No apps in this category yet.</p>
      ) : (
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {result.entries.map((entry) => (
            <li class="rounded-lg border border-border bg-card p-5">
              <h2 class="m-0 text-base font-semibold text-fg">
                <a href={entry.url} class="text-inherit no-underline hover:underline">
                  {entry.title}
                </a>
              </h2>
              {entry.description && (
                <p class="mt-2 text-sm leading-relaxed text-muted">
                  {entry.description}
                </p>
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>
