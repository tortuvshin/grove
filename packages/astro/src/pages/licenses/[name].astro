---
/**
 * Reference taxonomy route — render `/licenses/<name>/` as a
 * generated collection filtered by `query.licenses`.
 *
 * Slugs are enumerated by `getStaticPaths`. Update the fixed list
 * (or replace with a directory scan) to match the license values
 * your site actually publishes.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { runCollection, type Collection, type CollectionEntry } from "@grove-dev/core";
import siteConfig from "@grove/generated/site-config.json";

export function getStaticPaths() {
  return [
    { params: { name: "mit" } },
    { params: { name: "apache-2.0" } },
    { params: { name: "gpl-3.0" } },
    { params: { name: "bsd-3-clause" } },
  ];
}

const { name } = Astro.params;

const collection: Collection = {
  slug: `license-${name}`,
  kind: "generated",
  title: `${name} licensed apps`,
  description: `Open source apps released under the ${name} license.`,
  query: { licenses: [name], excludeStatuses: ["archived"] },
  ranking: { preset: "quality" },
  seo: { index: true, title: `${name} licensed apps` },
};

const entries: CollectionEntry[] = [];
const result = runCollection(collection, entries);
---

<BaseLayout
  title={collection.seo.title ?? collection.title}
  description={collection.description}
  site={siteConfig}
>
  <h1>{collection.title}</h1>
  <p>{collection.description}</p>
  {result.isEmpty ? (
    <p>No apps under this license yet.</p>
  ) : (
    <ol>
      {result.entries.map((entry) => (
        <li>
          <a href={entry.url}>{entry.title}</a>
          <p>{entry.description}</p>
        </li>
      ))}
    </ol>
  )}
</BaseLayout>