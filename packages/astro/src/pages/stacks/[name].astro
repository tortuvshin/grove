---
/**
 * Reference taxonomy route — copy or import in a consumer Astro
 * project to render `/stacks/<name>/` as a generated collection
 * filtered by `query.stacks`.
 *
 * Slugs are enumerated by `getStaticPaths`. Update the fixed list
 * (or replace with a directory scan) to match the taxonomy your
 * site actually publishes.
 *
 * Demonstrates the engine-driven path (`runCollection` + hand-rolled
 * card grid) for consumers who want the collection engine's
 * ranking + dedup + curation logic. The example app uses a simpler
 * `filterRecords` + custom grid pattern; both are valid.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CardGrid from "../../components/CardGrid.astro";
import CollectionRow from "../../components/CollectionRow.astro";
import { runCollection, type Collection, type CollectionEntry } from "@grove-dev/core";
import siteConfig from "@grove/generated/site-config.json";

export function getStaticPaths() {
  return [
    { params: { name: "flutter" } },
    { params: { name: "react-native" } },
    { params: { name: "swift" } },
    { params: { name: "kotlin" } },
  ];
}

const { name } = Astro.params;

const collection: Collection = {
  slug: `stack-${name}`,
  kind: "generated",
  title: `${name} apps`,
  description: `Open source apps built with ${name}.`,
  query: { stacks: [name], excludeStatuses: ["archived"] },
  ranking: { preset: "quality" },
  seo: { index: true, title: `${name} apps` },
};

const entries: CollectionEntry[] = [];
const result = runCollection(collection, entries);
const displayName = name
  .split(/[-_]+/)
  .filter(Boolean)
  .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
  .join(" ");
---

<BaseLayout
  title={collection.seo.title ?? collection.title}
  description={collection.description}
  site={siteConfig}
>
  <section class="mx-auto w-full max-w-wide px-5 py-12 sm:px-7 sm:py-16" aria-labelledby="stack-title">
    <p class="m-0 text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">Stack</p>
    <h1
      id="stack-title"
      class="m-0 mt-2 text-[1.875rem] font-semibold tracking-tight text-ink-900 sm:text-[2.125rem] dark:text-ink-100"
    >
      {displayName} apps
    </h1>
    <p class="m-0 mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-500 dark:text-ink-400">
      {collection.description}
    </p>

    <div class="mt-10">
      <p class="m-0 text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
        {result.entries.length}
        {result.entries.length === 1 ? " app" : " apps"}
      </p>

      {result.isEmpty ? (
        <p class="mt-4 text-sm text-ink-500 dark:text-ink-400">No apps in this stack yet.</p>
      ) : (
        <CardGrid class="mt-6">
          {result.entries.map((entry, i) => (
            <li class="m-0 p-0">
              <CollectionRow entry={entry} eager={i < 3} />
            </li>
          ))}
        </CardGrid>
      )}
    </div>
  </section>
</BaseLayout>
