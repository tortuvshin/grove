---
/**
 * Reference taxonomy route — copy or import in a consumer Astro
 * project to render `/stacks/<name>/` as a generated collection
 * filtered by `query.stacks`.
 *
 * Slugs are enumerated by `getStaticPaths`. Update the fixed list
 * (or replace with a directory scan) to match the taxonomy your
 * site actually publishes.
 *
 * Demonstrates the engine-driven path (`runCollection` + hand-rolled
 * inline `<ol>`) for consumers who want the collection engine's
 * ranking + dedup + curation logic. The example app uses a simpler
 * `filterRecords` + custom grid pattern; both are valid.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import { runCollection, type Collection, type CollectionEntry } from "@grove-dev/core";
import siteConfig from "@grove/generated/site-config.json";

export function getStaticPaths() {
  return [
    { params: { name: "flutter" } },
    { params: { name: "react-native" } },
    { params: { name: "swift" } },
    { params: { name: "kotlin" } },
  ];
}

const { name } = Astro.params;

const collection: Collection = {
  slug: `stack-${name}`,
  kind: "generated",
  title: `${name} apps`,
  description: `Open source apps built with ${name}.`,
  query: { stacks: [name], excludeStatuses: ["archived"] },
  ranking: { preset: "quality" },
  seo: { index: true, title: `${name} apps` },
};

const entries: CollectionEntry[] = [];
const result = runCollection(collection, entries);
---

<BaseLayout
  title={collection.seo.title ?? collection.title}
  description={collection.description}
  site={siteConfig}
>
  <h1>{collection.title}</h1>
  <p>{collection.description}</p>
  {result.isEmpty ? (
    <p>No apps in this stack yet.</p>
  ) : (
    <ol>
      {result.entries.map((entry) => (
        <li>
          <a href={entry.url}>{entry.title}</a>
          <p>{entry.description}</p>
        </li>
      ))}
    </ol>
  )}
</BaseLayout>