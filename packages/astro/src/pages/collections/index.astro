---
/**
 * Reference collection index route — copy or import in a consumer
 * Astro project to render a grid of every collection at
 * `/collections/`. Wraps in `<BaseLayout>` so Header / Footer /
 * theme-init / GA4 ship out of the box.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CollectionIndex from "../../components/CollectionIndex.astro";
import { loadCollections } from "../../lib/load-collections.js";
import {
  recordsToCollectionEntries,
  getCollectionIndexModel,
} from "../../server/index.js";
import fullPayload from "@grove/generated/records.full.json";
import siteConfig from "@grove/generated/site-config.json";

const collections = await loadCollections(process.cwd());
const entries = recordsToCollectionEntries(
  (fullPayload as { records?: unknown[] }).records ?? [],
  siteConfig,
);
const model = getCollectionIndexModel(collections, entries);
const countNoun = {
  singular: siteConfig.blueprintConfig?.labelSingular ?? "item",
  plural: siteConfig.blueprintConfig?.labelPlural ?? "items",
};
---

<BaseLayout
  title="Collections"
  description="Curated and generated directories of related items."
  site={siteConfig}
>
  <CollectionIndex model={model} headingLevel={1} countNoun={countNoun} />
</BaseLayout>