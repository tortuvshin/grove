---
/**
 * Reference collection route — copy or import in a consumer Astro
 * project to render a curated or generated collection at
 * `/collections/<slug>/`.
 *
 * The page enumerates all collection slugs from
 * `<cwd>/data/collections/*.yml`, runs the collection engine against
 * the records generated by `grove check`, and emits a
 * `CollectionPage` component for the body.
 */
import GroveDocumentHead from "../../components/GroveDocumentHead.astro";
import CollectionPage from "../../components/CollectionPage.astro";
import { loadCollections } from "../../lib/load-collections.js";
import {
  recordsToCollectionEntries,
  getCollectionPageModel,
} from "../../server/index.js";
import fullPayload from "@grove/generated/records.full.json";
import siteConfigPayload from "@grove/generated/site-config.json";

export async function getStaticPaths() {
  const collections = await loadCollections(process.cwd());
  return collections.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const collections = await loadCollections(process.cwd());
const collection = collections.find((c) => c.slug === slug);
if (!collection) return Astro.redirect("/404");
if (!Astro.site) {
  throw new Error("Astro.site must be configured for collection routes. Set `site` in astro.config.");
}
const entries = recordsToCollectionEntries(
  (fullPayload as { records?: unknown[] }).records ?? [],
  siteConfigPayload,
);
const model = getCollectionPageModel(collection, entries, collections);
const canonical = new URL(`/collections/${slug}/`, Astro.site);

const doc = {
  identity: { type: "collection" as const, canonical, language: "en" },
  metadata: {
    title: collection.seo.title ?? collection.title,
    description: collection.seo.description ?? collection.description,
    robots: collection.seo.index ? "index,follow" : "noindex,follow",
    openGraph: {
      title: collection.title,
      description: collection.description,
      url: canonical.toString(),
      image: new URL("/og.png", canonical).toString(),
      type: "website" as const,
    },
    twitter: { card: "summary_large_image" as const },
  },
  structuredData: [],
  discovery: {
    includeInSitemap: collection.seo.index,
    includeInLlms: collection.seo.index,
    relatedLinks: model.related.map((r) => ({ url: `/collections/${r.slug}/`, title: r.title })),
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <GroveDocumentHead document={doc} />
  </head>
  <body>
    <CollectionPage
      model={model}
      eyebrow={collection.kind === "curated" ? "Curated collection" : "Generated collection"}
    />
  </body>
</html>
