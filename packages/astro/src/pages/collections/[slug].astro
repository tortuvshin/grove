---
/**
 * Reference collection route — copy or import in a consumer Astro
 * project to render a curated or generated collection at
 * `/collections/<slug>/`.
 *
 * The page enumerates all collection slugs from
 * `<cwd>/data/collections/*.yml`, runs the collection engine against
 * the records generated by `grove check`, and emits a
 * `CollectionPage` component for the body inside the package's
 * `<BaseLayout>` so Header / Footer / theme-init / GA4 ship out
 * of the box.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import CollectionPage from "../../components/CollectionPage.astro";
import { loadCollections } from "../../lib/load-collections.js";
import {
  recordsToCollectionEntries,
  getCollectionPageModel,
} from "../../server/index.js";
import fullPayload from "@grove/generated/records.full.json";
import siteConfig from "@grove/generated/site-config.json";

export async function getStaticPaths() {
  const collections = await loadCollections(process.cwd());
  return collections.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const collections = await loadCollections(process.cwd());
const collection = collections.find((c) => c.slug === slug);
if (!collection) return Astro.redirect("/404");
const entries = recordsToCollectionEntries(
  (fullPayload as { records?: unknown[] }).records ?? [],
  siteConfig,
);
const model = getCollectionPageModel(collection, entries, collections);
---

<BaseLayout
  title={collection.seo.title ?? collection.title}
  description={collection.seo.description ?? collection.description}
  site={siteConfig}
  type="article"
>
  <CollectionPage
    model={model}
    eyebrow={collection.kind === "curated" ? "Curated collection" : "Generated collection"}
    countNoun={{
      singular: siteConfig.blueprintConfig?.labelSingular ?? "item",
      plural: siteConfig.blueprintConfig?.labelPlural ?? "items",
    }}
  />
</BaseLayout>