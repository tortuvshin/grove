---
/**
 * ItemSection — generic lens-style section wrapper.
 *
 * Mirrors openapps' `AppSection.astro` but accepts the framework-
 * generic `IndexRecord` discriminated union (`IndexProjectRecord`
 * / `IndexResourceRecord` / `IndexEntityRecord`) so the same
 * component works for all three Grove blueprints (project-directory,
 * resource-hub, ecosystem-map) without per-blueprint forks.
 *
 * Each `ItemCard` is rendered with the consumer's `pathPrefix`
 * (e.g. `/projects`, `/resources`, `/entities`) so the detail-page
 * link is blueprint-correct.
 */
import type { IndexRecord } from "@grove-dev/core";
import ItemCard from "./ItemCard.astro";
import Container from "../layouts/Container.astro";
import SectionHeader from "../layouts/SectionHeader.astro";

interface Props {
  id: string;
  title: string;
  /** Plain-language subtitle explaining the lens. */
  description: string;
  items: IndexRecord[];
  /** URL prefix for the detail page (e.g. `/projects`). */
  pathPrefix: string;
  /** Optional eyebrow text shown above the title. */
  eyebrow?: string;
  /** Where the "View all" link points (typically the index page with
   *  a filter applied). */
  viewAllHref?: string;
  /** Custom label for the "View all" link. */
  viewAllLabel?: string;
}

const {
  id,
  title,
  description,
  items,
  pathPrefix,
  eyebrow,
  viewAllHref = "#",
  viewAllLabel = "View all",
} = Astro.props;

const visible = items.slice(0, 6);
---

<section id={id} class="grove-section scroll-mt-20">
  <Container>
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <SectionHeader
        eyebrow={eyebrow}
        title={title}
        description={description}
      />
      <a
        href={viewAllHref}
        class="hidden shrink-0 pb-2 text-2xs font-medium text-ink-500 transition-colors hover:text-ink-900 sm:inline dark:text-ink-400 dark:hover:text-ink-100"
      >
        {viewAllLabel} →
      </a>
    </div>

    <div
      class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3"
    >
      {visible.map((item) => <ItemCard item={item} pathPrefix={pathPrefix} />)}
    </div>

    <div class="mt-4 sm:hidden">
      <a
        href={viewAllHref}
        class="text-2xs font-medium text-ink-500 transition-colors hover:text-ink-900 dark:text-ink-400 dark:hover:text-ink-100"
        >{viewAllLabel} →</a
      >
    </div>
  </Container>
</section>
