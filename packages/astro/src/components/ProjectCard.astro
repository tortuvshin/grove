---
/**
 * ProjectCard — three-column-grid card for one directory record.
 *
 * V1 (v0.5.0) refined design for the three-column hero grid:
 *
 *   - Whole card is one clickable surface (cursor: pointer, subtle
 *     border + surface lift on hover, no more than 1–2px vertical
 *     motion).
 *   - App icon top-left (44–48px), preserves the original brand color
 *     in both themes.
 *   - App name (17–18px, semibold) + repository owner/repo (13px,
 *     muted), with safe truncation.
 *   - Two-line description (line-clamp-2) with reserved vertical
 *     space so all cards in the row align.
 *   - Stack/platform logos only — icon size 20–22px, gap 10px, no
 *     pill containers. Up to 4 logos, +N overflow chip.
 *   - Footer row: stack logos left, stars/updated right (only when
 *     present), and the navigation arrow anchored bottom-right.
 *   - No category badges, status pills, license text, "curated"
 *     marker, STACK/PLATFORM labels, or placeholder "Updated —".
 *
 * Uses the package's design-system tokens plus the standard `dark:`
 * variant. Equal-height cards in the row are achieved at the grid
 * level (`grid` + `items-stretch`).
 */
import type { IndexRecord, Resource, ProjectRecord, IndexProjectRecord } from "@grove-dev/core";
import { getOwnerAndRepoFromRepoUrl, getOwnerAvatarUrl, formatRelative, formatStars } from "@grove-dev/astro";

type CardRecord = IndexRecord | Resource | ProjectRecord | IndexProjectRecord;

interface Props {
  /** Record to render. */
  record: CardRecord;
  /** Full detail-page URL. */
  href: string;
  /** Optional pre-resolved logo URL. Wins over the GitHub avatar. */
  logoUrl?: string;
  /** Override the description (defaults to `record.description`). */
  description?: string;
}

const {
  record,
  href,
  logoUrl: logoUrlProp,
  description: descriptionProp,
} = Astro.props;

const isProject = record.kind === "project";
const name =
  record.kind === "resource"
    ? (record as { title: string }).title
    : (record as { name: string }).name;
const repoHref = isProject
  ? (record as { repoUrl?: string }).repoUrl
  : (record as { links: { github?: string } }).links?.github;

const { owner, repo } = getOwnerAndRepoFromRepoUrl(repoHref ?? "");
const avatarUrl =
  logoUrlProp ??
  (isProject ? (record as { logoUrl?: string }).logoUrl : undefined) ??
  getOwnerAvatarUrl(owner, 80);

// Initials placeholder for when there's no logo.
const initials = (name ?? "")
  .split(/\s+/)
  .map((w) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join("")
  .toUpperCase();

const description =
  descriptionProp ?? (record as { description?: string }).description ?? "";

const platforms = isProject ? ((record as { platforms?: string[] }).platforms ?? []) : [];
const stars = isProject
  ? (record as { github?: { stars?: number } }).github?.stars
  : undefined;
const pushedAt = isProject
  ? (record as { github?: { pushedAt?: string | null } }).github?.pushedAt
  : (record as { publishedAt?: string | null }).publishedAt;

const starsLabel = formatStars(stars);
const updatedLabel = formatRelative(pushedAt);

const hasStars = starsLabel !== null && typeof stars === "number" && stars > 0;
const hasUpdated = Boolean(pushedAt);

// Platform → inline SVG mapping. Recognisable brand logos only,
// rendered at native colors so the cards stay vibrant in dark mode.
const platformIcons: Record<string, { label: string; svg: string }> = {
  flutter: {
    label: "Flutter",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="#54C5F8" d="M14.314 0 2.5 11.836l3.317 3.318L14.314 6.636 21 0h-6.686Z"/><path fill="#01579B" d="m14.314 11.838-7.18 7.18 3.318 3.318 10.546-10.498h-6.684Z"/><path fill="#F1F1F1" d="m5.798 17.682 3.317 3.318 5.198-5.198h-6.635l-1.88 1.88Z"/></svg>',
  },
  apple: {
    label: "Apple",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08ZM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25Z"/></svg>',
  },
  ios: {
    label: "iOS",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08ZM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25Z"/></svg>',
  },
  macos: {
    label: "macOS",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08ZM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25Z"/></svg>',
  },
  android: {
    label: "Android",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="#3DDC84" d="M17.523 15.34a1.05 1.05 0 1 0 0-2.1 1.05 1.05 0 0 0 0 2.1m-11.046 0a1.05 1.05 0 1 0 0-2.1 1.05 1.05 0 0 0 0 2.1m11.473-6.107 1.834-3.183a.45.45 0 1 0-.797-.422l-1.86 3.23a13.05 13.05 0 0 0-5.59 0L8.005 5.628a.45.45 0 1 0-.797.422l1.834 3.183C5.39 10.456 2.5 13.42 2.5 17.07h19c0-3.65-2.89-6.614-6.55-7.836"/></svg>',
  },
  linux: {
    label: "Linux",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.41 2.485 0 .842.158 1.632.474 2.41l.176.485c-.61.745-1.347 1.748-1.464 2.964-.026.243-.038.476-.038.7 0 1.79.825 3.018 2.213 3.633.835.398 1.834.645 2.997.704.21.018.42.027.628.027 1.34 0 2.453-.314 3.32-.94.84-.604 1.293-1.443 1.293-2.486v-.066c.015-.282.06-.575.123-.875l.05-.207c.176-.704.443-1.36.756-1.97l.155-.296c.193-.342.387-.617.578-.82.166-.176.345-.282.563-.282h.005c.218 0 .397.106.563.282.19.203.385.478.578.82l.155.296c.313.61.58 1.266.756 1.97l.05.207c.063.3.108.593.123.875v.066c0 1.043.453 1.882 1.293 2.486.867.626 1.98.94 3.32.94.207 0 .418-.009.627-.027 1.164-.06 2.163-.306 2.998-.704 1.388-.615 2.213-1.843 2.213-3.633 0-.224-.012-.457-.038-.7-.117-1.216-.853-2.22-1.464-2.964l.176-.485c.316-.778.474-1.568.474-2.41 0-.8-.132-1.653-.41-2.485-.59-1.77-1.832-3.47-2.716-4.521-.751-1.067-.975-1.928-1.05-3.02-.065-1.491 1.056-5.965-3.17-6.298-.165-.013-.325-.021-.48-.021zM9.04 7.06c-.41 0-.748.41-.748 1.064 0 .654.337 1.064.748 1.064.41 0 .748-.41.748-1.064 0-.654-.337-1.064-.748-1.064zm5.92 0c-.41 0-.748.41-.748 1.064 0 .654.337 1.064.748 1.064.41 0 .748-.41.748-1.064 0-.654-.337-1.064-.748-1.064z"/></svg>',
  },
  web: {
    label: "Web",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>',
  },
  windows: {
    label: "Windows",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="#0078D4" d="M0 3.5 10.5 2v9.5H0Zm0 9 10.5-1.5V21L0 19.5Zm11.5-10.7L24 0v11.5H11.5Zm0 9.7H24V24l-12.5-1.5Z"/></svg>',
  },
  "react-native": {
    label: "React Native",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="1.6" fill="#61DAFB"/><path fill="none" stroke="#61DAFB" stroke-width="1.2" d="M12 4.5c4.1 0 7.5 1.3 7.5 3 0 1.7-3.4 4-7.5 7.5C7.9 11.5 4.5 9.2 4.5 7.5c0-1.7 3.4-3 7.5-3Z"/><path fill="none" stroke="#61DAFB" stroke-width="1.2" d="M8 7c2-2.7 5-3.6 6.6-2 1.6 1.6.6 4.5-2 7.1-2.6 2.6-5.5 3.6-7.1 2C4 12.5 5.9 9.7 8 7Z"/></svg>',
  },
  tauri: {
    label: "Tauri",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="#FFC131"/><path fill="#1f1f1f" d="M8 8h8v8H8z" opacity=".35"/><path fill="#1f1f1f" d="M9.5 8h5l-2.5 8h-5z"/></svg>',
  },
};

const visiblePlatforms = platforms.slice(0, 4);
const platformOverflow = platforms.length - visiblePlatforms.length;
const hasPlatforms = visiblePlatforms.some((p) => platformIcons[p.toLowerCase()]);
---

<a
  href={href}
  aria-label={`Open ${name}`}
  class="groove-project-card group relative flex h-full min-w-0 flex-col gap-3 rounded-xl border border-ink-200 bg-background p-5 outline-none transition-[border-color,background-color,transform] duration-150 hover:-translate-y-0.5 hover:border-ink-300 hover:bg-ink-50 focus-visible:border-ink-500 focus-visible:ring-2 focus-visible:ring-ink-900/15 dark:border-ink-800 dark:hover:border-ink-700 dark:hover:bg-ink-900 dark:focus-visible:border-ink-500 dark:focus-visible:ring-ink-100/15"
  data-record-slug={(record as { slug: string }).slug}
>
  {/* Header: icon + name + owner */}
  <header class="flex items-start gap-3">
    {avatarUrl ? (
      <img
        src={avatarUrl}
        alt=""
        width="48"
        height="48"
        loading="lazy"
        decoding="async"
        class="h-12 w-12 shrink-0 rounded-lg bg-white object-contain p-1 dark:bg-white"
      />
    ) : (
      <span
        aria-hidden="true"
        class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-ink-100 text-base font-semibold uppercase text-ink-700 dark:bg-ink-800 dark:text-ink-200"
      >
        {initials}
      </span>
    )}

    <div class="flex min-w-0 flex-1 flex-col gap-0.5">
      <h3 class="m-0 truncate text-[17px] font-semibold leading-snug tracking-tight text-ink-900 sm:text-[18px] dark:text-ink-100">
        {name}
      </h3>
      {owner && repo && (
        <p class="m-0 truncate font-mono text-[13px] text-ink-500 dark:text-ink-400">
          {owner}<span class="opacity-60">/</span>{repo}
        </p>
      )}
    </div>
  </header>

  {/* Description — two-line clamp with reserved vertical space */}
  <p
    class="m-0 line-clamp-2 min-h-[42px] text-[14px] leading-[1.5] text-ink-500 dark:text-ink-400"
  >
    {description}
  </p>

  {/* Footer: platform logos · meta · arrow */}
  <footer class="mt-auto flex items-center justify-between gap-3 text-[12px] sm:text-[13px]">
    <div class="flex min-w-0 items-center gap-2.5 text-ink-500 dark:text-ink-400">
      {hasPlatforms ? (
        <div class="flex items-center gap-2.5">
          {visiblePlatforms.map((platform) => {
            const key = platform.toLowerCase();
            const icon = platformIcons[key];
            if (!icon) return null;
            return (
              <span
                class="inline-flex shrink-0 items-center justify-center"
                role="img"
                title={icon.label}
                aria-label={icon.label}
              >
                <Fragment set:html={icon.svg} />
              </span>
            );
          })}
          {platformOverflow > 0 && (
            <span class="text-[12px] text-ink-500 dark:text-ink-400">+{platformOverflow}</span>
          )}
        </div>
      ) : (
        <span aria-hidden="true"></span>
      )}
    </div>

    <div class="flex min-w-0 items-center gap-3 text-ink-500 dark:text-ink-400">
      {hasStars && (
        <span class="inline-flex items-center gap-1" title={`${stars ?? 0} stars on GitHub`}>
          <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" fill="currentColor" class="text-amber-500">
            <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/>
          </svg>
          <span class="font-mono">{starsLabel}</span>
        </span>
      )}
      {hasUpdated && (
        <span class="whitespace-nowrap" title={`Last updated ${pushedAt}`}>
          Updated {updatedLabel}
        </span>
      )}
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="shrink-0 text-ink-400 transition-colors group-hover:text-ink-700 dark:text-ink-500 dark:group-hover:text-ink-100"
      >
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </div>
  </footer>
</a>