---
/**
 * ProjectCard — large-format card for one directory record.
 *
 * Visual recipe (top to bottom):
 *   - Logo block (rounded square, 64×64) on the left
 *   - Name + owner/repo stacked beside the logo
 *   - Description (up to two lines, large)
 *   - Platform icons row
 *   - Footer row: stars count, last-updated, arrow link to the
 *     detail page on the right
 *
 * Uses the package's design-system tokens plus the standard `dark:`
 * variant so the card honors the user's theme preference and
 * matches the rest of the page automatically. Card dimensions
 * (paddings, gaps, font sizes) match the existing `ItemCard`
 * baseline so the layout stays consistent.
 */
import type { IndexRecord, Resource, ProjectRecord, IndexProjectRecord } from "@grove-dev/core";
import { getOwnerAndRepoFromRepoUrl, getOwnerAvatarUrl, formatRelative, formatStars } from "@grove-dev/astro";

type CardRecord = IndexRecord | Resource | ProjectRecord | IndexProjectRecord;

interface Props {
  /** Record to render. */
  record: CardRecord;
  /** Full detail-page URL. */
  href: string;
  /** Optional pre-resolved logo URL. Wins over the GitHub avatar. */
  logoUrl?: string;
  /** Override the description (defaults to `record.description`). */
  description?: string;
}

const {
  record,
  href,
  logoUrl: logoUrlProp,
  description: descriptionProp,
} = Astro.props;

const isProject = record.kind === "project";
const name =
  record.kind === "resource"
    ? (record as { title: string }).title
    : (record as { name: string }).name;
const repoHref = isProject
  ? (record as { repoUrl?: string }).repoUrl
  : (record as { links: { github?: string } }).links?.github;

const { owner, repo } = getOwnerAndRepoFromRepoUrl(repoHref ?? "");
const avatarUrl =
  logoUrlProp ??
  (isProject ? (record as { logoUrl?: string }).logoUrl : undefined) ??
  getOwnerAvatarUrl(owner, 80);

// Initials placeholder for when there's no logo.
const initials = (name ?? "")
  .split(/\s+/)
  .map((w) => w[0])
  .filter(Boolean)
  .slice(0, 2)
  .join("")
  .toUpperCase();

const description =
  descriptionProp ?? (record as { description?: string }).description ?? "";

const platforms = isProject ? ((record as { platforms?: string[] }).platforms ?? []) : [];
const stars = isProject
  ? (record as { github?: { stars?: number } }).github?.stars
  : undefined;
const pushedAt = isProject
  ? (record as { github?: { pushedAt?: string | null } }).github?.pushedAt
  : (record as { publishedAt?: string | null }).publishedAt;

const starsLabel = formatStars(stars);
const updatedLabel = formatRelative(pushedAt);

// Platform → inline SVG mapping. We avoid external image requests by
// emitting small SVGs directly in the markup.
const platformIcons: Record<string, { label: string; svg: string }> = {
  flutter: {
    label: "Flutter",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="#54C5F8" d="M14.314 0 2.5 11.836l3.317 3.318L14.314 6.636 21 0h-6.686Z"/><path fill="#01579B" d="m14.314 11.838-7.18 7.18 3.318 3.318 10.546-10.498h-6.684Z"/><path fill="#F1F1F1" d="m5.798 17.682 3.317 3.318 5.198-5.198h-6.635l-1.88 1.88Z"/></svg>',
  },
  apple: {
    label: "Apple",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08ZM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25Z"/></svg>',
  },
  ios: {
    label: "iOS",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M17.05 20.28c-.98.95--3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08ZM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25Z"/></svg>',
  },
  macos: {
    label: "macOS",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08ZM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25Z"/></svg>',
  },
  android: {
    label: "Android",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="#3DDC84" d="M17.523 15.34a1.05 1.05 0 1 0 0-2.1 1.05 1.05 0 0 0 0 2.1m-11.046 0a1.05 1.05 0 1 0 0-2.1 1.05 1.05 0 0 0 0 2.1m11.473-6.107 1.834-3.183a.45.45 0 1 0-.797-.422l-1.86 3.23a13.05 13.05 0 0 0-5.59 0L8.005 5.628a.45.45 0 1 0-.797.422l1.834 3.183C5.39 10.456 2.5 13.42 2.5 17.07h19c0-3.65-2.89-6.614-6.55-7.836"/></svg>',
  },
  linux: {
    label: "Linux",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12.504 0c-.155 0-.315.008-.48.021-4.226.333-3.105 4.807-3.17 6.298-.076 1.092-.3 1.953-1.05 3.02-.885 1.051-2.127 2.75-2.716 4.521-.278.832-.41 1.684-.41 2.485 0 .842.158 1.632.474 2.41l.176.485c-.61.745-1.347 1.748-1.464 2.964-.026.243-.038.476-.038.7 0 1.79.825 3.018 2.213 3.633.835.398 1.834.645 2.997.704.21.018.42.027.628.027 1.34 0 2.453-.314 3.32-.94.84-.604 1.293-1.443 1.293-2.486v-.066c.015-.282.06-.575.123-.875l.05-.207c.176-.704.443-1.36.756-1.97l.155-.296c.193-.342.387-.617.578-.82.166-.176.345-.282.563-.282h.005c.218 0 .397.106.563.282.19.203.385.478.578.82l.155.296c.313.61.58 1.266.756 1.97l.05.207c.063.3.108.593.123.875v.066c0 1.043.453 1.882 1.293 2.486.867.626 1.98.94 3.32.94.207 0 .418-.009.627-.027 1.164-.06 2.163-.306 2.998-.704 1.388-.615 2.213-1.843 2.213-3.633 0-.224-.012-.457-.038-.7-.117-1.216-.853-2.22-1.464-2.964l.176-.485c.316-.778.474-1.568.474-2.41 0-.8-.132-1.653-.41-2.485-.59-1.77-1.832-3.47-2.716-4.521-.751-1.067-.975-1.928-1.05-3.02-.065-1.491 1.056-5.965-3.17-6.298-.165-.013-.325-.021-.48-.021ZM9.04 7.06c.41 0 .748.41.41 1.064 0 .654-.337 1.064-.748 1.064-.41 0-.748-.41-.748-1.064 0-.654.337-1.064.748-1.064m5.92 0c.41 0 .748.748 1.064 0 .654-.337 1.064-.748 1.064-.41 0-.748-.41-.748-1.064 0-.654.337-1.064.748-1.064"/></svg>',
  },
  web: {
    label: "Web",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>',
  },
  windows: {
    label: "Windows",
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="#0078D4" d="M0 3.5 10.5 2v9.5H0Zm0 9 10.5-1.5V21L0 19.5Zm11.5-10.7L24 0v11.5H11.5Zm0 9.7H24V24l-12.5-1.5Z"/></svg>',
  },
};

const visiblePlatforms = platforms.slice(0, 4);
const platformOverflow = platforms.length - visiblePlatforms.length;
---

<article
  class="group relative flex items-stretch gap-4 rounded-xl border border-ink-200 bg-card p-5 transition-colors hover:bg-card-hover sm:p-6 dark:border-ink-800 dark:bg-ink-900 dark:hover:bg-ink-800"
  data-record-slug={(record as { slug: string }).slug}
>
  {/* Logo block */}
  {avatarUrl ? (
    <img
      src={avatarUrl}
      alt=""
      width="64"
      height="64"
      loading="lazy"
      decoding="async"
      class="h-16 w-16 shrink-0 rounded-2xl border border-ink-200 bg-white object-contain p-2 shadow-sm dark:border-ink-700 dark:bg-white"
    />
  ) : (
    <span
      aria-hidden="true"
      class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl border border-ink-200 bg-white text-2xl font-semibold text-ink-900 shadow-sm dark:border-ink-700 dark:bg-white dark:text-ink-900"
    >
      {initials}
    </span>
  )}

  <div class="flex min-w-0 flex-1 flex-col gap-3">
    {/* Title block */}
    <div class="flex items-start justify-between gap-3">
      <div class="flex min-w-0 flex-1 flex-col gap-0.5">
        <h3 class="m-0 truncate text-xl font-semibold leading-tight tracking-tight text-ink-900 dark:text-ink-100">
          <a
            href={href}
            class="inline-flex min-h-6 items-center text-inherit no-underline group-hover:underline"
          >
            {name}
          </a>
        </h3>
        {owner && repo && (
          <p class="m-0 truncate font-mono text-sm text-ink-500 dark:text-ink-400">
            {owner}<span class="opacity-60">/</span>{repo}
          </p>
        )}
      </div>
      <a
        href={href}
        aria-label={`Open ${name}`}
        class="inline-flex shrink-0 items-center justify-center text-ink-400 transition-colors group-hover:text-ink-900 dark:text-ink-500 dark:group-hover:text-ink-100"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

    {/* Description */}
    {description && (
      <p class="m-0 text-base leading-relaxed text-ink-700 dark:text-ink-200">
        {description}
      </p>
    )}

    {/* Platform icons row */}
    {visiblePlatforms.length > 0 && (
      <div class="flex items-center gap-2" aria-label="Supported platforms">
        {visiblePlatforms.map((platform) => {
          const key = platform.toLowerCase();
          const icon = platformIcons[key];
          if (!icon) return null;
          return (
            <span
              class="inline-flex items-center justify-center text-ink-700 dark:text-ink-300"
              title={icon.label}
              aria-label={icon.label}
            >
              <Fragment set:html={icon.svg} />
            </span>
          );
        })}
        {platformOverflow > 0 && (
          <span class="text-xs text-ink-500 dark:text-ink-400">+{platformOverflow}</span>
        )}
      </div>
    )}

    {/* Footer row */}
    <div class="mt-auto flex items-center gap-4 text-sm text-ink-500 dark:text-ink-400">
      {starsLabel !== null && (
        <span class="inline-flex items-center gap-1.5">
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="currentColor" class="text-amber-500">
            <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/>
          </svg>
          <span class="font-mono">{starsLabel}</span>
        </span>
      )}
      {pushedAt && (
        <span>Updated {updatedLabel}</span>
      )}
    </div>
  </div>
</article>