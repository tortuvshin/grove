---
import { siteConfig } from "../data/site-config";
import BaseLayout from "../components/layout/BaseLayout.astro";
import Container from "../components/layout/Container.astro";

const title = `About — ${siteConfig.name}`;
const description = `About ${siteConfig.name} — ${siteConfig.tagline}`;
---

<BaseLayout title={title} description={description}>
  <Container>
    <article class="py-12 sm:py-16">
      <span class="text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
        About
      </span>
      <h1 class="mt-1 text-[1.75rem] sm:text-[2.25rem] font-semibold tracking-tight text-ink-900 dark:text-ink-100 m-0">
        About {siteConfig.name}
      </h1>
      <p class="mt-4 max-w-[62ch] text-base text-ink-700 dark:text-ink-200 m-0">
        {siteConfig.name} is a community knowledge site built with{" "}
        <a
          href="https://github.com/tortuvshin/grove"
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-900 underline hover:text-ink-700 dark:text-ink-100 dark:hover:text-white"
        >
          Grove
        </a>{" "}
        — an open-source framework for growing useful structured knowledge.
      </p>

      <section class="mt-8">
        <h2 class="m-0 text-lg font-semibold tracking-tight text-ink-900 dark:text-ink-100">
          How it works
        </h2>
        <p class="mt-2 max-w-[62ch] text-sm text-ink-700 dark:text-ink-200 m-0">
          Records live in <code class="font-mono text-ink-900 dark:text-ink-100">data/records/</code> as
          YAML files. Each record is one entry — a project, a resource, or an entity,
          depending on the blueprint configured in <code class="font-mono">grove.config.ts</code>.
        </p>
        <p class="mt-2 max-w-[62ch] text-sm text-ink-700 dark:text-ink-200 m-0">
          Run <code class="font-mono">grove validate</code> to check the schema,{" "}
          <code class="font-mono">grove generate</code> to build the index,
          and <code class="font-mono">grove build</code> to produce the static site.
        </p>
      </section>

      <section class="mt-8">
        <h2 class="m-0 text-lg font-semibold tracking-tight text-ink-900 dark:text-ink-100">
          Contributing
        </h2>
        <p class="mt-2 max-w-[62ch] text-sm text-ink-700 dark:text-ink-200 m-0">
          Open a pull request with a new YAML file under{" "}
          <code class="font-mono">data/records/</code>. The schema is validated
          automatically on every PR. A maintainer will review and merge.
        </p>
      </section>

      <section class="mt-8">
        <h2 class="m-0 text-lg font-semibold tracking-tight text-ink-900 dark:text-ink-100">
          Blueprint
        </h2>
        <p class="mt-2 max-w-[62ch] text-sm text-ink-700 dark:text-ink-200 m-0">
          This site runs the <code class="font-mono">{siteConfig.blueprint}</code> blueprint.
          {siteConfig.blueprint === "project-directory" && (
            <> Records are <code class="font-mono">kind: project</code>.</>
          )}
          {siteConfig.blueprint === "resource-hub" && (
            <> Records are <code class="font-mono">kind: resource</code>.</>
          )}
          {siteConfig.blueprint === "ecosystem-map" && (
            <> Records are <code class="font-mono">kind: entity</code>.</>
          )}
        </p>
      </section>
    </article>
  </Container>
</BaseLayout>
