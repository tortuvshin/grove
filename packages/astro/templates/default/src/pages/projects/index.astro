---
import { siteConfig, indexSlug, itemLabel } from "../../data/site-config";
import { records, projects } from "../../data/records";
import BaseLayout from "../../components/layout/BaseLayout.astro";
import Container from "../../components/layout/Container.astro";
import ItemCard from "@grove-dev/astro/components/ItemCard.astro";

const slug = indexSlug();
const list = projects.length > 0 ? projects : records;
const total = list.length;

const title = `Browse ${slug} — ${siteConfig.name}`;
const description = `A searchable directory of ${slug} for ${siteConfig.name}.`;

const facets: Record<string, Map<string, number>> = {
  category: new Map(),
  tags: new Map(),
};
for (const record of list) {
  facets.category!.set(record.category, (facets.category!.get(record.category) ?? 0) + 1);
  for (const tag of record.tags ?? []) {
    facets.tags!.set(tag, (facets.tags!.get(tag) ?? 0) + 1);
  }
}

const categories = [...facets.category!.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));
const tags = [...facets.tags!.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 20)
  .map(([name, count]) => ({ name, count }));

const q = Astro.url.searchParams.get("q")?.toLowerCase().trim() ?? "";
const cat = Astro.url.searchParams.get("category") ?? "";
const tag = Astro.url.searchParams.get("tag") ?? "";

const filtered = list.filter((r) => {
  if (q) {
    const hay = `${(r.kind === "resource" ? r.title : r.name)} ${r.description}`.toLowerCase();
    if (!hay.includes(q)) return false;
  }
  if (cat && r.category !== cat) return false;
  if (tag && !(r.tags ?? []).includes(tag)) return false;
  return true;
});
---

<BaseLayout title={title} description={description}>
  <section class="border-b border-ink-200 dark:border-ink-800">
    <Container>
      <div class="py-8 sm:py-10">
        <span class="text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
          {slug}
        </span>
        <h1 class="mt-1 text-[1.75rem] sm:text-[2rem] font-semibold tracking-tight text-ink-900 dark:text-ink-100 m-0">
          Browse {slug}
        </h1>
        <p class="mt-2 max-w-[64ch] text-[0.9375rem] text-ink-500 dark:text-ink-400 m-0">
          Search, filter, and explore {total} {itemLabel()}{total === 1 ? "" : "s"} in this directory.
        </p>

        <form class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center" role="search">
          <label class="relative flex-1">
            <span class="sr-only">Search</span>
            <input
              type="search"
              name="q"
              value={q}
              placeholder={`Search by name, description, or category...`}
              autocomplete="off"
              class="w-full rounded-md border border-ink-200 bg-white py-2 px-3 text-sm focus:border-ink-900 focus:outline-none focus:ring-2 focus:ring-ink-900/10 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-100"
            />
          </label>
          {cat && <input type="hidden" name="category" value={cat} />}
          {tag && <input type="hidden" name="tag" value={tag} />}
          <button type="submit" class="rounded-md bg-ink-900 px-4 py-2 text-sm font-medium text-white hover:bg-ink-700 dark:bg-ink-100 dark:text-ink-900 dark:hover:bg-white">
            Search
          </button>
        </form>
      </div>
    </Container>
  </section>

  {categories.length > 0 && (
    <section class="border-b border-ink-200 dark:border-ink-800">
      <Container>
        <div class="py-4">
          <div class="flex flex-wrap items-center gap-2">
            <span class="text-2xs font-semibold uppercase tracking-wider text-ink-500 dark:text-ink-400">
              Category
            </span>
            <a
              href={`/${slug}`}
              class={`rounded-full border px-2.5 py-0.5 text-2xs font-medium transition-colors ${
                !cat
                  ? "border-ink-900 bg-ink-900 text-white dark:border-ink-100 dark:bg-ink-100 dark:text-ink-900"
                  : "border-ink-200 text-ink-700 hover:border-ink-300 dark:border-ink-800 dark:text-ink-300"
              }`}
            >
              All
            </a>
            {categories.map((c) => (
              <a
                href={`/${slug}?category=${encodeURIComponent(c.name)}`}
                class={`rounded-full border px-2.5 py-0.5 text-2xs font-medium transition-colors ${
                  cat === c.name
                    ? "border-ink-900 bg-ink-900 text-white dark:border-ink-100 dark:bg-ink-100 dark:text-ink-900"
                    : "border-ink-200 text-ink-700 hover:border-ink-300 dark:border-ink-800 dark:text-ink-300"
                }`}
              >
                {c.name} <span class="text-ink-400">({c.count})</span>
              </a>
            ))}
          </div>
        </div>
      </Container>
    </section>
  )}

  <section>
    <Container>
      <div class="py-8 sm:py-10">
        {filtered.length === 0 ? (
          <div class="flex flex-col items-center gap-2 py-16 text-center">
            <p class="m-0 text-[0.9375rem] font-medium text-ink-700 dark:text-ink-200">
              No {itemLabel()}s match these filters.
            </p>
            <a href={`/${slug}`} class="mt-3 text-sm text-ink-500 hover:text-ink-900 dark:hover:text-ink-100">
              Clear all filters
            </a>
          </div>
        ) : (
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {filtered.map((record) => (
              <ItemCard record={record} href={`/${slug}/${record.slug}`} />
            ))}
          </div>
        )}
      </div>
    </Container>
  </section>
</BaseLayout>
