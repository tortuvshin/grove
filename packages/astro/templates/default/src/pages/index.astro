---
/**
 *  Home page — the showcase's front door.
 *
 *  Sections (in order):
 *   1. Hero                       — brand + search + stats row
 *   2. WhyThisExists              — 3 short value-prop points
 *   3. RecordSection "Trending"   — hot lens (curation OR stars >= 1000 OR pushed <= 30d)
 *   4. RecordSection "Recently added" — new lens (curation OR pushed <= 7d)
 *   5. RecordSection "Established" — mature lens (tier=curated, pushed > 365d)
 *   6. StackGrid                  — browse by stack
 *   7. CategoryGrid               — browse by category
 *   8. ContributorsGrid           — top contributors (when contributors.json is present)
 *   9. OriginalCollection         — origin-card link to the source repo
 *
 *  Every section is defensive: with 0 records (fresh scaffold) it
 *  renders a graceful empty state instead of throwing.
 *
 *  Generic: the home page works for all 3 blueprints (project
 *  directory, resource hub, ecosystem map). The active kind
 *  comes from `siteConfig.blueprintConfig`, the URL slug from
 *  `indexSlug()`, the human label from `itemLabel()`. Sections
 *  that need project-only fields (stars, pushedAt) safely fall
 *  back to "no match" when the active blueprint is `resource` or
 *  `entity` — so resource hubs still render Hot/New/Mature but
 *  with the empty state.
 *
 *  Stats come from `siteConfig.stats` (derived at generate time from
 *  the records themselves). Pages never re-derive counts — that
 *  guarantees the hero, origin card, and contributors page all show
 *  the same numbers.
 */
import siteConfig from "../../data/generated/site-config.json";
import {
  items,
  indexSlug,
  itemLabel,
  itemLabelPlural,
} from "../data/records";
import BaseLayout from "@grove-dev/astro/layouts/BaseLayout.astro";
import Hero from "@grove-dev/astro/components/Hero.astro";
import WhyThisExists from "@grove-dev/astro/components/WhyThisExists.astro";
import RecordSection from "@grove-dev/astro/components/RecordSection.astro";
import StackGrid from "@grove-dev/astro/components/StackGrid.astro";
import CategoryGrid from "@grove-dev/astro/components/CategoryGrid.astro";
import ContributorsGrid from "@grove-dev/astro/components/ContributorsGrid.astro";
import OriginalCollection from "@grove-dev/astro/components/OriginalCollection.astro";
import { countByCategory, countByStack } from "@grove-dev/astro";
import { existsSync, readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import { dirname, resolve } from "node:path";
import type { IndexRecord } from "@grove-dev/core";

const slug = indexSlug();
const list = items; // generic — already filtered to the active kind
const stats = siteConfig.stats;

// ── Lens sectioning (Hot / New / Mature) ────────────────────────
// Project-shaped helpers fall back gracefully when a record
// doesn't carry stars/pushedAt (e.g. resource-hub records).
const DAY_MS = 86_400_000;
function daysSince(iso: string | null | undefined): number {
  if (!iso) return Infinity;
  const d = new Date(iso);
  if (Number.isNaN(d.valueOf())) return Infinity;
  return (Date.now() - d.valueOf()) / DAY_MS;
}

function starsOf(r: IndexRecord): number {
  return (r as { github?: { stars?: number } }).github?.stars ?? 0;
}
function pushedAtOf(r: IndexRecord): string | null {
  return (r as { github?: { pushedAt?: string | null } }).github?.pushedAt ?? null;
}
function labelsOf(r: IndexRecord): string[] {
  return r.curation?.labels ?? [];
}
function tierOf(r: IndexRecord): string | undefined {
  return (r as { health?: { tier?: string } }).health?.tier;
}

const hot = list
  .filter((r) => {
    const stars = starsOf(r);
    const pushed = daysSince(pushedAtOf(r));
    const labelledHot = labelsOf(r).includes("hot");
    return labelledHot || stars >= 1000 || pushed <= 30;
  })
  .slice(0, 6);

const newItems = list
  .filter((r) => {
    const pushed = daysSince(pushedAtOf(r));
    const labelledNew = labelsOf(r).includes("new");
    return pushed <= 7 || labelledNew;
  })
  .slice(0, 6);

const mature = list
  .filter((r) => {
    const tier = tierOf(r);
    const pushed = daysSince(pushedAtOf(r));
    return tier === "curated" && pushed > 365;
  })
  .slice(0, 6);

// ── Stack / category aggregates ─────────────────────────────────
const stackCounts = countByStack(list as Parameters<typeof countByStack>[0]);
const stacks = [...stackCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 12)
  .map(([name, count]) => ({ name, slug: name, count }));

const categoryCounts = countByCategory(list as Parameters<typeof countByCategory>[0]);
const categories = [...categoryCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([name, count]) => ({ name, slug: name, count }));

// ── Contributors (best-effort, from data/generated/contributors.json) ──
const here = dirname(fileURLToPath(import.meta.url));
const contributorsPath = [
  resolve(here, "..", "..", "data", "generated", "contributors.json"),
  resolve(process.cwd(), "data", "generated", "contributors.json"),
].find((p) => existsSync(p));

interface ContributorsFile {
  contributors?: Array<{
    username: string;
    name?: string;
    avatarUrl?: string;
    profileUrl?: string;
    contributions?: number;
  }>;
}

let contributors: ContributorsFile["contributors"] = [];
if (contributorsPath) {
  try {
    const parsed = JSON.parse(readFileSync(contributorsPath, "utf8")) as ContributorsFile;
    contributors = parsed.contributors ?? [];
  } catch {
    contributors = [];
  }
}
const hasContributors = contributors && contributors.length > 0;

const title = `${siteConfig.name} — ${siteConfig.tagline}`;
const description =
  siteConfig.description ?? `A growing community knowledge site powered by Grove.`;

// ── Render-time helpers ─────────────────────────────────────────
function detailHrefFor(r: IndexRecord): string {
  return `/${slug}/${r.slug}`;
}

const singular = itemLabel();
const plural = itemLabelPlural();
const emptyTrending = `No trending ${plural} yet.`;
const emptyNew = `No new ${plural} yet.`;
const emptyMature = `No established ${plural} yet.`;
---

<BaseLayout
  title={title}
  description={description}
  site={siteConfig}
  submitHref="/submit"
  submitLabel={`Submit ${singular}`}
>
  <Hero
    name={siteConfig.name}
    tagline={siteConfig.tagline}
    description={description}
    eyebrow="Curated directory"
    searchPlaceholder={`Search ${slug}...`}
    searchHref={`/${slug}`}
    stats={{
      apps: stats.totalApps,
      categories: stats.totalCategories,
      stacks: stats.totalStacks,
      contributors: stats.totalOwners || undefined,
      stars: stats.totalStars || undefined,
    }}
    itemsLabel={plural}
    ctas={[
      { label: `Browse ${slug}`, href: `/${slug}`, variant: "primary" },
      { label: "About", href: "/about", variant: "outline" },
    ]}
  />

  <WhyThisExists />

  <RecordSection
    id="hot"
    title="Trending"
    description="The items getting attention right now — high-star repos and recently active codebases."
    items={hot}
    hrefFor={detailHrefFor}
    viewAllHref={`/${slug}?lens=hot`}
    eyebrow="Hot"
    emptyLabel={emptyTrending}
  />

  <RecordSection
    id="new"
    title="Recently added"
    description="Fresh entries — pushed within the last week or carrying the curated 'new' label."
    items={newItems}
    hrefFor={detailHrefFor}
    viewAllHref={`/${slug}?lens=new`}
    eyebrow="New"
    emptyLabel={emptyNew}
  />

  <RecordSection
    id="mature"
    title="Established"
    description="Long-running curated items with deep history and stable architecture."
    items={mature}
    hrefFor={detailHrefFor}
    viewAllHref={`/${slug}?lens=mature`}
    eyebrow="Mature"
    emptyLabel={emptyMature}
  />

  {stacks.length > 0 && (
    <StackGrid
      stacks={stacks}
      pathPrefix={`/${slug}`}
    />
  )}

  {categories.length > 0 && (
    <CategoryGrid
      categories={categories}
      pathPrefix={`/${slug}`}
    />
  )}

  {hasContributors && (
    <ContributorsGrid
      contributors={contributors!}
      total={contributors!.length}
      viewAllHref={siteConfig.repoUrl || undefined}
      viewAllLabel="View on GitHub"
    />
  )}

  {stats.originalRepo && stats.originalRepo !== siteConfig.repoUrl && (
    <OriginalCollection
      repoUrl={stats.originalRepo}
      stats={{
        stars: stats.originalStars,
        forks: stats.originalForks,
        contributors: stats.originalContributors,
      }}
    />
  )}
</BaseLayout>
