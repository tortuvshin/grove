---
/**
 * Submit page — text-based instructions for contributing a new
 * record, plus a small client-side form that pre-fills the
 * record_submission GitHub issue with the user's input.
 *
 * The form does NOT submit data anywhere — it just constructs a
 * GitHub issue URL with prefilled title/body and hands the user
 * off to GitHub. That keeps the page static-hostable (no server
 * runtime, no form spam) while still being a real form experience.
 */
import siteConfig from "../../data/generated/site-config.json";
import { itemLabel } from "../data/records";
import BaseLayout from "@grove-dev/astro/layouts/BaseLayout.astro";
import Container from "@grove-dev/astro/layouts/Container.astro";

// English a/an article: "a project" but "an entity" / "an app". Pick
// automatically so the rendered headline reads naturally regardless
// of the blueprint's singular label.
function indefiniteArticle(word: string): string {
  return /^[aeiou]/i.test(word) ? "an" : "a";
}
const article = indefiniteArticle(itemLabel());
const title = `Submit ${article} ${itemLabel()} — ${siteConfig.name}`;
const description = `Submit a new ${itemLabel()} to ${siteConfig.name}.`;
const noindex = true;

const repoPath = (siteConfig.repoUrl ?? "").replace(/^https?:\/\/github\.com\//, "");
const issueUrl = repoPath
  ? `https://github.com/${repoPath}/issues/new?template=record_submission.md`
  : "https://github.com/tortuvshin/grove/issues/new";
---

<BaseLayout
  title={title}
  description={description}
  site={siteConfig}
  noindex={noindex}
>
  <Container>
    <article class="py-12 sm:py-16">
      <span class="text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
        Submit
      </span>
      <h1 class="mt-1 text-[1.75rem] sm:text-[2rem] font-semibold tracking-tight text-ink-900 dark:text-ink-100 m-0">
        Submit {article} {itemLabel()}
      </h1>
      <p class="mt-4 max-w-[62ch] text-sm text-ink-700 dark:text-ink-200 m-0">
        {siteConfig.name} is a community knowledge site. Fill in the
        form below — it pre-fills the submission issue on GitHub with
        your answers, where a maintainer will review and (if accepted)
        convert it into a record under{" "}
        <code class="font-mono text-ink-900 dark:text-ink-100">data/records/</code>.
      </p>

      <form
        id="grove-submit-form"
        class="mt-8 grid max-w-2xl grid-cols-1 gap-4"
        data-issue-base={issueUrl}
      >
        <label class="flex flex-col gap-1">
          <span class="text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
            Name *
          </span>
          <input
            name="name"
            required
            type="text"
            placeholder="My Project"
            class="rounded-md border border-ink-200 bg-white px-3 py-2 text-sm focus:border-ink-900 focus:outline-none focus:ring-2 focus:ring-ink-900/10 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-100"
          />
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
            One-line description *
          </span>
          <input
            name="description"
            required
            type="text"
            placeholder="What does it do, in plain words?"
            class="rounded-md border border-ink-200 bg-white px-3 py-2 text-sm focus:border-ink-900 focus:outline-none focus:ring-2 focus:ring-ink-900/10 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-100"
          />
        </label>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-1">
            <span class="text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
              Category
            </span>
            <input
              name="category"
              type="text"
              placeholder="e.g. tools, mobile, devops"
              class="rounded-md border border-ink-200 bg-white px-3 py-2 text-sm focus:border-ink-900 focus:outline-none focus:ring-2 focus:ring-ink-900/10 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-100"
            />
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
              Primary stack
            </span>
            <input
              name="stack"
              type="text"
              placeholder="e.g. Flutter, Vue, Go"
              class="rounded-md border border-ink-200 bg-white px-3 py-2 text-sm focus:border-ink-900 focus:outline-none focus:ring-2 focus:ring-ink-900/10 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-100"
            />
          </label>
        </div>
        <label class="flex flex-col gap-1">
          <span class="text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
            Repository URL *
          </span>
          <input
            name="repoUrl"
            required
            type="url"
            placeholder="https://github.com/owner/repo"
            class="rounded-md border border-ink-200 bg-white px-3 py-2 text-sm focus:border-ink-900 focus:outline-none focus:ring-2 focus:ring-ink-900/10 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-100"
          />
        </label>
        <label class="flex flex-col gap-1">
          <span class="text-2xs font-medium uppercase tracking-wider text-ink-500 dark:text-ink-400">
            Why it deserves a spot
          </span>
          <textarea
            name="whyListed"
            rows="4"
            placeholder="A short paragraph — what makes it stand out?"
            class="rounded-md border border-ink-200 bg-white px-3 py-2 text-sm focus:border-ink-900 focus:outline-none focus:ring-2 focus:ring-ink-900/10 dark:border-ink-800 dark:bg-ink-950 dark:text-ink-100"
          ></textarea>
        </label>
        <div class="flex flex-wrap gap-2">
          <button
            type="submit"
            class="grove-btn grove-btn-primary"
            data-event="submit_form_open_issue"
            data-event-source="submit_page"
          >
            Open a submission issue ↗
          </button>
          {repoPath && (
            <a
              href={`https://github.com/${repoPath}/blob/main/.github/ISSUE_TEMPLATE/record_submission.md`}
              target="_blank"
              rel="noopener noreferrer"
              class="grove-btn grove-btn-outline"
            >
              See the issue template
            </a>
          )}
        </div>
      </form>

      <script>
        // Submit form: build a GitHub issue URL with the user's input
        // prefilled, then redirect. No data leaves the browser until
        // the user clicks "Submit" on GitHub's side. Keeps the page
        // serverless and spam-resistant.
        (() => {
          const form = document.getElementById("grove-submit-form") as HTMLFormElement | null;
          if (!form) return;
          const base = form.dataset.issueBase;
          if (!base) return;
          form.addEventListener("submit", (event) => {
            event.preventDefault();
            const fd = new FormData(form);
            const name = String(fd.get("name") ?? "").trim();
            const description = String(fd.get("description") ?? "").trim();
            const category = String(fd.get("category") ?? "").trim();
            const stack = String(fd.get("stack") ?? "").trim();
            const repoUrl = String(fd.get("repoUrl") ?? "").trim();
            const whyListed = String(fd.get("whyListed") ?? "").trim();
            if (!name || !description || !repoUrl) {
              alert("Please fill in name, description, and repository URL.");
              return;
            }
            const title = encodeURIComponent(`[submit] ${name}`);
            const body = [
              "## Basics",
              `- **Name:** ${name}`,
              `- **One-line description:** ${description}`,
              category ? `- **Category:** ${category}` : "",
              stack ? `- **Primary stack:** ${stack}` : "",
              `- **Repository URL:** ${repoUrl}`,
              "",
              "## Why it deserves a spot",
              whyListed || "_(fill in)_",
              "",
              "## Checkboxes",
              "- [ ] The repo is **public** on GitHub / another public forge",
              "- [ ] It's **open source** under an OSI-approved license",
              "- [ ] It has been **maintained** in the last 12 months",
            ]
              .filter(Boolean)
              .join("\n");
            const url = `${base}&title=${title}&body=${encodeURIComponent(body)}`;
            window.open(url, "_blank", "noopener,noreferrer");
          });
        })();
      </script>

      <section class="mt-12 max-w-[68ch]">
        <h2 class="m-0 text-lg font-semibold tracking-tight text-ink-900 dark:text-ink-100">
          Manual record (alternative to the form)
        </h2>
        <p class="mt-2 text-sm text-ink-700 dark:text-ink-200 m-0">
          Prefer to write a record by hand? Here's the minimum shape for a{" "}
          <code class="font-mono">{siteConfig.blueprint}</code> record.
          The schema is validated automatically on every PR.
        </p>
        {siteConfig.blueprint === "project-directory" && (
          <pre class="mt-4 overflow-x-auto rounded-md border border-ink-200 bg-ink-50 p-4 text-xs leading-relaxed text-ink-800 dark:border-ink-800 dark:bg-ink-900/60 dark:text-ink-200"><code>{`kind: project
slug: my-project
name: My Project
description: One-line description of what this project does
category: tools
tags:
  - open-source
links:
  github: https://github.com/owner/repo
  website: https://example.com`}</code></pre>
        )}
        {siteConfig.blueprint === "resource-hub" && (
          <pre class="mt-4 overflow-x-auto rounded-md border border-ink-200 bg-ink-50 p-4 text-xs leading-relaxed text-ink-800 dark:border-ink-800 dark:bg-ink-900/60 dark:text-ink-200"><code>{`kind: resource
slug: my-resource
title: My Resource
description: One-line description of what this resource is
category: guides
type: guide
topic: coding-agents
tags:
  - ai
links:
  source: https://example.com`}</code></pre>
        )}
        {siteConfig.blueprint === "ecosystem-map" && (
          <pre class="mt-4 overflow-x-auto rounded-md border border-ink-200 bg-ink-50 p-4 text-xs leading-relaxed text-ink-800 dark:border-ink-800 dark:bg-ink-900/60 dark:text-ink-200"><code>{`kind: entity
slug: my-entity
name: My Organization
description: One-line description of what this organization does
category: education
type: company
tags:
  - technology
links:
  website: https://example.com`}</code></pre>
        )}
      </section>

      <section class="mt-12 max-w-[68ch]">
        <h2 class="m-0 text-lg font-semibold tracking-tight text-ink-900 dark:text-ink-100">
          What happens after you submit
        </h2>
        <ol class="mt-3 m-0 flex list-decimal flex-col gap-2 pl-5 text-sm text-ink-700 dark:text-ink-200">
          <li>A maintainer reviews the issue and tags it as <code class="font-mono">accepted</code> or <code class="font-mono">needs-info</code>.</li>
          <li>You open a PR with the new <code class="font-mono">data/records/&lt;slug&gt;.yml</code> file.</li>
          <li>CI runs <code class="font-mono">grove validate</code> and previews the site with your record.</li>
          <li>A maintainer merges. The next <code class="font-mono">grove build</code> deploys it.</li>
        </ol>
      </section>
    </article>
  </Container>
</BaseLayout>
