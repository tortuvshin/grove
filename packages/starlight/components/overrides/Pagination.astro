---
const { pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
---

<div class="pagination-links print:hidden mt-8 flex flex-row items-center justify-between pt-4">
    {
        prev && (
            <a
                class="prev inline-flex h-8 items-center justify-center gap-1.5 whitespace-nowrap rounded-md bg-secondary px-3 py-2 text-sm font-medium text-secondary-foreground no-underline transition-colors hover:bg-[color-mix(in_srgb,var(--secondary)_80%,transparent)]"
                href={prev.href}
                rel="prev"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="pointer-events-none block h-4 w-4 flex-shrink-0 align-middle"
                >
                    <path d="m15 18-6-6 6-6" />
                </svg>
                {prev.label}
            </a>
        )
    }
    {
        next && (
            <a
                class="next ml-auto inline-flex h-8 items-center justify-center gap-1.5 whitespace-nowrap rounded-md bg-secondary px-3 py-2 text-sm font-medium text-secondary-foreground no-underline transition-colors hover:bg-[color-mix(in_srgb,var(--secondary)_80%,transparent)]"
                href={next.href}
                rel="next"
            >
                {next.label}
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="pointer-events-none block h-4 w-4 flex-shrink-0 align-middle"
                >
                    <path d="m9 18 6-6-6-6" />
                </svg>
            </a>
        )
    }
</div>
