---
import { marked } from 'marked';
import userConfig from 'virtual:@grove-dev/starlight-config';
import Drawer from './parts/Drawer.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div data-slot="layout" class="relative z-10 flex min-h-svh flex-col bg-background text-foreground">
    <header class="sticky top-0 z-50 w-full bg-background">
        <div class="container-wrapper px-6">
            <div
                class="container flex h-[var(--header-height)] max-w-none items-center"
            >
                <slot name="header" />
            </div>
        </div>
    </header>

    <main class="flex min-h-0 flex-1 flex-col">
        {!hasSidebar && <slot />}

        {
            hasSidebar && (
                <div class="container-wrapper">
                    <div class="container-wrapper-main container flex w-full flex-col lg:grid lg:[grid-template-columns:var(--sidebar-width)_minmax(0,1fr)]">
                        <aside class="aside hidden h-[calc(100vh-var(--header-height)-1px)] overflow-hidden sticky top-[calc(var(--header-height)+1px)] lg:block">
                            <slot name="sidebar" />
                        </aside>

                        <slot />
                    </div>
                </div>
            )
        }
    </main>

    <footer
        data-slot="footer-text-wrapper"
        class="flex h-24 items-center border-t-0 text-sm text-muted-foreground"
    >
        <div
            data-slot="footer-text"
            class="mx-auto w-full max-w-[var(--container-max-width)] px-6 text-center text-balance text-muted-foreground"
            set:html={marked.parseInline(userConfig.footerText)}
        />
    </footer>
</div>

<Drawer />
