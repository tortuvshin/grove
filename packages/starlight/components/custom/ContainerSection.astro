---
type Props = {
    width?: 'sm' | 'md' | 'lg' | 'xl';
};

const { width = 'lg' } = Astro.props;

const maxWidth = {
    sm: '640px',
    md: '768px',
    lg: '1024px',
    xl: '1280px',
}[width];
---

<div
    class="container-section px-2 sm:px-4 lg:px-12"
    data-width={width}
    style={`--section-max-width: ${maxWidth}`}
>
    <div class="container-wrapper mx-auto w-full" style={`max-width: ${maxWidth}`}>
        <div class="container mx-auto w-full">
            <slot />
        </div>
    </div>
</div>

<style>
    .container-section {
        padding-inline: 0.5rem;
    }

    .container-section + .container-section {
        margin-top: 3rem;
    }

    .container-section:last-of-type {
        padding-bottom: 0;
    }

    @media (min-width: 640px) {
        .container-section {
            padding-inline: 1rem;
        }
    }

    @media (min-width: 1024px) {
        .container-section {
            padding-inline: 3rem;
        }
    }
</style>
