{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": false,
  "separate-pull-requests": false,
  "bootstrap-sha": "35abbe85c3ba8d5695fc57a5b53a7a91133b817a",
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "docs", "section": "Documentation" },
    { "type": "build", "section": "Build", "hidden": true },
    { "type": "ci", "section": "CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true },
    { "type": "style", "section": "Style", "hidden": true },
    { "type": "test", "section": "Tests", "hidden": true }
  ],
  "packages": {
    ".": {
      "package-name": "grove",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "json", "path": "packages/core/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/astro/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/cli/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/starlight/package.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "apps/docs/src/components/home/Hero.astro" },
        { "type": "generic", "path": "apps/docs/src/layouts/HomeLayout.astro" },
        { "type": "generic", "path": "apps/docs/src/content/docs/project/roadmap.md" }
      ]
    }
  }
}
